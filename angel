            h.Size = UDim2.new(1, 0, 0, 28)
            h.ZIndex = 18

            local section = {}

            function section:CreateButton(titleText, desc, iconText, callback)
                return MakeButton(sec, titleText, desc, iconText, callback)
            end

            function section:CreateToggle(titleText, desc, default, callback)
                return MakeToggle(sec, titleText, desc, default, callback)
            end

            function section:CreateSlider(titleText, min, max, default, callback)
                return MakeSlider(sec, titleText, min, max, default, callback)
            end

            return section
        end

        function page:CreateHero(titleText, desc)
            local hero = MakeGlass(frame, {
                Size = UDim2.new(1, -6, 0, 112),
                Radius = 20,
                Transparency = 0.885,
                StrokeTransparency = 0.50,
                ZIndex = 16,
            })
            Pad(hero, 16)

            local t = Text(hero, titleText or "Welcome", 22, Theme.White, Enum.Font.GothamBold)
            t.Size = UDim2.new(1, -30, 0, 34)
            t.Position = UDim2.new(0, 0, 0, 10)
            t.ZIndex = 18

            local d = Text(hero, desc or "", 12, Theme.Muted, Enum.Font.GothamMedium)
            d.Size = UDim2.new(1, -30, 0, 28)
            d.Position = UDim2.new(0, 0, 0, 46)
            d.ZIndex = 18

            local wing = Text(hero, "(imagem: asas/glow)", 12, Theme.White, Enum.Font.GothamBlack, Enum.TextXAlignment.Right)
            wing.Size = UDim2.new(0, 220, 0, 24)
            wing.Position = UDim2.new(1, -230, 1, -36)
            wing.ZIndex = 18

            return hero
        end

        page.Button = button
        page.Frame = frame

        button.MouseButton1Click:Connect(function()
            SelectPage(page)
        end)

        button.MouseEnter:Connect(function()
            if Window.CurrentPage ~= page then
                Tween(button, {BackgroundTransparency = 0.84}, 0.14)
            end
        end)

        button.MouseLeave:Connect(function()
            if Window.CurrentPage ~= page then
                Tween(button, {BackgroundTransparency = 0.91}, 0.14)
            end
        end)

        table.insert(Window.Pages, page)

        return page
    end

    function Window:SelectPage(name)
        for _, p in ipairs(Window.Pages) do
            if p.Title == name then
                SelectPage(p)
                return p
            end
        end
    end

    function Window:Destroy()
        ScreenGui:Destroy()
    end

    -- Performance simple helpers
    function Window:CreatePerformancePage()
        local page = self:CreatePage("Performance", "(icone)")
        page:CreateHero("Performance", "Real-time FPS, ping and memory.")
        local sec = page:CreateSection("Live Stats")

        local labels = {}
        local function makeStat(name, value)
            local f = MakeGlass(sec.Frame or page.Frame, {})
        end

        local fpsBtn = sec:CreateButton("FPS", "0", "(icone)")
        local pingBtn = sec:CreateButton("Ping", "0ms", "(icone)")
        local memBtn = sec:CreateButton("Memory", "0MB", "(icone)")

        local frames = 0
        local elapsed = 0

        RunService.RenderStepped:Connect(function(dt)
            frames += 1
            elapsed += dt
            if elapsed >= 1 then
                local fps = math.floor(frames / elapsed + 0.5)
                frames = 0
                elapsed = 0

                if fpsBtn:FindFirstChildWhichIsA("TextLabel", true) then end
            end
        end)

        return page
    end

    -- Página inicial Config
    local Config = Window:CreatePage("Config", "(icone)")
    Config:CreateHero(
        "Welcome to Angelws, " .. tostring(options.Username or (LocalPlayer and LocalPlayer.Name or "Username")) .. ".",
        "Simple angelcore glass layout. Use the buttons below to test the interface."
    )

    local quick = Config:CreateSection("Quick Actions")

    quick:CreateButton("Load Config", "Placeholder for loading saved settings", "(icone)", function()
        print("[Angelws] Load Config clicked")
    end)

    quick:CreateButton("Save Config", "Placeholder for saving current settings", "(icone)", function()
        print("[Angelws] Save Config clicked")
    end)

    quick:CreateButton("Discord", "Copies your Discord invite/link to clipboard", "(icone)", function()
        local link = options.Discord or "https://discord.gg/angelws"
        if setclipboard then
            setclipboard(link)
        end
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Angelws",
                Text = setclipboard and "Discord copied to clipboard." or "Clipboard not supported.",
                Duration = 4
            })
        end)
    end)

    local uiSec = Config:CreateSection("Interface")
    uiSec:CreateToggle("Glass Highlight", "Visual placeholder toggle", true)
    uiSec:CreateSlider("Window Glow", 0, 100, 65)

    if options.DefaultPages ~= false then
        local Home = Window:CreatePage("Home", "(icone)")
        Home:CreateHero("Home", "Clean page example without subpages or footer.")
        local hs = Home:CreateSection("Dashboard")
        hs:CreateButton("Example Button", "A simple placeholder button", "(icone)")
        hs:CreateToggle("Example Toggle", "Visual only", false)
        hs:CreateSlider("Example Slider", 0, 100, 35)

        local Visuals = Window:CreatePage("Visuals", "(icone)")
        Visuals:CreateHero("Visuals", "Future visual settings can stay here.")
        local vs = Visuals:CreateSection("Visual Options")
        vs:CreateToggle("Enable Visuals", "Placeholder", false)
        vs:CreateButton("Refresh", "Placeholder action", "(icone)")

        local Settings = Window:CreatePage("Settings", "(icone)")
        Settings:CreateHero("Settings", "General interface settings.")
        local ss = Settings:CreateSection("Window")
        ss:CreateButton("Destroy UI", "Close the Angelws interface", "(icone)", function()
            Window:Destroy()
        end)
    end

    task.defer(function()
        Window:SelectPage("Config")
    end)

    local toggleKey = options.ToggleKey or Enum.KeyCode.RightShift
    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == toggleKey then
            Main.Visible = not Main.Visible
        end
    end)

    return Window
end

return Angelws

local function Glass(parent, props, bgImage)
    props = props or {}

    local frame = New("Frame", {
        Name = props.Name or "Glass",
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = props.Transparency or 0.94,
        BorderSizePixel = 0,
        Size = props.Size or UDim2.fromOffset(100, 100),
        Position = props.Position or UDim2.fromOffset(0, 0),
        LayoutOrder = props.LayoutOrder or 0,
        ZIndex = props.ZIndex or 1,
        ClipsDescendants = true,
        AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
    }, parent)

    Corner(frame, props.Radius or 18)
    Stroke(frame, props.StrokeTransparency or 0.50, props.StrokeThickness or 1)
    AddGlassFX(frame, bgImage or DEFAULT_BACKGROUND, props.GlassStrength or 1)

    return frame
end


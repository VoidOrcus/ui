    -- Optimized performance update
    do
        local frames = 0
        local elapsed = 0
        local fps = 0
        local frameCost = 0

        RunService.RenderStepped:Connect(function(dt)
            frames += 1
            elapsed += dt
            frameCost = frameCost * 0.9 + dt * 0.1

            if elapsed >= 1 then
                fps = math.floor(frames / elapsed + 0.5)
                frames = 0
                elapsed = 0

                local ping = GetPingMs()
                local memory = GetMemoryMb()
                local cpuApprox = math.clamp(math.floor((frameCost / (1/60)) * 35 + 0.5), 0, 100)

                if PerfLabels.FPS then PerfLabels.FPS.Text = tostring(fps) end
                if PerfLabels.Ping then PerfLabels.Ping.Text = tostring(math.floor(ping + 0.5)) .. "ms" end
                if PerfLabels.Memory then PerfLabels.Memory.Text = tostring(math.floor(memory + 0.5)) .. "MB" end
                if PerfLabels.CPU then PerfLabels.CPU.Text = tostring(cpuApprox) .. "%" end

                if PerfFills.FPS then PerfFills.FPS.Size = UDim2.new(math.clamp(fps / 240, 0.04, 1), 0, 1, 0) end
                if PerfFills.Ping then PerfFills.Ping.Size = UDim2.new(math.clamp(1 - (ping / 300), 0.04, 1), 0, 1, 0) end
                if PerfFills.Memory then PerfFills.Memory.Size = UDim2.new(math.clamp(memory / 2500, 0.04, 1), 0, 1, 0) end
                if PerfFills.CPU then PerfFills.CPU.Size = UDim2.new(math.clamp(cpuApprox / 100, 0.04, 1), 0, 1, 0) end
            end
        end)
    end


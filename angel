local function GlassFrame(parent, props)
    props = props or {}

    local frame = New("Frame", {
        BackgroundColor3 = props.Color or Theme.Glass,
        BackgroundTransparency = props.Transparency or 0.94,
        BorderSizePixel = 0,
        Size = props.Size or UDim2.fromOffset(100, 100),
        Position = props.Position or UDim2.fromOffset(0, 0),
        ClipsDescendants = props.ClipsDescendants == true,
        ZIndex = props.ZIndex or 1,
    }, parent)

    Corner(frame, props.Radius or 18)
    Stroke(frame, props.StrokeColor or Theme.PureWhite, props.StrokeThickness or 1, props.StrokeTransparency or 0.76)

    if props.Gradient ~= false then
        Gradient(
            frame,
            props.GradientA or Color3.fromRGB(255, 255, 255),
            props.GradientB or Color3.fromRGB(0, 0, 0),
            props.GradientRotation or 135,
            NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.92),
                NumberSequenceKeypoint.new(0.5, 0.985),
                NumberSequenceKeypoint.new(1, 0.94),
            })
        )
    end

    return frame
end

local function AddHover(button, baseTrans, hoverTrans)
    baseTrans = baseTrans or button.BackgroundTransparency
    hoverTrans = hoverTrans or math.max(0, baseTrans - 0.08)

    button.MouseEnter:Connect(function()
        Tween(button, {BackgroundTransparency = hoverTrans}, 0.14)
    end)

    button.MouseLeave:Connect(function()
        Tween(button, {BackgroundTransparency = baseTrans}, 0.14)
    end)
end

local function SafePlayerThumbnail(userId)
    local ok, content = pcall(function()
        return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
    end)

    if ok then
        return content
    end

    return ""
end

local function CreateViewportCharacter(parent)
    local viewport = New("ViewportFrame", {
        BackgroundColor3 = Theme.Black,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Ambient = Color3.fromRGB(210, 210, 220),
        LightColor = Color3.fromRGB(255, 255, 255),
        LightDirection = Vector3.new(-1, -1, -1),
    }, parent)

    local cam = Instance.new("Camera")
    cam.Parent = viewport
    viewport.CurrentCamera = cam

    task.defer(function()
        local char = LocalPlayer and LocalPlayer.Character
        if not char then return end

        local clone
        local ok = pcall(function()
            clone = char:Clone()
        end)

        if not ok or not clone then return end

        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") then
                d:Destroy()
            elseif d:IsA("BasePart") then
                d.Anchored = true
            end
        end

        clone.Parent = viewport

        local root = clone:FindFirstChild("HumanoidRootPart") or clone:FindFirstChildWhichIsA("BasePart")
        if root then
            cam.CFrame = CFrame.new(root.Position + Vector3.new(0, 1.3, 6), root.Position + Vector3.new(0, 1.2, 0))
        else
            cam.CFrame = CFrame.new(Vector3.new(0, 1, 6), Vector3.new(0, 1, 0))
        end
    end)

    return viewport
end


local function MakeToggle(parent, title, desc, default, callback, bgImage)
    local active = default == true

    local frame = Glass(parent, {
        Size = UDim2.new(1, 0, 0, 66),
        Radius = 16,
        ZIndex = (parent and parent.ZIndex or 1) + 20,
        StrokeTransparency = 0.58,
    }, bgImage)

    local titleLabel = Text(frame, title or "Toggle", 13, Theme.White, Enum.Font.GothamBold)
    titleLabel.Size = UDim2.new(1, -100, 0, 24)
    titleLabel.Position = UDim2.new(0, 16, 0, 12)

    local descLabel = Text(frame, desc or "", 11, Theme.TextDim, Enum.Font.GothamMedium)
    descLabel.Size = UDim2.new(1, -100, 0, 20)
    descLabel.Position = UDim2.new(0, 16, 0, 36)

    local switch = New("TextButton", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = active and 0.70 or 0.90,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(0, 54, 0, 28),
        Position = UDim2.new(1, -72, 0.5, -14),
        ZIndex = frame.ZIndex + 40,
    }, frame)
    Corner(switch, 14)
    Stroke(switch, 0.58, 1)

    local knob = New("Frame", {
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 20, 0, 20),
        Position = active and UDim2.new(1, -24, 0.5, -10) or UDim2.new(0, 4, 0.5, -10),
        ZIndex = switch.ZIndex + 1,
    }, switch)
    Corner(knob, 10)

    local function render(silent)
        Tween(switch, {BackgroundTransparency = active and 0.70 or 0.90}, 0.15)
        Tween(knob, {
            Position = active and UDim2.new(1, -24, 0.5, -10) or UDim2.new(0, 4, 0.5, -10)
        }, 0.15)
        if not silent and callback then
            callback(active)
        end
    end

    switch.MouseButton1Click:Connect(function()
        active = not active
        render(false)
    end)

    return {
        Frame = frame,
        SetValue = function(_, value, silent)
            active = value == true
            render(silent)
        end,
        GetValue = function()
            return active
        end,
    }
end

local function MakeSlider(parent, title, min, max, default, callback, bgImage)
    min = tonumber(min) or 0
    max = tonumber(max) or 100
    local value = math.clamp(tonumber(default) or min, min, max)

    local frame = Glass(parent, {
        Size = UDim2.new(1, 0, 0, 76),
        Radius = 16,
        ZIndex = (parent and parent.ZIndex or 1) + 20,
        StrokeTransparency = 0.58,
    }, bgImage)

    local titleLabel = Text(frame, title or "Slider", 13, Theme.White, Enum.Font.GothamBold)
    titleLabel.Size = UDim2.new(1, -95, 0, 24)
    titleLabel.Position = UDim2.new(0, 16, 0, 12)

    local valueLabel = Text(frame, tostring(value), 12, Theme.White, Enum.Font.GothamBlack, Enum.TextXAlignment.Right)
    valueLabel.Size = UDim2.new(0, 76, 0, 24)
    valueLabel.Position = UDim2.new(1, -92, 0, 12)

    local bar = New("TextButton", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = 0.90,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, -32, 0, 10),
        Position = UDim2.new(0, 16, 0, 50),
        ZIndex = frame.ZIndex + 40,
    }, frame)
    Corner(bar, 5)

    local fill = New("Frame", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = 0.18,
        BorderSizePixel = 0,
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        ZIndex = bar.ZIndex + 1,
    }, bar)
    Corner(fill, 5)

    local dragging = false

    local function setFromX(x, silent)
        local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = math.floor((min + (max - min) * alpha) + 0.5)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        valueLabel.Text = tostring(value)
        if not silent and callback then callback(value) end
    end

    bar.MouseButton1Down:Connect(function()
        dragging = true
        setFromX(UIS:GetMouseLocation().X, false)
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            setFromX(input.Position.X, false)
        end
    end)

    return {
        Frame = frame,
        SetValue = function(_, newValue, silent)
            value = math.clamp(tonumber(newValue) or min, min, max)
            local alpha = (value - min) / (max - min)
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            valueLabel.Text = tostring(value)
            if not silent and callback then callback(value) end
        end,
        GetValue = function()
            return value
        end,
    }
end

local function MakeDropdown(parent, title, desc, options, default, callback, bgImage)
    options = options or {}
    local selected = default or options[1] or "None"
    local open = false

    local frame = Glass(parent, {
        Size = UDim2.new(1, 0, 0, 66),
        Radius = 16,
        ZIndex = (parent and parent.ZIndex or 1) + 20,
        StrokeTransparency = 0.58,
    }, bgImage)

    local titleLabel = Text(frame, title or "Dropdown", 13, Theme.White, Enum.Font.GothamBold)
    titleLabel.Size = UDim2.new(1, -172, 0, 24)
    titleLabel.Position = UDim2.new(0, 16, 0, 12)

    local descLabel = Text(frame, desc or "", 11, Theme.TextDim, Enum.Font.GothamMedium)
    descLabel.Size = UDim2.new(1, -172, 0, 20)
    descLabel.Position = UDim2.new(0, 16, 0, 36)

    local button = New("TextButton", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = 0.90,
        BorderSizePixel = 0,
        Text = tostring(selected) .. "  ˅",
        TextColor3 = Theme.White,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        AutoButtonColor = false,
        Size = UDim2.new(0, 140, 0, 34),
        Position = UDim2.new(1, -156, 0.5, -17),
        ZIndex = frame.ZIndex + 40,
    }, frame)
    Corner(button, 12)
    Stroke(button, 0.62, 1)

    local menu = New("Frame", {
        BackgroundColor3 = Theme.Black,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 140, 0, 0),
        Position = UDim2.new(1, -156, 1, 4),
        ClipsDescendants = true,
        Visible = false,
        ZIndex = frame.ZIndex + 60,
    }, frame)
    Corner(menu, 12)
    Stroke(menu, 0.45, 1)
    Pad(menu, 5)
    List(menu, 4)

    local function rebuild()
        for _, child in ipairs(menu:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end

        for _, option in ipairs(options) do
            local item = New("TextButton", {
                BackgroundColor3 = Theme.White,
                BackgroundTransparency = 0.92,
                BorderSizePixel = 0,
                Text = tostring(option),
                TextColor3 = Theme.White,
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                AutoButtonColor = false,
                Size = UDim2.new(1, 0, 0, 28),
                ZIndex = menu.ZIndex + 1,
            }, menu)
            Corner(item, 9)
            item.MouseButton1Click:Connect(function()
                selected = option
                button.Text = tostring(option) .. "  ˅"
                open = false
                Tween(menu, {Size = UDim2.new(0, 140, 0, 0)}, 0.14)
                task.delay(0.15, function()
                    if not open then menu.Visible = false end
                end)
                if callback then callback(selected) end
            end)
        end
    end

    rebuild()

    button.MouseButton1Click:Connect(function()
        open = not open
        if open then
            menu.Visible = true
            Tween(menu, {Size = UDim2.new(0, 140, 0, math.min(#options * 32 + 10, 180))}, 0.16)
        else
            Tween(menu, {Size = UDim2.new(0, 140, 0, 0)}, 0.16)
            task.delay(0.17, function()
                if not open then menu.Visible = false end
            end)
        end
    end)

    return {
        Frame = frame,
        SetValue = function(_, value, silent)
            selected = value
            button.Text = tostring(value) .. "  ˅"
            if not silent and callback then callback(value) end
        end,
        GetValue = function()
            return selected
        end,
    }
end


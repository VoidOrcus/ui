local function ParentGui()
    return (gethui and gethui()) or CoreGui
end

local function New(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    if parent then
        obj.Parent = parent
    end
    return obj
end

local function Tween(obj, props, t)
    local tw = TweenService:Create(
        obj,
        TweenInfo.new(t or 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        props
    )
    tw:Play()
    return tw
end

local function Corner(obj, r)
    return New("UICorner", {
        CornerRadius = UDim.new(0, r or 12)
    }, obj)
end

local function Stroke(obj, transparency, thickness)
    return New("UIStroke", {
        Color = Theme.White,
        Transparency = transparency or 0.65,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, obj)
end

local function Gradient(obj, rot, t1, t2)
    return New("UIGradient", {
        Rotation = rot or 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.White),
            ColorSequenceKeypoint.new(1, Theme.Black),
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, t1 or 0.86),
            NumberSequenceKeypoint.new(0.5, 0.985),
            NumberSequenceKeypoint.new(1, t2 or 0.92),
        }),
    }, obj)
end

local function Text(parent, text, size, color, font, align)
    return New("TextLabel", {
        BackgroundTransparency = 1,
        Text = text or "",
        TextColor3 = color or Theme.SoftWhite,
        Font = font or Enum.Font.GothamMedium,
        TextSize = size or 13,
        TextXAlignment = align or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        RichText = true,
        ZIndex = (parent and parent.ZIndex or 1) + 10,
    }, parent)
end

local function Pad(parent, all)
    return New("UIPadding", {
        PaddingTop = UDim.new(0, all or 8),
        PaddingBottom = UDim.new(0, all or 8),
        PaddingLeft = UDim.new(0, all or 8),
        PaddingRight = UDim.new(0, all or 8),
    }, parent)
end

local function List(parent, gap)
    return New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, gap or 8),
    }, parent)
end


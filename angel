local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local LocalPlayer = Players.LocalPlayer

local DEFAULT_BG = "rbxassetid://111631056614699"

local Theme = {
    White = Color3.fromRGB(255, 255, 255),
    SoftWhite = Color3.fromRGB(230, 230, 235),
    Muted = Color3.fromRGB(160, 160, 170),
    Dark = Color3.fromRGB(5, 5, 8),
    Black = Color3.fromRGB(0, 0, 0),
    Green = Color3.fromRGB(145, 255, 190),
}

local function ParentGui()
    return (gethui and gethui()) or CoreGui
end

local function New(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    if parent then
        obj.Parent = parent
    end
    return obj
end

local function Tween(obj, props, t)
    local tw = TweenService:Create(obj, TweenInfo.new(t or 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function Corner(obj, r)
    return New("UICorner", { CornerRadius = UDim.new(0, r or 12) }, obj)
end

local function Stroke(obj, transparency, thickness)
    return New("UIStroke", {
        Color = Theme.White,
        Transparency = transparency or 0.65,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, obj)
end

local function Gradient(obj, rot, t1, t2)
    local g = New("UIGradient", {
        Rotation = rot or 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.White),
            ColorSequenceKeypoint.new(1, Theme.Black),
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, t1 or 0.86),
            NumberSequenceKeypoint.new(0.5, 0.985),
            NumberSequenceKeypoint.new(1, t2 or 0.92),
        }),
    }, obj)
    return g
end

local function Text(parent, text, size, color, font, align)
    return New("TextLabel", {
        BackgroundTransparency = 1,
        Text = text or "",
        TextColor3 = color or Theme.SoftWhite,
        Font = font or Enum.Font.GothamMedium,
        TextSize = size or 13,
        TextXAlignment = align or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        RichText = true,
    }, parent)
end

local function Pad(parent, all)
    return New("UIPadding", {
        PaddingTop = UDim.new(0, all or 8),
        PaddingBottom = UDim.new(0, all or 8),
        PaddingLeft = UDim.new(0, all or 8),
        PaddingRight = UDim.new(0, all or 8),
    }, parent)
end

local function List(parent, gap)
    return New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, gap or 8),
    }, parent)
end

local function MakeGlass(parent, props)
    props = props or {}

    local frame = New("Frame", {
        Name = props.Name or "Glass",
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = props.Transparency or 0.91,
        BorderSizePixel = 0,
        Size = props.Size or UDim2.fromOffset(100, 100),
        Position = props.Position or UDim2.fromOffset(0, 0),
        ZIndex = props.ZIndex or 1,
        ClipsDescendants = true,
        LayoutOrder = props.LayoutOrder or 0,
        AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
    }, parent)

    Corner(frame, props.Radius or 18)
    Stroke(frame, props.StrokeTransparency or 0.62, props.StrokeThickness or 1)
    Gradient(frame, props.GradientRotation or 135, props.G1 or 0.86, props.G2 or 0.94)

    local highlight = New("Frame", {
        Name = "WhiteHighlight",
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = props.HighlightTransparency or 0.55,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -26, 0, 1),
        Position = UDim2.new(0, 13, 0, 9),
        ZIndex = frame.ZIndex + 2,
    }, frame)

    Gradient(highlight, 0, 1, 1)

    return frame
end

local function MakeButton(parent, title, desc, icon, callback)
    local btn = New("TextButton", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = 0.90,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, 64),
        ZIndex = 20,
    }, parent)

    Corner(btn, 16)
    Stroke(btn, 0.64, 1)
    Gradient(btn, 135, 0.84, 0.98)

    local ico = Text(btn, icon or "(icone)", 16, Theme.White, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
    ico.Size = UDim2.new(0, 54, 1, 0)
    ico.Position = UDim2.new(0, 6, 0, 0)
    ico.ZIndex = 22

    local t = Text(btn, title or "Button", 13, Theme.White, Enum.Font.GothamBold)
    t.Size = UDim2.new(1, -70, 0, 24)
    t.Position = UDim2.new(0, 66, 0, 12)
    t.ZIndex = 22

    local d = Text(btn, desc or "", 11, Theme.Muted, Enum.Font.GothamMedium)
    d.Size = UDim2.new(1, -70, 0, 20)
    d.Position = UDim2.new(0, 66, 0, 36)
    d.ZIndex = 22

    btn.MouseEnter:Connect(function()
        Tween(btn, { BackgroundTransparency = 0.80 }, 0.14)
    end)

    btn.MouseLeave:Connect(function()
        Tween(btn, { BackgroundTransparency = 0.90 }, 0.14)
    end)

    btn.MouseButton1Click:Connect(function()
        if callback then
            callback()
        end
    end)

    return btn
end

local function MakeToggle(parent, title, desc, default, callback)
    local active = default == true

    local frame = MakeGlass(parent, {
        Size = UDim2.new(1, 0, 0, 66),
        Radius = 16,
        Transparency = 0.91,
        StrokeTransparency = 0.65,
        ZIndex = 20,
    })

    local t = Text(frame, title or "Toggle", 13, Theme.White, Enum.Font.GothamBold)
    t.Size = UDim2.new(1, -95, 0, 24)
    t.Position = UDim2.new(0, 16, 0, 12)
    t.ZIndex = 22

    local d = Text(frame, desc or "", 11, Theme.Muted, Enum.Font.GothamMedium)
    d.Size = UDim2.new(1, -95, 0, 20)
    d.Position = UDim2.new(0, 16, 0, 36)
    d.ZIndex = 22

    local sw = New("TextButton", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = active and 0.70 or 0.90,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(0, 54, 0, 28),
        Position = UDim2.new(1, -72, 0.5, -14),
        ZIndex = 22,
    }, frame)
    Corner(sw, 14)
    Stroke(sw, 0.66, 1)

    local knob = New("Frame", {
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 20, 0, 20),
        Position = active and UDim2.new(1, -24, 0.5, -10) or UDim2.new(0, 4, 0.5, -10),
        ZIndex = 23,
    }, sw)
    Corner(knob, 10)

    local function render()
        Tween(sw, { BackgroundTransparency = active and 0.70 or 0.90 }, 0.15)
        Tween(knob, {
            Position = active and UDim2.new(1, -24, 0.5, -10) or UDim2.new(0, 4, 0.5, -10)
        }, 0.15)
    end

    sw.MouseButton1Click:Connect(function()
        active = not active
        render()
        if callback then callback(active) end
    end)

    return {
        SetValue = function(_, v)
            active = v == true
            render()
        end,
        GetValue = function()
            return active
        end,
        Frame = frame,
    }
end

local function MakeSlider(parent, title, min, max, default, callback)
    min = tonumber(min) or 0
    max = tonumber(max) or 100
    local value = math.clamp(tonumber(default) or min, min, max)

    local frame = MakeGlass(parent, {
        Size = UDim2.new(1, 0, 0, 76),
        Radius = 16,
        Transparency = 0.91,
        StrokeTransparency = 0.65,
        ZIndex = 20,
    })

    local t = Text(frame, title or "Slider", 13, Theme.White, Enum.Font.GothamBold)
    t.Size = UDim2.new(1, -90, 0, 24)
    t.Position = UDim2.new(0, 16, 0, 12)
    t.ZIndex = 22

    local v = Text(frame, tostring(value), 12, Theme.White, Enum.Font.GothamBlack, Enum.TextXAlignment.Right)
    v.Size = UDim2.new(0, 70, 0, 24)
    v.Position = UDim2.new(1, -86, 0, 12)
    v.ZIndex = 22

    local bar = New("TextButton", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = 0.90,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, -32, 0, 10),
        Position = UDim2.new(0, 16, 0, 50),
        ZIndex = 22,
    }, frame)
    Corner(bar, 5)

    local fill = New("Frame", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = 0.18,
        BorderSizePixel = 0,
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        ZIndex = 23,
    }, bar)
    Corner(fill, 5)

    local dragging = false

    local function setFromX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = math.floor((min + (max - min) * a) + 0.5)
        fill.Size = UDim2.new(a, 0, 1, 0)
        v.Text = tostring(value)
        if callback then callback(value) end
    end

    bar.MouseButton1Down:Connect(function()
        dragging = true
        setFromX(UIS:GetMouseLocation().X)
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            setFromX(input.Position.X)
        end
    end)

    return {
        SetValue = function(_, val)
            value = math.clamp(tonumber(val) or min, min, max)
            local a = (value - min) / (max - min)
            fill.Size = UDim2.new(a, 0, 1, 0)
            v.Text = tostring(value)
        end,
        GetValue = function()
            return value
        end,
        Frame = frame,
    }
end

local function GetPingMs()
    local ping = 0
    pcall(function()
        local item = Stats.Network.ServerStatsItem["Data Ping"]
        local str = item:GetValueString()
        ping = tonumber(str:match("[%d%.]+")) or 0
    end)
    return ping
end

local function GetMemory()
    local mb = 0
    pcall(function()
        mb = Stats:GetTotalMemoryUsageMb()
    end)
    return mb
end

function Angelws:CreateWindow(options)
    options = options or {}

    local Window = {}
    Window.Pages = {}
    Window.CurrentPage = nil

    local bgAsset = options.BackgroundImage or DEFAULT_BG
    local baseW = tonumber(options.BaseWidth) or 980
    local baseH = tonumber(options.BaseHeight) or 610
    local minScale = tonumber(options.MinScale) or 0.62
    local maxScale = tonumber(options.MaxScale) or 1

    local guiName = options.GuiName or "Angelws_Simple_UI"
    local old = ParentGui():FindFirstChild(guiName)
    if old then old:Destroy() end

    local ScreenGui = New("ScreenGui", {
        Name = guiName,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, ParentGui())

    Window.ScreenGui = ScreenGui

    local Root = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
    }, ScreenGui)

    local Main = New("Frame", {
        Name = "Main",
        BackgroundColor3 = Theme.Black,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(baseW, baseH),
        Position = UDim2.new(0.5, -baseW / 2, 0.5, -baseH / 2),
        ClipsDescendants = true,
    }, Root)
    Corner(Main, 24)
    Stroke(Main, 0.42, 1.35)

    local function responsive()
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1366, 768)
        local s = math.min((vp.X - 34) / baseW, (vp.Y - 34) / baseH)
        s = math.clamp(s, minScale, maxScale)

        local w = math.floor(baseW * s)
        local h = math.floor(baseH * s)

        Main.Size = UDim2.fromOffset(w, h)
        Main.Position = UDim2.new(0.5, -w / 2, 0.5, -h / 2)
    end

    responsive()
    if workspace.CurrentCamera then
        workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(responsive)
    end

    -- Background preso no frame da UI
    local Bg = New("ImageLabel", {
        Name = "BackgroundInsideUI",
        BackgroundTransparency = 1,
        Image = bgAsset,
        ImageColor3 = Color3.fromRGB(235, 235, 240),
        ImageTransparency = 0.02,
        ScaleType = Enum.ScaleType.Crop,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 0,
    }, Main)

    local DarkVeil = New("Frame", {
        BackgroundColor3 = Theme.Black,
        BackgroundTransparency = 0.34,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 1,
    }, Main)

    -- Glow branco angelical no fundo
    local Glow1 = New("Frame", {
        Name = "AngelGlowCenter",
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = 0.925,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 560, 0, 180),
        Position = UDim2.new(0.5, -120, 0, 58),
        Rotation = -14,
        ZIndex = 2,
    }, Main)
    Corner(Glow1, 90)
    Gradient(Glow1, 16, 0.2, 1)

    local Glow2 = New("Frame", {
        Name = "AngelGlowSide",
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = 0.955,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 390, 0, 390),
        Position = UDim2.new(1, -300, 0, -110),
        Rotation = 8,
        ZIndex = 2,
    }, Main)
    Corner(Glow2, 200)
    Gradient(Glow2, 35, 0.25, 1)

    local Header = MakeGlass(Main, {
        Name = "Header",
        Size = UDim2.new(1, -24, 0, 86),
        Position = UDim2.new(0, 12, 0, 12),
        Radius = 20,
        Transparency = 0.895,
        StrokeTransparency = 0.50,
        ZIndex = 10,
    })

    local BrandIcon = Text(Header, options.WingText or "(icone: asas)", 12, Theme.White, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
    BrandIcon.Size = UDim2.new(0, 150, 0, 18)
    BrandIcon.Position = UDim2.new(0, 30, 0, 10)
    BrandIcon.ZIndex = 12

    local Brand = Text(Header, options.Title or "Angelws", 34, Theme.White, Enum.Font.Garamond)
    Brand.Size = UDim2.new(0, 320, 0, 46)
    Brand.Position = UDim2.new(0, 32, 0, 27)
    Brand.TextStrokeColor3 = Theme.White
    Brand.TextStrokeTransparency = 0.78
    Brand.ZIndex = 12


        DiagonalTransparency = 0.91,
    })

    local PageHolder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 1, -20),
        Position = UDim2.new(0, 10, 0, 10),
        ZIndex = Content.ZIndex + 30,
    }, Content)

    local minimized = false
    Minimize.MouseButton1Click:Connect(function()
        minimized = not minimized
        Body.Visible = not minimized
        if minimized then
            Tween(Main, {Size = UDim2.new(Main.Size.X.Scale, Main.Size.X.Offset, 0, 110)}, 0.22)
        else
            responsive()
        end
    end)

    Close.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
    end)

    -- Drag
    do
        local dragging = false
        local dragStart
        local startPos

        Header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = Main.Position
            end
        end)

        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    local function SelectPage(page)
        for _, p in ipairs(Window.Pages) do
            local active = p == page
            p.Frame.Visible = active
            Tween(p.Button, {BackgroundTransparency = active and 0.76 or 0.91}, 0.16)
            p.Button.Title.TextColor3 = active and Theme.White or Theme.Muted
        end
        Window.CurrentPage = page
    end

    function Window:CreatePage(title, icon)
        local page = {}
        page.Title = tostring(title or "Page")
        page.Icon = tostring(icon or "(icone)")

        local button = New("TextButton", {
            BackgroundColor3 = Theme.White,
            BackgroundTransparency = 0.91,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 48),
            Text = "",
            AutoButtonColor = false,
            ZIndex = PageButtons.ZIndex + 10,
        }, PageButtons)
        Corner(button, 14)
        Stroke(button, 0.58, 1)
        AddGlassLayers(button, {
            BgTransparency = 0.62,
            Bg2Transparency = 0.86,
            DarkTransparency = 0.40,
            WhiteTransparency = 0.92,
            HighlightTransparency = 0.38,
            DiagonalTransparency = 0.96,
            InnerGlowTransparency = 0.975,
        })

        local ico = Text(button, page.Icon, 15, Theme.White, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
        ico.Size = UDim2.new(0, 42, 1, 0)

        local label = Text(button, page.Title, 13, Theme.Muted, Enum.Font.GothamBold)
        label.Name = "Title"
        label.Size = UDim2.new(1, -52, 1, 0)
        label.Position = UDim2.new(0, 50, 0, 0)

        local frame = New("ScrollingFrame", {
            Name = page.Title .. "_Page",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1),
            CanvasSize = UDim2.fromOffset(0, 0),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.White,
            ScrollBarImageTransparency = 0.35,
            Visible = false,
            ZIndex = PageHolder.ZIndex + 10,
        }, PageHolder)
        Pad(frame, 4)

        local layout = List(frame, 12)
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            frame.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 20)
        end)

        function page:CreateSection(name)
            local sec = MakeGlass(frame, {
                Size = UDim2.new(1, -6, 0, 68),
                Radius = 18,
                Transparency = 0.94,
                StrokeTransparency = 0.48,
                AutomaticSize = Enum.AutomaticSize.Y,
                ZIndex = frame.ZIndex + 10,
                BgTransparency = 0.58,
                Bg2Transparency = 0.84,
                DarkTransparency = 0.39,
                WhiteTransparency = 0.915,
                HighlightTransparency = 0.35,
                DiagonalTransparency = 0.945,
            })
            Pad(sec, 12)
            List(sec, 10)

            local h = Text(sec, "✦  " .. tostring(name or "Section"), 15, Theme.White, Enum.Font.GothamBold)
            h.Size = UDim2.new(1, 0, 0, 28)

            local section = {}

            function section:CreateButton(titleText, desc, iconText, callback)
                return MakeButton(sec, titleText, desc, iconText, callback)
            end

            function section:CreateToggle(titleText, desc, default, callback)
                return MakeToggle(sec, titleText, desc, default, callback)
            end

            function section:CreateSlider(titleText, min, max, default, callback)
                return MakeSlider(sec, titleText, min, max, default, callback)
            end

            return section
        end

        function page:CreateHero(titleText, desc)
            local hero = MakeGlass(frame, {
                Size = UDim2.new(1, -6, 0, 112),
                Radius = 20,
                Transparency = 0.925,
                StrokeTransparency = 0.38,
                ZIndex = frame.ZIndex + 10,
                BgTransparency = 0.43,
                Bg2Transparency = 0.72,
                DarkTransparency = 0.28,
                WhiteTransparency = 0.89,
                HighlightTransparency = 0.22,
                DiagonalTransparency = 0.90,
                InnerGlowTransparency = 0.94,
            })
            Pad(hero, 16)

            local t = Text(hero, titleText or "Welcome", 22, Theme.White, Enum.Font.GothamBold)
            t.Size = UDim2.new(1, -30, 0, 34)
            t.Position = UDim2.new(0, 0, 0, 10)

            local d = Text(hero, desc or "", 12, Theme.Muted, Enum.Font.GothamMedium)
            d.Size = UDim2.new(1, -30, 0, 28)
            d.Position = UDim2.new(0, 0, 0, 46)

            local wing = Text(hero, "(imagem: asas/glow)", 12, Theme.White, Enum.Font.GothamBlack, Enum.TextXAlignment.Right)
            wing.Size = UDim2.new(0, 220, 0, 24)
            wing.Position = UDim2.new(1, -230, 1, -36)

            return hero
        end

        page.Button = button
        page.Frame = frame

        button.MouseButton1Click:Connect(function()
            SelectPage(page)
        end)

        button.MouseEnter:Connect(function()
            if Window.CurrentPage ~= page then
                Tween(button, {BackgroundTransparency = 0.82}, 0.14)
            end
        end)

        button.MouseLeave:Connect(function()
            if Window.CurrentPage ~= page then
                Tween(button, {BackgroundTransparency = 0.91}, 0.14)
            end
        end)

        table.insert(Window.Pages, page)

        return page
    end

    function Window:SelectPage(name)
        for _, p in ipairs(Window.Pages) do
            if p.Title == name then
                SelectPage(p)
                return p
            end
        end
    end

    function Window:Destroy()
        ScreenGui:Destroy()
    end

    -- Página inicial Config
    local Config = Window:CreatePage("Config", "(icone)")
    Config:CreateHero(
        "Welcome to Angelws, " .. tostring(options.Username or (LocalPlayer and LocalPlayer.Name or "Username")) .. ".",
        "Glassmorphism angelcore layout with frosted containers."
    )

    local quick = Config:CreateSection("Quick Actions")

    quick:CreateButton("Load Config", "Placeholder for loading saved settings", "(icone)", function()
        print("[Angelws] Load Config clicked")
    end)

    quick:CreateButton("Save Config", "Placeholder for saving current settings", "(icone)", function()
        print("[Angelws] Save Config clicked")
    end)

    quick:CreateButton("Discord", "Copies your Discord invite/link to clipboard", "(icone)", function()
        local link = options.Discord or "https://discord.gg/angelws"
        if setclipboard then
            setclipboard(link)
        end

        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Angelws",
                Text = setclipboard and "Discord copied to clipboard." or "Clipboard not supported.",
                Duration = 4
            })
        end)
    end)

    local uiSec = Config:CreateSection("Interface")
    uiSec:CreateToggle("Glass Highlight", "Visual placeholder toggle", true)
    uiSec:CreateSlider("Window Glow", 0, 100, 65)

    if options.DefaultPages ~= false then
        local Home = Window:CreatePage("Home", "(icone)")
        Home:CreateHero("Home", "Clean page example with frosted glass cards.")
        local hs = Home:CreateSection("Dashboard")
        hs:CreateButton("Example Button", "A simple placeholder button", "(icone)")
        hs:CreateToggle("Example Toggle", "Visual only", false)
        hs:CreateSlider("Example Slider", 0, 100, 35)

        local Visuals = Window:CreatePage("Visuals", "(icone)")
        Visuals:CreateHero("Visuals", "Future visual settings can stay here.")
        local vs = Visuals:CreateSection("Visual Options")
        vs:CreateToggle("Enable Visuals", "Placeholder", false)
        vs:CreateButton("Refresh", "Placeholder action", "(icone)")

        local Settings = Window:CreatePage("Settings", "(icone)")
        Settings:CreateHero("Settings", "General interface settings.")
        local ss = Settings:CreateSection("Window")
        ss:CreateButton("Destroy UI", "Close the Angelws interface", "(icone)", function()
            Window:Destroy()
        end)
    end

    task.defer(function()
        Window:SelectPage("Config")
    end)

    local toggleKey = options.ToggleKey or Enum.KeyCode.RightShift
    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == toggleKey then
            Main.Visible = not Main.Visible
        end
    end)

    return Window
end

return Angelws

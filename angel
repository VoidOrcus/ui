local function ParentGui()
    return (gethui and gethui()) or CoreGui
end

local function Tween(obj, props, duration, style, direction)
    local info = TweenInfo.new(duration or 0.18, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out)
    local tw = TweenService:Create(obj, info, props)
    tw:Play()
    return tw
end

local function New(className, props, parent)
    local obj = Instance.new(className)
    if props then
        for k, v in pairs(props) do
            obj[k] = v
        end
    end
    if parent then obj.Parent = parent end
    return obj
end

local function Corner(parent, radius)
    return New("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, parent)
end

local function Stroke(parent, color, thickness, transparency)
    return New("UIStroke", {
        Color = color or Theme.PureWhite,
        Thickness = thickness or 1,
        Transparency = transparency or 0.75,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function Gradient(parent, c1, c2, rotation, transparency)
    local grad = New("UIGradient", {
        Rotation = rotation or 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, c1 or Theme.PureWhite),
            ColorSequenceKeypoint.new(1, c2 or Theme.Black),
        }),
    }, parent)
    if transparency then
        grad.Transparency = transparency
    end
    return grad
end


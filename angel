    pcall(function()
        mb = Stats:GetTotalMemoryUsageMb()
    end)
    return mb
end

local function CreateViewportCharacter(parent)
    local viewport = New("ViewportFrame", {
        BackgroundColor3 = Theme.Black,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Ambient = Color3.fromRGB(190, 190, 200),
        LightColor = Color3.fromRGB(255, 255, 255),
        LightDirection = Vector3.new(-1, -1, -1),
    }, parent)

    local cam = Instance.new("Camera")
    cam.Parent = viewport
    viewport.CurrentCamera = cam

    local world = Instance.new("WorldModel")
    world.Parent = viewport

    local function refresh()
        world:ClearAllChildren()

        local char = LocalPlayer and LocalPlayer.Character
        if not char then return end

        local oldArchivable = char.Archivable
        char.Archivable = true

        local clone
        local ok = pcall(function()
            clone = char:Clone()
        end)

        char.Archivable = oldArchivable

        if not ok or not clone then return end

        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") then
                d:Destroy()
            elseif d:IsA("BasePart") then
                d.Anchored = true
                d.CanCollide = false
                d.CastShadow = false
            end
        end

        clone.Parent = world

        local root = clone:FindFirstChild("HumanoidRootPart") or clone:FindFirstChild("UpperTorso") or clone:FindFirstChildWhichIsA("BasePart")
        local humanoid = clone:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function()
                humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            end)
        end

        if root then
            root.CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(180), 0)
            cam.CFrame = CFrame.new(Vector3.new(0, 1.3, 5.8), Vector3.new(0, 1.15, 0))
            cam.FieldOfView = 31
        end
    end

    task.defer(refresh)
    if LocalPlayer then
        LocalPlayer.CharacterAdded:Connect(function()
            task.wait(1)
            refresh()
        end)
    end

    return viewport
end

local function GlassFrame(parent, props)
    props = props or {}

    local frame = New("Frame", {
        Name = props.Name or "GlassFrame",
        BackgroundColor3 = props.Color or Theme.Glass,
        BackgroundTransparency = props.Transparency or 0.925,
        BorderSizePixel = 0,
        Size = props.Size or UDim2.fromOffset(100, 100),
        Position = props.Position or UDim2.fromOffset(0, 0),
        ClipsDescendants = props.ClipsDescendants ~= false,
        ZIndex = props.ZIndex or 1,
        LayoutOrder = props.LayoutOrder or 0,
        AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
    }, parent)

    Corner(frame, props.Radius or 18)
    Stroke(frame, props.StrokeColor or Theme.PureWhite, props.StrokeThickness or 1, props.StrokeTransparency or 0.63)

    if props.GlassBackgroundImage then
        local bg = New("ImageLabel", {
            Name = "GlassFakeBlurBackground",
            BackgroundTransparency = 1,
            Image = props.GlassBackgroundImage,
            ImageTransparency = props.GlassImageTransparency or 0.72,
            ImageColor3 = Color3.fromRGB(230, 230, 235),
            ScaleType = Enum.ScaleType.Crop,
            Size = UDim2.new(1.14, 0, 1.14, 0),
            Position = UDim2.new(-0.07, 0, -0.07, 0),
            ZIndex = frame.ZIndex,
        }, frame)

        local dark = New("Frame", {
            Name = "GlassDarkVeil",
            BackgroundColor3 = Theme.Black,
            BackgroundTransparency = props.DarkVeilTransparency or 0.37,
            BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1),
            ZIndex = frame.ZIndex + 1,
        }, frame)

        local white = New("Frame", {
            Name = "GlassWhiteVeil",
            BackgroundColor3 = Theme.PureWhite,
            BackgroundTransparency = props.WhiteVeilTransparency or 0.94,
            BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1),
            ZIndex = frame.ZIndex + 2,
        }, frame)

        Gradient(white, Theme.PureWhite, Theme.Black, props.GradientRotation or 135, NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.86),
            NumberSequenceKeypoint.new(0.45, 0.985),
            NumberSequenceKeypoint.new(1, 0.93),
        }))
    elseif props.Gradient ~= false then
        Gradient(frame, props.GradientA or Theme.PureWhite, props.GradientB or Theme.Black, props.GradientRotation or 135, NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.88),
            NumberSequenceKeypoint.new(0.5, 0.99),
            NumberSequenceKeypoint.new(1, 0.93),
        }))
    end

    local topHighlight = New("Frame", {
        Name = "TopWhiteHighlight",
        BackgroundColor3 = Theme.PureWhite,
        BackgroundTransparency = props.HighlightTransparency or 0.58,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -24, 0, 1),
        Position = UDim2.new(0, 12, 0, 9),
        ZIndex = frame.ZIndex + 4,
    }, frame)
    Gradient(topHighlight, Theme.PureWhite, Theme.Black, 0, NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 0.15),
        NumberSequenceKeypoint.new(1, 1),
    }))

    return frame
end


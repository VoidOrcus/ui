            function Section:CreateToggle(opts, callback)
                if type(opts) ~= "table" then opts = {Title = tostring(opts)} end
                callback = opts.Callback or callback

                local control = {
                    Type = "Toggle",
                    Value = opts.Default == true,
                    PremiumOnly = opts.PremiumOnly == true or opts.RequiresPremium == true,
                    LockMessage = opts.LockMessage or "Premium Only",
                    Flag = opts.Flag,
                }

                local frame = createControlFrame(Sec, 62)
                local titleLbl = makeText(frame, opts.Title or "Toggle", 13, Color3.fromRGB(255,255,255), Enum.Font.GothamBold)
                titleLbl.Size = UDim2.new(1, -100, 0, 22)
                titleLbl.Position = UDim2.new(0, 14, 0, 9)

                local descLbl = makeText(frame, opts.Description or "", 11, Color3.fromRGB(155,155,160), Enum.Font.GothamMedium)
                descLbl.Size = UDim2.new(1, -100, 0, 18)
                descLbl.Position = UDim2.new(0, 14, 0, 33)

                local switch = Instance.new("TextButton")
                switch.BackgroundColor3 = Color3.fromRGB(255,255,255)
                switch.BackgroundTransparency = 0.92
                switch.BorderSizePixel = 0
                switch.Text = ""
                switch.AutoButtonColor = false
                switch.Size = UDim2.new(0, 54, 0, 28)
                switch.Position = UDim2.new(1, -70, 0.5, -14)
                switch.Parent = frame
                corner(switch, 14)
                stroke(switch, Color3.fromRGB(255,255,255), 1, 0.82)

                local knob = Instance.new("Frame")
                knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
                knob.BorderSizePixel = 0
                knob.Size = UDim2.new(0, 20, 0, 20)
                knob.Position = UDim2.new(0, 4, 0.5, -10)
                knob.Parent = switch
                corner(knob, 10)

                local function render(silent)
                    if control.Value then
                        tween(switch, {BackgroundTransparency = 0.74}, 0.18)
                        tween(knob, {Position = UDim2.new(1, -24, 0.5, -10)}, 0.18)
                    else
                        tween(switch, {BackgroundTransparency = 0.92}, 0.18)
                        tween(knob, {Position = UDim2.new(0, 4, 0.5, -10)}, 0.18)
                    end
                    if control.Flag then window.Flags[control.Flag] = control.Value end
                    if not silent and callback then callback(control.Value, control) end
                end

                function control:SetValue(v, silent)
                    if control.Locked then
                        control.Value = false
                        render(true)
                        return control
                    end
                    control.Value = v == true
                    render(silent)
                    return control
                end

                function control:GetValue()
                    return control.Value
                end

                switch.MouseButton1Click:Connect(function()
                    if control.Locked then
                        notify("Premium Only", control.LockMessage)
                        return
                    end
                    control.Value = not control.Value
                    render(false)
                end)

                createLockOverlay(frame, control, control.LockMessage)
                render(true)
                return addControl(control)
            end

            function Section:CreateSlider(opts, callback)
                opts = opts or {}
                callback = opts.Callback or callback

                local min = tonumber(opts.Min or opts.Minimum) or 0
                local max = tonumber(opts.Max or opts.Maximum) or 100
                local default = tonumber(opts.Default or opts.Value) or min

                local control = {
                    Type = "Slider",
                    Value = math.clamp(default, min, max),
                    Min = min,
                    Max = max,
                    PremiumOnly = opts.PremiumOnly == true or opts.RequiresPremium == true,
                    LockMessage = opts.LockMessage or "Premium Only",
                    Flag = opts.Flag,
                }

                local frame = createControlFrame(Sec, 72)

                local titleLbl = makeText(frame, opts.Title or "Slider", 13, Color3.fromRGB(255,255,255), Enum.Font.GothamBold)
                titleLbl.Size = UDim2.new(1, -110, 0, 22)
                titleLbl.Position = UDim2.new(0, 14, 0, 8)

                local valueLbl = makeText(frame, tostring(control.Value), 12, Color3.fromRGB(255,255,255), Enum.Font.GothamBlack, Enum.TextXAlignment.Right)
                valueLbl.Size = UDim2.new(0, 90, 0, 22)
                valueLbl.Position = UDim2.new(1, -104, 0, 8)

                local bar = Instance.new("TextButton")
                bar.BackgroundColor3 = Color3.fromRGB(255,255,255)
                bar.BackgroundTransparency = 0.92
                bar.BorderSizePixel = 0
                bar.Text = ""
                bar.AutoButtonColor = false
                bar.Size = UDim2.new(1, -28, 0, 10)
                bar.Position = UDim2.new(0, 14, 0, 44)
                bar.Parent = frame
                corner(bar, 5)

                local fill = Instance.new("Frame")
                fill.BackgroundColor3 = Color3.fromRGB(255,255,255)
                fill.BackgroundTransparency = 0.15
                fill.BorderSizePixel = 0
                fill.Size = UDim2.fromScale(0, 1)
                fill.Parent = bar
                corner(fill, 5)

                local function render(silent)
                    local alpha = (control.Value - min) / (max - min)
                    fill.Size = UDim2.fromScale(math.clamp(alpha, 0, 1), 1)
                    valueLbl.Text = tostring(math.floor(control.Value * 100) / 100)
                    if control.Flag then window.Flags[control.Flag] = control.Value end
                    if not silent and callback then callback(control.Value, control) end
                end

                local dragging = false
                local function setFromX(x, silent)
                    if control.Locked then return end
                    local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    control.Value = min + ((max - min) * alpha)
                    if opts.Rounding ~= false then
                        control.Value = math.floor(control.Value + 0.5)
                    end
                    render(silent)
                end

                bar.MouseButton1Down:Connect(function()
                    if control.Locked then
                        notify("Premium Only", control.LockMessage)
                        return
                    end
                    dragging = true
                    setFromX(UIS:GetMouseLocation().X, false)
                end)

                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)

                UIS.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        setFromX(input.Position.X, false)
                    end
                end)

                function control:SetValue(v, silent)
                    if control.Locked then return control end
                    control.Value = math.clamp(tonumber(v) or min, min, max)
                    render(silent)
                    return control
                end

                function control:GetValue()
                    return control.Value
                end

                createLockOverlay(frame, control, control.LockMessage)
                render(true)
                return addControl(control)
            end

            function Section:CreateDropdown(opts, callback)
                opts = opts or {}
                callback = opts.Callback or callback

                local items = opts.Options or opts.List or opts.Values or {}
                local default = opts.Default or items[1] or "None"

                local control = {
                    Type = "Dropdown",
                    Value = default,
                    Options = items,
                    Open = false,
                    PremiumOnly = opts.PremiumOnly == true or opts.RequiresPremium == true,
                    LockMessage = opts.LockMessage or "Premium Only",
                    Flag = opts.Flag,
                }

                local frame = createControlFrame(Sec, 62)

                local titleLbl = makeText(frame, opts.Title or "Dropdown", 13, Color3.fromRGB(255,255,255), Enum.Font.GothamBold)
                titleLbl.Size = UDim2.new(1, -180, 0, 22)
                titleLbl.Position = UDim2.new(0, 14, 0, 8)

                local descLbl = makeText(frame, opts.Description or "", 11, Color3.fromRGB(155,155,160), Enum.Font.GothamMedium)
                descLbl.Size = UDim2.new(1, -180, 0, 18)
                descLbl.Position = UDim2.new(0, 14, 0, 33)

                local drop = makeButton(frame, tostring(default) .. "  ˅")
                drop.Size = UDim2.new(0, 150, 0, 34)
                drop.Position = UDim2.new(1, -164, 0.5, -17)
                drop.TextSize = 11

                local menu = Instance.new("Frame")
                menu.BackgroundColor3 = Color3.fromRGB(8,8,10)
                menu.BackgroundTransparency = 0.03
                menu.BorderSizePixel = 0
                menu.Size = UDim2.new(0, 150, 0, 0)
                menu.Position = UDim2.new(1, -164, 1, 4)
                menu.ClipsDescendants = true
                menu.ZIndex = 80
                menu.Visible = false
                menu.Parent = frame
                corner(menu, 12)
                stroke(menu, Color3.fromRGB(255,255,255), 1, 0.78)
                list(menu, 3)
                padding(menu, 5)

                local function rebuild()
                    for _, c in ipairs(menu:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    for _, item in ipairs(control.Options) do
                        local opt = makeButton(menu, tostring(item))
                        opt.Size = UDim2.new(1, 0, 0, 28)
                        opt.ZIndex = 81
                        opt.MouseButton1Click:Connect(function()
                            if control.Locked then return end
                            control.Value = item
                            drop.Text = tostring(item) .. "  ˅"
                            control.Open = false
                            tween(menu, {Size = UDim2.new(0, 150, 0, 0)}, 0.16)
                            task.delay(0.17, function() if not control.Open then menu.Visible = false end end)
                            if control.Flag then window.Flags[control.Flag] = control.Value end
                            if callback then callback(control.Value, control) end
                        end)
                    end
                end

                rebuild()

                drop.MouseButton1Click:Connect(function()
                    if control.Locked then
                        notify("Premium Only", control.LockMessage)
                        return
                    end
                    control.Open = not control.Open
                    if control.Open then
                        menu.Visible = true
                        tween(menu, {Size = UDim2.new(0, 150, 0, math.min(#control.Options * 31 + 10, 190))}, 0.18)
                    else
                        tween(menu, {Size = UDim2.new(0, 150, 0, 0)}, 0.18)
                        task.delay(0.19, function() if not control.Open then menu.Visible = false end end)
                    end
                end)

                function control:SetValue(v, silent)
                    if control.Locked then return control end
                    control.Value = v
                    drop.Text = tostring(v) .. "  ˅"
                    if control.Flag then window.Flags[control.Flag] = control.Value end
                    if not silent and callback then callback(control.Value, control) end
                    return control
                end

                function control:GetValue()
                    return control.Value
                end

                createLockOverlay(frame, control, control.LockMessage)
                if control.Flag then window.Flags[control.Flag] = control.Value end
                return addControl(control)
            end

            function Section:CreateTextbox(opts, callback)
                opts = opts or {}
                callback = opts.Callback or callback

                local control = {
                    Type = "Textbox",
                    Value = opts.Default or "",
                    PremiumOnly = opts.PremiumOnly == true or opts.RequiresPremium == true,
                    LockMessage = opts.LockMessage or "Premium Only",
                    Flag = opts.Flag,
                }

                local frame = createControlFrame(Sec, 62)

                local titleLbl = makeText(frame, opts.Title or "Textbox", 13, Color3.fromRGB(255,255,255), Enum.Font.GothamBold)
                titleLbl.Size = UDim2.new(1, -190, 0, 22)
                titleLbl.Position = UDim2.new(0, 14, 0, 8)

                local descLbl = makeText(frame, opts.Description or "", 11, Color3.fromRGB(155,155,160), Enum.Font.GothamMedium)
                descLbl.Size = UDim2.new(1, -190, 0, 18)
                descLbl.Position = UDim2.new(0, 14, 0, 33)

                local box = Instance.new("TextBox")
                box.BackgroundColor3 = Color3.fromRGB(255,255,255)
                box.BackgroundTransparency = 0.93
                box.BorderSizePixel = 0
                box.Size = UDim2.new(0, 168, 0, 34)
                box.Position = UDim2.new(1, -182, 0.5, -17)
                box.Text = tostring(control.Value)
                box.PlaceholderText = opts.Placeholder or "Type..."
                box.PlaceholderColor3 = Color3.fromRGB(130,130,135)
                box.TextColor3 = Color3.fromRGB(255,255,255)
                box.Font = Enum.Font.GothamMedium
                box.TextSize = 12
                box.ClearTextOnFocus = false
                box.Parent = frame
                corner(box, 12)
                stroke(box, Color3.fromRGB(255,255,255), 1, 0.86)

                box.FocusLost:Connect(function()
                    if control.Locked then
                        box.Text = tostring(control.Value)
                        return
                    end
                    control.Value = box.Text
                    if control.Flag then window.Flags[control.Flag] = control.Value end
                    if callback then callback(control.Value, control) end
                end)

                function control:SetValue(v, silent)
                    if control.Locked then return control end
                    control.Value = tostring(v or "")
                    box.Text = control.Value
                    if control.Flag then window.Flags[control.Flag] = control.Value end
                    if not silent and callback then callback(control.Value, control) end
                    return control
                end

                function control:GetValue()
                    return control.Value
                end

                createLockOverlay(frame, control, control.LockMessage)
                return addControl(control)
            end

            return Section
        end

        Button.MouseButton1Click:Connect(function()
            window:SelectTab(tab)
        end)

        table.insert(window.Tabs, tab)
        if #window.Tabs == 1 then
            task.defer(function()
                window:SelectTab(tab)
            end)
        end

        return tab
    end

    if options.CreateConfigTab ~= false then
        local Config = window:CreateTab({Title = "Config", Icon = "♢"})
        local S = Config:CreateSection("Interface")
        S:CreateButton({Title = "Refresh Premium Locks", Description = "Re-check current key status", ButtonText = "REFRESH"}, function()
            local fresh = (getgenv and (getgenv().zZzKeyInfo or getgenv().CurrentKeyInfo)) or window.KeyInfo
            window:SetPremiumStatus(fresh)
            notify("zZz HUB", "Premium locks refreshed.")
        end)
        S:CreateButton({Title = "Destroy UI", Description = "Close the interface", ButtonText = "CLOSE"}, function()
            ScreenGui:Destroy()
        end)
    end

    return window
end

return zZzUILibrary

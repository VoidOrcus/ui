    Sub.Size = UDim2.new(0, 440, 0, 18)
    Sub.Position = UDim2.new(0, 250, 0, 52)
    Sub.ZIndex = 12

    local Minimize = New("TextButton", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = 0.90,
        BorderSizePixel = 0,
        Text = "—",
        TextColor3 = Theme.White,
        Font = Enum.Font.GothamBlack,
        TextSize = 18,
        AutoButtonColor = false,
        Size = UDim2.new(0, 38, 0, 34),
        Position = UDim2.new(1, -90, 0, 26),
        ZIndex = 12,
    }, Header)
    Corner(Minimize, 12)
    Stroke(Minimize, 0.70, 1)

    local Close = New("TextButton", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = 0.90,
        BorderSizePixel = 0,
        Text = "×",
        TextColor3 = Theme.White,
        Font = Enum.Font.GothamBlack,
        TextSize = 18,
        AutoButtonColor = false,
        Size = UDim2.new(0, 38, 0, 34),
        Position = UDim2.new(1, -46, 0, 26),
        ZIndex = 12,
    }, Header)
    Corner(Close, 12)
    Stroke(Close, 0.70, 1)

    local Body = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -24, 1, -118),
        Position = UDim2.new(0, 12, 0, 106),
        ZIndex = 10,
    }, Main)

    local Sidebar = MakeGlass(Body, {
        Name = "Sidebar",
        Size = UDim2.new(0, 190, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        Radius = 20,
        Transparency = 0.90,
        StrokeTransparency = 0.54,
        ZIndex = 11,
    })
    Pad(Sidebar, 10)
    List(Sidebar, 8)

    local SideTop = Text(Sidebar, "✦  Pages", 14, Theme.White, Enum.Font.GothamBlack)
    SideTop.Size = UDim2.new(1, 0, 0, 28)
    SideTop.LayoutOrder = 1
    SideTop.ZIndex = 14

    local PageButtons = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, -110),
        LayoutOrder = 2,
        ZIndex = 14,
    }, Sidebar)
    List(PageButtons, 8)

    local Quote = MakeGlass(Sidebar, {
        Size = UDim2.new(1, 0, 0, 86),
        Radius = 16,
        Transparency = 0.925,
        StrokeTransparency = 0.70,
        LayoutOrder = 3,
        ZIndex = 14,
    })
    local QuoteText = Text(Quote, "We are not just players.\nWe are angels of our own story.", 12, Theme.SoftWhite, Enum.Font.Garamond, Enum.TextXAlignment.Center)
    QuoteText.Size = UDim2.new(1, -12, 1, -12)
    QuoteText.Position = UDim2.new(0, 6, 0, 6)
    QuoteText.TextWrapped = true
    QuoteText.ZIndex = 16

    local Content = MakeGlass(Body, {
        Name = "Content",
        Size = UDim2.new(1, -204, 1, 0),
        Position = UDim2.new(0, 204, 0, 0),
        Radius = 20,
        Transparency = 0.895,
        StrokeTransparency = 0.52,
        ZIndex = 11,
    })

    local PageHolder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 1, -20),
        Position = UDim2.new(0, 10, 0, 10),
        ZIndex = 14,
    }, Content)

    local minimized = false
    Minimize.MouseButton1Click:Connect(function()
        minimized = not minimized
        Body.Visible = not minimized
        if minimized then
            Tween(Main, {Size = UDim2.new(Main.Size.X.Scale, Main.Size.X.Offset, 0, 110)}, 0.22)
        else
            responsive()
        end
    end)

    Close.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
    end)

    -- Drag
    do
        local dragging = false
        local dragStart
        local startPos

        Header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = Main.Position
            end
        end)

        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    local function SelectPage(page)
        for _, p in ipairs(Window.Pages) do
            local active = p == page
            p.Frame.Visible = active
            Tween(p.Button, {BackgroundTransparency = active and 0.78 or 0.91}, 0.16)
            p.Button.Title.TextColor3 = active and Theme.White or Theme.Muted
        end
        Window.CurrentPage = page
    end

    function Window:CreatePage(title, icon)
        local page = {}
        page.Title = tostring(title or "Page")
        page.Icon = tostring(icon or "(icone)")

        local button = New("TextButton", {
            BackgroundColor3 = Theme.White,
            BackgroundTransparency = 0.91,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 48),
            Text = "",
            AutoButtonColor = false,
            ZIndex = 15,
        }, PageButtons)
        Corner(button, 14)
        Stroke(button, 0.72, 1)
        Gradient(button, 135, 0.86, 0.98)

        local ico = Text(button, page.Icon, 15, Theme.White, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
        ico.Size = UDim2.new(0, 42, 1, 0)
        ico.ZIndex = 17

        local label = Text(button, page.Title, 13, Theme.Muted, Enum.Font.GothamBold)
        label.Name = "Title"
        label.Size = UDim2.new(1, -52, 1, 0)
        label.Position = UDim2.new(0, 50, 0, 0)
        label.ZIndex = 17

        local frame = New("ScrollingFrame", {
            Name = page.Title .. "_Page",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1),
            CanvasSize = UDim2.fromOffset(0, 0),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.White,
            ScrollBarImageTransparency = 0.35,
            Visible = false,
            ZIndex = 15,
        }, PageHolder)
        Pad(frame, 4)

        local layout = List(frame, 12)
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            frame.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 20)
        end)

        function page:CreateSection(name)
            local sec = MakeGlass(frame, {
                Size = UDim2.new(1, -6, 0, 68),
                Radius = 18,
                Transparency = 0.91,
                StrokeTransparency = 0.62,
                AutomaticSize = Enum.AutomaticSize.Y,
                ZIndex = 16,
            })

    local function SelectSubPage(subPage)
        if not subPage then return end

        for _, page in ipairs(Window.Pages) do
            for _, sp in ipairs(page.SubPages) do
                sp.Container.Visible = sp == subPage

                if sp.Button then
                    Tween(sp.Button, { BackgroundTransparency = sp == subPage and 0.78 or 0.93 }, 0.16)
                    if sp.Button:FindFirstChild("Label") then
                        sp.Button.Label.TextColor3 = sp == subPage and Theme.PureWhite or Theme.WhiteDim
                    end
                end
            end
        end

        Window.CurrentSubPage = subPage
    end

    local function SelectPage(page)
        if not page then return end

        Window.CurrentPage = page
        SubTitle.Text = string.upper(page.Title)

        for _, p in ipairs(Window.Pages) do
            local selected = p == page
            Tween(p.Button, { BackgroundTransparency = selected and 0.78 or 0.93 }, 0.16)

            p.Button.Title.TextColor3 = selected and Theme.PureWhite or Theme.WhiteDim
            p.Button.Subtitle.TextColor3 = selected and Theme.SoftWhite or Theme.WhiteMuted
            p.Button.Icon.TextColor3 = selected and Theme.PureWhite or Theme.WhiteMuted

            for _, sp in ipairs(p.SubPages) do
                sp.Container.Visible = false
            end
        end


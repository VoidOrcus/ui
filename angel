        ZIndex = 11,
        StrokeTransparency = 0.40,
        GlassStrength = 1,
    }, backgroundImage)
    Pad(Sidebar, 10)
    List(Sidebar, 8)

    local PagesTitle = Text(Sidebar, "✦  Pages", 14, Theme.White, Enum.Font.GothamBlack)
    PagesTitle.Size = UDim2.new(1, 0, 0, 28)
    PagesTitle.LayoutOrder = 1

    local PageList = New("ScrollingFrame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, -44),
        CanvasSize = UDim2.fromOffset(0, 0),
        ScrollBarThickness = 0,
        LayoutOrder = 2,
        ZIndex = Sidebar.ZIndex + 30,
    }, Sidebar)

    local PageListLayout = List(PageList, 8)
    PageListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        PageList.CanvasSize = UDim2.fromOffset(0, PageListLayout.AbsoluteContentSize.Y + 10)
    end)

    local Content = Glass(Body, {
        Name = "Content",
        Size = UDim2.new(1, -224, 1, 0),
        Position = UDim2.new(0, 224, 0, 0),
        Radius = 20,
        ZIndex = 11,
        StrokeTransparency = 0.40,
        GlassStrength = 1,
    }, backgroundImage)

    local PageHolder = New("Frame", {
        Name = "PageHolder",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 1, -20),
        Position = UDim2.new(0, 10, 0, 10),
        ZIndex = Content.ZIndex + 40,
    }, Content)

    local MobileOverlay = New("TextButton", {
        Name = "MobileOverlay",
        BackgroundColor3 = Theme.Black,
        BackgroundTransparency = 0.42,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Visible = false,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 70,
    }, Main)

    local mobileMenuOpen = false
    local minimized = false

    local function layout()
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1366, 768)
        local mobile = IsMobile()
        Window.IsMobile = mobile

        if mobile then
            local w = math.floor(math.min(vp.X - 22, 720))
            local h = math.floor(math.min(vp.Y - 22, 700))
            Main.Size = UDim2.fromOffset(w, h)
            Main.Position = UDim2.new(0.5, -w / 2, 0.5, -h / 2)

            Header.Size = UDim2.new(1, -20, 0, 78)
            Header.Position = UDim2.new(0, 10, 0, 10)

            Brand.Size = UDim2.new(1, -170, 0, 38)
            Brand.Position = UDim2.new(0, 22, 0, 28)
            Brand.TextSize = 28

            BrandIcon.Position = UDim2.new(0, 20, 0, 8)
            Subtitle.Visible = false

            MenuButton.Visible = true
            MenuButton.Position = UDim2.new(1, -134, 0, 22)
            Minimize.Position = UDim2.new(1, -90, 0, 22)
            Close.Position = UDim2.new(1, -46, 0, 22)

            Body.Position = UDim2.new(0, 10, 0, 96)
            Body.Size = UDim2.new(1, -20, 1, -106)

            Sidebar.Size = UDim2.new(0, 230, 1, 0)
            Sidebar.Position = mobileMenuOpen and UDim2.new(0, 0, 0, 0) or UDim2.new(0, -244, 0, 0)
            Sidebar.ZIndex = 80
            MobileOverlay.Visible = mobileMenuOpen

            Content.Size = UDim2.new(1, 0, 1, 0)
            Content.Position = UDim2.new(0, 0, 0, 0)

            SetTextScale(Main, 0.92)
        else
            local scale = math.min((vp.X - 40) / baseW, (vp.Y - 40) / baseH)
            scale = math.clamp(scale, options.MinScale or 0.72, options.MaxScale or 1)

            local w = math.floor(baseW * scale)
            local h = math.floor(baseH * scale)
            Main.Size = UDim2.fromOffset(w, h)
            Main.Position = UDim2.new(0.5, -w / 2, 0.5, -h / 2)

            Header.Size = UDim2.new(1, -24, 0, 86)
            Header.Position = UDim2.new(0, 12, 0, 12)

            Brand.Size = UDim2.new(0, 320, 0, 44)
            Brand.Position = UDim2.new(0, 32, 0, 28)
            Brand.TextSize = 34

            BrandIcon.Position = UDim2.new(0, 30, 0, 10)
            Subtitle.Visible = true

            MenuButton.Visible = false
            Minimize.Position = UDim2.new(1, -92, 0, 26)
            Close.Position = UDim2.new(1, -48, 0, 26)

            Body.Position = UDim2.new(0, 12, 0, 106)
            Body.Size = UDim2.new(1, -24, 1, -118)

            Sidebar.Size = UDim2.new(0, 210, 1, 0)
            Sidebar.Position = UDim2.new(0, 0, 0, 0)
            Sidebar.ZIndex = 11
            MobileOverlay.Visible = false
            mobileMenuOpen = false

            Content.Size = UDim2.new(1, -224, 1, 0)
            Content.Position = UDim2.new(0, 224, 0, 0)

            SetTextScale(Main, scale >= 0.90 and 1 or 0.94)
        end
    end

    layout()
    if workspace.CurrentCamera then
        workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(layout)
    end

    -- Drag
    do
        local dragging = false
        local startMouse
        local startPos

        Header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                startMouse = input.Position
                startPos = Main.Position
            end
        end)

        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - startMouse
                Main.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    MenuButton.MouseButton1Click:Connect(function()
        mobileMenuOpen = not mobileMenuOpen
        layout()
    end)

    MobileOverlay.MouseButton1Click:Connect(function()
        mobileMenuOpen = false
        layout()
    end)

    Minimize.MouseButton1Click:Connect(function()
        minimized = not minimized
        Body.Visible = not minimized
        if minimized then
            Tween(Main, {Size = UDim2.new(Main.Size.X.Scale, Main.Size.X.Offset, 0, Window.IsMobile and 96 or 110)}, 0.20)
        else
            layout()
        end
    end)

    Close.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
    end)

    local function SelectPage(page)
        for _, p in ipairs(Window.Pages) do
            local active = p == page
            p.Container.Visible = active
            Tween(p.Button, {BackgroundTransparency = active and 0.76 or 0.91}, 0.16)
            p.Button.Title.TextColor3 = active and Theme.White or Theme.TextDim
        end

        Window.CurrentPage = page

        if Window.IsMobile then
            mobileMenuOpen = false
            layout()
        end
    end

    function Window:CreatePage(title, icon)
        local page = {}
        page.Title = tostring(title or "Page")
        page.Icon = tostring(icon or "(icone)")

        local btn = New("TextButton", {
            Name = page.Title .. "_Button",
            BackgroundColor3 = Theme.White,
            BackgroundTransparency = 0.91,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            Size = UDim2.new(1, 0, 0, 50),
            ZIndex = PageList.ZIndex + 10,
        }, PageList)
        Corner(btn, 14)
        Stroke(btn, 0.58, 1)
        AddGlassFX(btn, backgroundImage, 0.75)

        local ico = Text(btn, page.Icon, 15, Theme.White, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
        ico.Size = UDim2.new(0, 44, 1, 0)

        local label = Text(btn, page.Title, 13, Theme.TextDim, Enum.Font.GothamBold)
        label.Name = "Title"
        label.Size = UDim2.new(1, -54, 1, 0)
        label.Position = UDim2.new(0, 52, 0, 0)

        local container = New("ScrollingFrame", {
            Name = page.Title .. "_Page",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1),
            CanvasSize = UDim2.fromOffset(0, 0),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.White,
            ScrollBarImageTransparency = 0.35,
            Visible = false,
            ZIndex = PageHolder.ZIndex + 10,
        }, PageHolder)
        Pad(container, 4, 4, 4, 4)

        local layoutObj = List(container, 12)
        layoutObj:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            container.CanvasSize = UDim2.fromOffset(0, layoutObj.AbsoluteContentSize.Y + 22)
        end)

        function page:CreateHero(titleText, descText)
            local hero = Glass(container, {
                Size = UDim2.new(1, -6, 0, 118),
                Radius = 20,
                ZIndex = container.ZIndex + 10,
                StrokeTransparency = 0.38,
                GlassStrength = 1,
            }, backgroundImage)

            local titleLabel = Text(hero, titleText or "Welcome", 22, Theme.White, Enum.Font.GothamBold)
            titleLabel.Size = UDim2.new(1, -38, 0, 34)
            titleLabel.Position = UDim2.new(0, 18, 0, 20)

            local descLabel = Text(hero, descText or "", 12, Theme.TextDim, Enum.Font.GothamMedium)
            descLabel.Size = UDim2.new(1, -38, 0, 28)
            descLabel.Position = UDim2.new(0, 18, 0, 54)

            local wing = Text(hero, "(imagem: asas/glow)", 12, Theme.White, Enum.Font.GothamBlack, Enum.TextXAlignment.Right)
            wing.Size = UDim2.new(0, 220, 0, 24)
            wing.Position = UDim2.new(1, -238, 1, -36)

            return hero
        end

        function page:CreateSection(sectionTitle)
            local sectionFrame = Glass(container, {
                Size = UDim2.new(1, -6, 0, 72),
                Radius = 18,
                ZIndex = container.ZIndex + 10,
                StrokeTransparency = 0.48,
                AutomaticSize = Enum.AutomaticSize.Y,
                GlassStrength = 0.85,
            }, backgroundImage)

            Pad(sectionFrame, 12, 12, 12, 12)
            List(sectionFrame, 10)

            local header = Text(sectionFrame, "✦  " .. tostring(sectionTitle or "Section"), 15, Theme.White, Enum.Font.GothamBold)
            header.Size = UDim2.new(1, 0, 0, 28)

            local section = {}

            function section:CreateButton(titleText, desc, iconText, callback)
                return ButtonBase(sectionFrame, titleText, desc, iconText, callback, backgroundImage)
            end

            function section:CreateToggle(titleText, desc, default, callback)
                return MakeToggle(sectionFrame, titleText, desc, default, callback, backgroundImage)
            end

            function section:CreateSlider(titleText, min, max, default, callback)
                return MakeSlider(sectionFrame, titleText, min, max, default, callback, backgroundImage)
            end

            function section:CreateDropdown(titleText, desc, values, default, callback)
                return MakeDropdown(sectionFrame, titleText, desc, values, default, callback, backgroundImage)
            end

            return section
        end

        page.Button = btn
        page.Container = container

        btn.MouseButton1Click:Connect(function()
            SelectPage(page)
        end)

        btn.MouseEnter:Connect(function()
            if Window.CurrentPage ~= page then
                Tween(btn, {BackgroundTransparency = 0.82}, 0.14)
            end
        end)

        btn.MouseLeave:Connect(function()
            if Window.CurrentPage ~= page then
                Tween(btn, {BackgroundTransparency = 0.91}, 0.14)
            end
        end)

        table.insert(Window.Pages, page)

        if not Window.CurrentPage then
            task.defer(function()
                SelectPage(page)
            end)
        end

        return page
    end

    function Window:SelectPage(name)
        for _, page in ipairs(Window.Pages) do
            if page.Title == name then
                SelectPage(page)
                return page
            end
        end
    end

    function Window:Destroy()
        ScreenGui:Destroy()
    end

    local toggleKey = options.ToggleKey or Enum.KeyCode.RightShift
    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == toggleKey then
            Main.Visible = not Main.Visible
        end
    end)

    if options.DefaultPages ~= false then
        local Config = Window:CreatePage("Config", "(icone)")
        Config:CreateHero(
            "Welcome to Angelws",
            "Interface responsiva para PC e mobile, com páginas e área de conteúdo."
        )

        local quick = Config:CreateSection("Quick Actions")
        quick:CreateButton("Load Config", "Placeholder for loading settings", "(icone)", function()
            print("[Angelws] Load Config")
        end)
        quick:CreateButton("Save Config", "Placeholder for saving settings", "(icone)", function()
            print("[Angelws] Save Config")
        end)
        quick:CreateButton("Discord", "Copy invite link to clipboard", "(icone)", function()
            local link = options.Discord or "https://discord.gg/angelws"
            if setclipboard then
                setclipboard(link)
            end
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Angelws",
                    Text = setclipboard and "Discord copied." or "Clipboard not supported.",
                    Duration = 4
                })
            end)
        end)

        local interface = Config:CreateSection("Interface")
        interface:CreateToggle("Glass Effect", "Visual placeholder toggle", true)
        interface:CreateSlider("Glow Strength", 0, 100, 65)
        interface:CreateDropdown("Start Page", "Choose a visual start page", {"Config", "Home", "Visuals", "Settings"}, "Config")

        local Home = Window:CreatePage("Home", "(icone)")
        Home:CreateHero("Home", "Página simples para testar conteúdo.")
        local homeSec = Home:CreateSection("Components")
        homeSec:CreateButton("Example Button", "Button visual test", "(icone)")
        homeSec:CreateToggle("Example Toggle", "Toggle visual test", false)
        homeSec:CreateSlider("Example Slider", 0, 100, 40)
        homeSec:CreateDropdown("Example Dropdown", "Dropdown visual test", {"One", "Two", "Three"}, "One")

        local Visuals = Window:CreatePage("Visuals", "(icone)")
        Visuals:CreateHero("Visuals", "Área para opções visuais.")
        local visualSec = Visuals:CreateSection("Visual Options")
        visualSec:CreateToggle("Show Effects", "Placeholder", true)
        visualSec:CreateToggle("White Glow", "Placeholder", true)
        visualSec:CreateSlider("Opacity", 0, 100, 70)

        local Settings = Window:CreatePage("Settings", "(icone)")
        Settings:CreateHero("Settings", "Configurações gerais da interface.")
        local setSec = Settings:CreateSection("Window")
        setSec:CreateButton("Destroy UI", "Close interface", "(icone)", function()
            Window:Destroy()
        end)
    end

    return Window
end

return Angelws

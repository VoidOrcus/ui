                        Position = active and UDim2.new(1, -24, 0.5, -10) or UDim2.new(0, 4, 0.5, -10),
                    }, Switch)
                    Corner(Knob, 10)

                    local function Render()
                        Tween(Switch, {BackgroundTransparency = active and 0.78 or 0.93}, 0.15)
                        Tween(Knob, {
                            Position = active and UDim2.new(1, -24, 0.5, -10) or UDim2.new(0, 4, 0.5, -10)
                        }, 0.15)
                    end

                    Switch.MouseButton1Click:Connect(function()
                        active = not active
                        Render()
                        if callback then callback(active) end
                    end)

                    return {
                        Frame = Toggle,
                        SetValue = function(_, v)
                            active = v == true
                            Render()
                        end,
                        GetValue = function()
                            return active
                        end
                    }
                end

                function Section:CreateSlider(titleText, min, max, default, callback)
                    min = tonumber(min) or 0
                    max = tonumber(max) or 100

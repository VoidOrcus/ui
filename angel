                    local T = Text(Slider, titleText or "Slider", 12, Theme.PureWhite, Enum.Font.GothamBold)
                    T.Size = UDim2.new(1, -72, 0, 22)
                    T.Position = UDim2.new(0, 14, 0, 12)
                    T.ZIndex = 24

                    local V = Text(Slider, tostring(value), 11, Theme.PureWhite, Enum.Font.GothamBlack, Enum.TextXAlignment.Right)
                    V.Size = UDim2.new(0, 54, 0, 22)
                    V.Position = UDim2.new(1, -66, 0, 12)
                    V.ZIndex = 24

                    local Bar = New("TextButton", {
                        BackgroundColor3 = Theme.PureWhite,
                        BackgroundTransparency = 0.89,
                        BorderSizePixel = 0,
                        Text = "",
                        AutoButtonColor = false,
                        Size = UDim2.new(1, -28, 0, 10),
                        Position = UDim2.new(0, 14, 0, 51),
                        ZIndex = 24,
                    }, Slider)
                    Corner(Bar, 5)

                    local Fill = New("Frame", {
                        BackgroundColor3 = Theme.PureWhite,
                        BackgroundTransparency = 0.18,
                        BorderSizePixel = 0,
                        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                        ZIndex = 25,
                    }, Bar)
                    Corner(Fill, 5)

                    local dragging = false

                    local function SetFromX(x)
                        local a = math.clamp((x - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                        value = math.floor((min + (max - min) * a) + 0.5)
                        Fill.Size = UDim2.new(a, 0, 1, 0)
                        V.Text = tostring(value)
                        if callback then callback(value) end
                    end

                    Bar.MouseButton1Down:Connect(function()
                        dragging = true
                        SetFromX(UserInputService:GetMouseLocation().X)
                    end)

                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                    end)

                    UserInputService.InputChanged:Connect(function(input)
                        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                            SetFromX(input.Position.X)
                        end
                    end)

                    return {
                        Frame = Slider,
                        SetValue = function(_, v)
                            value = math.clamp(tonumber(v) or min, min, max)
                            local a = (value - min) / (max - min)
                            Fill.Size = UDim2.new(a, 0, 1, 0)
                            V.Text = tostring(value)
                        end,
                        GetValue = function()
                            return value
                        end
                    }
                end

                return Section
            end

            table.insert(Page.SubPages, SubPage)
            table.insert(Window.SubPages, SubPage)

            if Window.CurrentPage == Page then
                SelectPage(Page)
            end

            return SubPage
        end

        table.insert(Window.Pages, Page)

        if #Window.Pages == 1 then
            local default = Page:CreateSubPage("Overview")
            default:CreateHero(
                "Welcome back, " .. tostring(options.Username or (LocalPlayer and LocalPlayer.Name or "Username")) .. ".",
                "Here's what is happening with your Angelws hub today.",
                "✦"
            )

            local sys = default:CreateSection("System Overview", "♱")
            sys:CreateStatCard("Status", "Ready", "(icone)")
            sys:CreateStatCard("Uptime", "00h 00m", "(icone)")
            sys:CreateStatCard("Users Online", "1,428", "(icone)")
            sys:CreateStatCard("Build", "v2.0.0", "(icone)")

            local quick = default:CreateSection("Quick Actions", "✦")
            quick:CreateButton("Load Config", "Import settings", "(icone)")
            quick:CreateButton("Save Config", "Export settings", "(icone)")
            quick:CreateButton("Join Discord", "Community", "(icone)")
            quick:CreateButton("Support", "Get help", "(icone)")

            task.defer(function()
                SelectPage(Page)
            end)
        end

        return Page
    end

    if options.DefaultPages ~= false then
        local Combat = Window:CreatePage("Combat", "Aim & Fight", "(icone)")
        local CombatMain = Combat:CreateSubPage("Main")
        CombatMain:CreateHero("Combat", "Subpage example with premium glass cards.", "(icone)")
        local CSection = CombatMain:CreateSection("Combat Section", "(icone)")
        CSection:CreateToggle("Example Toggle", "Interface placeholder", false)
        CSection:CreateSlider("Example Slider", 0, 100, 35)
        CSection:CreateButton("Example Button", "Action placeholder", "(icone)")

        local Movement = Window:CreatePage("Movement", "Move & Teleport", "(icone)")
        local MoveMain = Movement:CreateSubPage("Main")
        MoveMain:CreateHero("Movement", "Clean controls with black and white glass style.", "(icone)")
        local MSection = MoveMain:CreateSection("Movement Section", "(icone)")
        MSection:CreateToggle("Speed Boost", "Layout placeholder", false)
        MSection:CreateToggle("Fly", "Layout placeholder", false)
        MSection:CreateSlider("Speed", 1, 100, 25)

        local Visuals = Window:CreatePage("Visuals", "ESP & World", "(icone)")
        local VisualMain = Visuals:CreateSubPage("Main")
        VisualMain:CreateHero("Visuals", "Glassmorphism components for future features.", "(icone)")
        local VSection = VisualMain:CreateSection("Visual Section", "(icone)")
        VSection:CreateToggle("Enable Visual", "Layout placeholder", false)
        VSection:CreateButton("Refresh", "Visual refresh placeholder", "(icone)")

        local Settings = Window:CreatePage("Settings", "Configuration", "(icone)")
        local SetMain = Settings:CreateSubPage("Interface")
        SetMain:CreateHero("Settings", "Customize the future interface here.", "(icone)")
        local SSection = SetMain:CreateSection("Interface Section", "(icone)")
        SSection:CreateButton("Destroy UI", "Close interface", "(icone)", function()
            Window:Destroy()
        end)
    end

    return Window
end

return Angelws

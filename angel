local function AddHover(button, baseTrans, hoverTrans)
    baseTrans = baseTrans or button.BackgroundTransparency
    hoverTrans = hoverTrans or math.max(0, baseTrans - 0.08)
    button.MouseEnter:Connect(function()
        Tween(button, {BackgroundTransparency = hoverTrans}, 0.14)
    end)
    button.MouseLeave:Connect(function()
        Tween(button, {BackgroundTransparency = baseTrans}, 0.14)
    end)
end

local function ToScale(frame, baseWidth, baseHeight, minScale, maxScale)
    local cam = workspace.CurrentCamera
    local vp = (cam and cam.ViewportSize) or Vector2.new(1366, 768)

    local marginX = 34
    local marginY = 34
    local sx = (vp.X - marginX) / baseWidth
    local sy = (vp.Y - marginY) / baseHeight
    local scale = math.min(sx, sy)

    scale = math.clamp(scale, minScale or 0.58, maxScale or 1.0)

    frame.Size = UDim2.fromOffset(math.floor(baseWidth * scale), math.floor(baseHeight * scale))
    frame.Position = UDim2.new(0.5, -math.floor(baseWidth * scale / 2), 0.5, -math.floor(baseHeight * scale / 2))

    return scale
end

local function GetPingMs()
    local ping = nil

    pcall(function()
        local item = Stats.Network.ServerStatsItem["Data Ping"]
        local str = item:GetValueString()
        ping = tonumber(str:match("[%d%.]+"))
    end)

    if not ping then
        pcall(function()
            local item = Stats.PerformanceStats.Ping
            local str = item:GetValueString()
            ping = tonumber(str:match("[%d%.]+"))
        end)
    end

    return ping or 0
end

local function GetMemoryMb()

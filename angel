--// Helpers
local function ParentGui()
    return (gethui and gethui()) or CoreGui
end

local function New(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    if parent then
        obj.Parent = parent
    end
    return obj
end

local function Tween(obj, props, time)
    local tw = TweenService:Create(
        obj,
        TweenInfo.new(time or 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        props
    )
    tw:Play()
    return tw
end

local function Corner(obj, radius)
    return New("UICorner", {
        CornerRadius = UDim.new(0, radius or 12)
    }, obj)
end

local function Stroke(obj, transparency, thickness)
    return New("UIStroke", {
        Color = Theme.White,
        Transparency = transparency or 0.62,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, obj)
end

local function Gradient(obj, rotation, t0, t1)
    return New("UIGradient", {
        Rotation = rotation or 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.White),
            ColorSequenceKeypoint.new(1, Theme.Black),
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, t0 or 0.84),
            NumberSequenceKeypoint.new(0.5, 0.985),
            NumberSequenceKeypoint.new(1, t1 or 0.94),
        }),
    }, obj)
end

local function Pad(obj, l, r, t, b)
    return New("UIPadding", {
        PaddingLeft = UDim.new(0, l or 0),
        PaddingRight = UDim.new(0, r or l or 0),
        PaddingTop = UDim.new(0, t or l or 0),
        PaddingBottom = UDim.new(0, b or t or l or 0),
    }, obj)
end

local function List(obj, gap, direction)
    return New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = direction or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, gap or 8),
    }, obj)
end

local function Text(parent, str, size, color, font, xAlign)
    return New("TextLabel", {
        BackgroundTransparency = 1,
        Text = str or "",
        TextColor3 = color or Theme.SoftWhite,
        Font = font or Enum.Font.GothamMedium,
        TextSize = size or 13,
        TextXAlignment = xAlign or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextWrapped = false,
        RichText = true,
        ZIndex = (parent and parent.ZIndex or 1) + 10,
    }, parent)
end

local function SetTextScale(root, scale)
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local base = obj:GetAttribute("BaseTextSize")
            if not base then
                base = obj.TextSize
                obj:SetAttribute("BaseTextSize", base)
            end
            obj.TextSize = math.max(8, math.floor(base * scale + 0.5))
        end
    end
end

local function IsMobile()
    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1366, 768)
    return UIS.TouchEnabled and (vp.X <= 1000 or vp.Y <= 650)
end


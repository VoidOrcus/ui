local function MakeToggle(parent, title, desc, default, callback)
    local active = default == true

    local frame = MakeGlass(parent, {
        Size = UDim2.new(1, 0, 0, 66),
        Radius = 16,
        Transparency = 0.94,
        StrokeTransparency = 0.56,
        ZIndex = (parent and parent.ZIndex or 1) + 20,
        BgTransparency = 0.60,
        DarkTransparency = 0.40,
        WhiteTransparency = 0.915,
    })

    local t = Text(frame, title or "Toggle", 13, Theme.White, Enum.Font.GothamBold)
    t.Size = UDim2.new(1, -95, 0, 24)
    t.Position = UDim2.new(0, 16, 0, 12)

    local d = Text(frame, desc or "", 11, Theme.Muted, Enum.Font.GothamMedium)
    d.Size = UDim2.new(1, -95, 0, 20)
    d.Position = UDim2.new(0, 16, 0, 36)

    local sw = New("TextButton", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = active and 0.70 or 0.90,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(0, 54, 0, 28),
        Position = UDim2.new(1, -72, 0.5, -14),
        ZIndex = frame.ZIndex + 25,
    }, frame)
    Corner(sw, 14)
    Stroke(sw, 0.58, 1)

    local knob = New("Frame", {
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 20, 0, 20),
        Position = active and UDim2.new(1, -24, 0.5, -10) or UDim2.new(0, 4, 0.5, -10),
        ZIndex = sw.ZIndex + 1,
    }, sw)
    Corner(knob, 10)

    local function render()
        Tween(sw, { BackgroundTransparency = active and 0.70 or 0.90 }, 0.15)
        Tween(knob, {
            Position = active and UDim2.new(1, -24, 0.5, -10) or UDim2.new(0, 4, 0.5, -10)
        }, 0.15)
    end

    sw.MouseButton1Click:Connect(function()
        active = not active
        render()
        if callback then callback(active) end
    end)

    return {
        SetValue = function(_, v)
            active = v == true
            render()
        end,
        GetValue = function()
            return active
        end,
        Frame = frame,
    }
end

local function MakeSlider(parent, title, min, max, default, callback)
    min = tonumber(min) or 0
    max = tonumber(max) or 100
    local value = math.clamp(tonumber(default) or min, min, max)

    local frame = MakeGlass(parent, {
        Size = UDim2.new(1, 0, 0, 76),
        Radius = 16,
        Transparency = 0.94,
        StrokeTransparency = 0.56,
        ZIndex = (parent and parent.ZIndex or 1) + 20,
        BgTransparency = 0.60,
        DarkTransparency = 0.40,
        WhiteTransparency = 0.915,
    })

    local t = Text(frame, title or "Slider", 13, Theme.White, Enum.Font.GothamBold)
    t.Size = UDim2.new(1, -90, 0, 24)
    t.Position = UDim2.new(0, 16, 0, 12)

    local v = Text(frame, tostring(value), 12, Theme.White, Enum.Font.GothamBlack, Enum.TextXAlignment.Right)
    v.Size = UDim2.new(0, 70, 0, 24)
    v.Position = UDim2.new(1, -86, 0, 12)

    local bar = New("TextButton", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = 0.90,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, -32, 0, 10),
        Position = UDim2.new(0, 16, 0, 50),
        ZIndex = frame.ZIndex + 25,
    }, frame)
    Corner(bar, 5)

    local fill = New("Frame", {
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = 0.18,
        BorderSizePixel = 0,
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        ZIndex = bar.ZIndex + 1,
    }, bar)
    Corner(fill, 5)

    local dragging = false

    local function setFromX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = math.floor((min + (max - min) * a) + 0.5)
        fill.Size = UDim2.new(a, 0, 1, 0)
        v.Text = tostring(value)
        if callback then callback(value) end
    end

    bar.MouseButton1Down:Connect(function()
        dragging = true
        setFromX(UIS:GetMouseLocation().X)
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            setFromX(input.Position.X)
        end
    end)

    return {
        SetValue = function(_, val)
            value = math.clamp(tonumber(val) or min, min, max)
            local a = (value - min) / (max - min)
            fill.Size = UDim2.new(a, 0, 1, 0)
            v.Text = tostring(value)
        end,
        GetValue = function()
            return value
        end,
        Frame = frame,
    }
end


local function MakeGlass(parent, props)
    props = props or {}

    local frame = New("Frame", {
        Name = props.Name or "Glass",
        BackgroundColor3 = Theme.White,
        BackgroundTransparency = props.Transparency or 0.94,
        BorderSizePixel = 0,
        Size = props.Size or UDim2.fromOffset(100, 100),
        Position = props.Position or UDim2.fromOffset(0, 0),
        ZIndex = props.ZIndex or 1,
        ClipsDescendants = true,
        LayoutOrder = props.LayoutOrder or 0,
        AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
    }, parent)

    Corner(frame, props.Radius or 18)
    Stroke(frame, props.StrokeTransparency or 0.52, props.StrokeThickness or 1)

    AddGlassLayers(frame, {
        BackgroundImage = props.BackgroundImage,
        BgTransparency = props.BgTransparency,
        Bg2Transparency = props.Bg2Transparency,
        DarkTransparency = props.DarkTransparency,
        WhiteTransparency = props.WhiteTransparency,
        HighlightTransparency = props.HighlightTransparency,
        DiagonalTransparency = props.DiagonalTransparency,
        InnerGlowTransparency = props.InnerGlowTransparency,
        WhiteRotation = props.WhiteRotation,
        OffsetRotation = props.OffsetRotation,
    })

    return frame
end


    Pages.Name = "Pages"
    Pages.BackgroundTransparency = 1
    Pages.Size = UDim2.new(1, -20, 1, -20)
    Pages.Position = UDim2.new(0, 10, 0, 10)
    Pages.Parent = Content

    -- Drag
    do
        local dragging = false
        local dragStart, startPos

        TopBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = Main.Position
            end
        end)

        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    local minimized = false

    Close.MouseButton1Click:Connect(function()
        tween(Main, {Size = UDim2.new(0, 760, 0, 0), BackgroundTransparency = 1}, 0.25)
        task.delay(0.26, function()
            if ScreenGui then ScreenGui:Destroy() end
        end)
    end)

    Minimize.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            tween(Main, {Size = UDim2.new(0, 760, 0, 74)}, 0.25)
            Body.Visible = false
        else
            Body.Visible = true
            tween(Main, {Size = options.Size or UDim2.new(0, 760, 0, 500)}, 0.25)
        end
    end)

    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        local key = options.ToggleKey or Enum.KeyCode.RightShift
        if input.KeyCode == key then
            Main.Visible = not Main.Visible
        end
    end)

    function window:IsPremiumActive()
        return self.IsPremium == true
    end

    function window:SetPremiumStatus(infoOrBool)
        if type(infoOrBool) == "table" then
            self.KeyInfo = infoOrBool
            self.IsPremium = isPremiumFromInfo(infoOrBool)
        else
            self.IsPremium = infoOrBool == true
        end
        KeyText.Text = self.IsPremium and "✦ PREMIUM" or "FREE KEY"
        self:RefreshPremiumLocks()
        return self
    end

    function window:RefreshPremiumLocks()
        for _, control in ipairs(self.Controls) do
            if control.RefreshLock then
                pcall(control.RefreshLock)
            end
        end
    end

    function window:Notify(title, message)
        notify(title, message)
    end

    function window:SelectTab(tab)
        for _, t in ipairs(self.Tabs) do
            local active = t == tab
            t.Page.Visible = active
            tween(t.Button, {BackgroundTransparency = active and 0.84 or 0.95}, 0.16)
            t.Button.TextLabel.TextColor3 = active and Color3.fromRGB(255,255,255) or Color3.fromRGB(165,165,170)
            t.Button.IconLabel.TextColor3 = active and Color3.fromRGB(255,255,255) or Color3.fromRGB(150,150,155)
        end
    end

    local function createLockOverlay(frame, control, message)
        local overlay = Instance.new("TextButton")
        overlay.Name = "PremiumLock"
        overlay.BackgroundColor3 = Color3.fromRGB(0,0,0)
        overlay.BackgroundTransparency = 0.28
        overlay.BorderSizePixel = 0
        overlay.Text = ""
        overlay.Size = UDim2.fromScale(1,1)
        overlay.Visible = false
        overlay.ZIndex = 90
        overlay.AutoButtonColor = false
        overlay.Parent = frame
        corner(overlay, 16)

        local icon = makeText(overlay, "✦", 22, Color3.fromRGB(255,255,255), Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
        icon.Size = UDim2.new(0, 40, 0, 24)
        icon.Position = UDim2.new(0.5, -20, 0.5, -22)
        icon.ZIndex = 91

        local label = makeText(overlay, message or "Premium Only", 11, Color3.fromRGB(255,255,255), Enum.Font.GothamBold, Enum.TextXAlignment.Center)
        label.Size = UDim2.new(1, -20, 0, 20)
        label.Position = UDim2.new(0, 10, 0.5, 4)
        label.ZIndex = 91

        overlay.MouseButton1Click:Connect(function()
            notify("Premium Only", message or "This feature requires Premium.")
            tween(overlay, {BackgroundTransparency = 0.18}, 0.08)
            task.delay(0.12, function()
                if overlay and overlay.Parent then
                    tween(overlay, {BackgroundTransparency = 0.28}, 0.12)
                end
            end)
        end)

        control.RefreshLock = function()
            local locked = control.PremiumOnly == true and not window:IsPremiumActive()
            control.Locked = locked
            overlay.Visible = locked
            return locked
        end

        control.RefreshLock()
        return overlay
    end


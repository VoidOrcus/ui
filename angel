local zZzUILibrary = {}
zZzUILibrary.Version = "AngelcoreGlass-BW-1.0.0"

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")

local function getParent()
    return (gethui and gethui()) or CoreGui
end

local function tween(obj, props, time, style, direction)
    local tw = TweenService:Create(
        obj,
        TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
        props
    )
    tw:Play()
    return tw
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 12)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(255, 255, 255)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.75
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function gradient(parent, c1, c2, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, c1),
        ColorSequenceKeypoint.new(1, c2),
    })
    g.Rotation = rot or 90
    g.Parent = parent
    return g
end

local function padding(parent, all)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, all or 8)
    p.PaddingBottom = UDim.new(0, all or 8)
    p.PaddingLeft = UDim.new(0, all or 8)
    p.PaddingRight = UDim.new(0, all or 8)
    p.Parent = parent
    return p
end

local function list(parent, gap, direction)
    local l = Instance.new("UIListLayout")
    l.FillDirection = direction or Enum.FillDirection.Vertical
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Padding = UDim.new(0, gap or 8)
    l.Parent = parent
    return l
end

local function makeText(parent, text, size, color, font, xAlign)
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Text = text or ""
    t.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    t.Font = font or Enum.Font.GothamMedium
    t.TextSize = size or 13
    t.TextXAlignment = xAlign or Enum.TextXAlignment.Left
    t.TextYAlignment = Enum.TextYAlignment.Center
    t.TextWrapped = false
    t.TextTruncate = Enum.TextTruncate.AtEnd
    t.Parent = parent
    return t
end

local function makeButton(parent, text)
    local b = Instance.new("TextButton")
    b.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    b.BackgroundTransparency = 0.93
    b.BorderSizePixel = 0
    b.Text = text or ""
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.AutoButtonColor = false
    b.Parent = parent
    corner(b, 12)
    stroke(b, Color3.fromRGB(255, 255, 255), 1, 0.84)
    return b
end

local function bool(v)
    if v == true then return true end
    if type(v) == "string" then
        local s = v:lower()
        return s == "true" or s == "yes" or s == "premium" or s == "1"
    end
    if type(v) == "number" then return v == 1 end
    return false
end

local function isPremiumFromInfo(info)
    if type(info) ~= "table" then return false end
    local raw = type(info.Raw) == "table" and info.Raw or info

    local function get(...)
        for _, k in ipairs({...}) do
            if raw[k] ~= nil then return raw[k] end
            if info[k] ~= nil then return info[k] end
        end
        return nil
    end

    if bool(get("IsPremium", "isPremium", "is_premium", "premium", "Premium", "lifetime", "permanent")) then
        return true
    end

    local blob = table.concat({
        tostring(get("Type", "type") or ""),
        tostring(get("Plan", "plan") or ""),
        tostring(get("Tier", "tier") or ""),
        tostring(get("license_type", "licenseType") or ""),
        tostring(get("subscription", "Subscription") or ""),
    }, " "):lower()

    if blob:find("premium", 1, true) or blob:find("lifetime", 1, true) or blob:find("permanent", 1, true) then
        return true
    end

    return false
end

local function notify(title, message)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title or "zZz HUB",
            Text = message or "",
            Duration = 4
        })
    end)
end


    local function IsKeyExpiredForKill(info)
        info = NormalizeKeyInfoForUI(info) or info
        if type(info) ~= "table" then return false end

        local raw = info.Raw or info
        if raw.valid == false or raw.Valid == false then
            return true
        end
        if raw.expired == true or tostring(raw.status or ""):lower() == "expired" then
            return true
        end

        local premium = info.IsPremium == true
        local expire = tonumber(info.ExpireTime) or 0

        -- Premium/lifetime normalmente vem ExpireTime=0 ou muito distante.
        if premium and (expire == 0 or expire > os.time() + 315360000) then
            return false
        end

        return expire > 0 and expire <= os.time()
    end


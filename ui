    -- Persistência real por Universe/GameId:
    -- Universal_save/<game.GameId>/<config>.txt
    local SaveFS = {}
    SaveFS.Root = "Universal_save"
    SaveFS.UniverseId = tostring((game.GameId and game.GameId ~= 0 and game.GameId) or game.PlaceId or "Universal")
    SaveFS.Folder = SaveFS.Root .. "/" .. SaveFS.UniverseId

    function SaveFS:Available()
        return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function" and type(isfolder) == "function" and type(makefolder) == "function"
    end

    function SaveFS:Ensure()
        if not self:Available() then return false end
        pcall(function()
            if not isfolder(self.Root) then makefolder(self.Root) end
            if not isfolder(self.Folder) then makefolder(self.Folder) end
        end)
        return isfolder(self.Folder)
    end

    function SaveFS:SafeName(name)
        name = tostring(name or "Config"):gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" then name = "Config" end
        return name:gsub("[\\/:*?\"<>|]", "_")
    end

    function SaveFS:Path(name)
        return self.Folder .. "/" .. self:SafeName(name) .. ".txt"
    end

    function SaveFS:ManifestPath()
        return self.Folder .. "/__manifest.txt"
    end

    function SaveFS:ReadManifest()
        if not self:Ensure() then return {} end
        local path = self:ManifestPath()
        if not isfile(path) then return {} end
        local ok, raw = pcall(readfile, path)
        if not ok or type(raw) ~= "string" then return {} end
        local data = self:Decode(raw)
        return type(data) == "table" and data or {}
    end

    function SaveFS:WriteManifest(list)
        if not self:Ensure() then return false end
        local raw = self:Encode(list or {})
        if not raw then return false end
        return pcall(function()
            writefile(self:ManifestPath(), raw)
        end)
    end

    function SaveFS:AddManifest(name)
        local list = self:ReadManifest()
        local safeName = tostring(name or "")
        for _, existing in ipairs(list) do
            if tostring(existing) == safeName then
                return self:WriteManifest(list)
            end
        end
        table.insert(list, safeName)
        return self:WriteManifest(list)
    end

    function SaveFS:RemoveManifest(name)
        local list = self:ReadManifest()
        local safeName = tostring(name or "")
        for i = #list, 1, -1 do
            if tostring(list[i]) == safeName then
                table.remove(list, i)
            end
        end
        return self:WriteManifest(list)
    end

    function SaveFS:Encode(data)
        local ok, encoded = pcall(function()
            return game:GetService("HttpService"):JSONEncode(data)
        end)
        return ok and encoded or nil
    end

    function SaveFS:Decode(raw)
        local ok, decoded = pcall(function()
            return game:GetService("HttpService"):JSONDecode(raw)
        end)
        return ok and decoded or nil
    end

    function SaveFS:Write(name, data)
        if not self:Ensure() then return false end
        data.name = name
        data.universeId = self.UniverseId
        data.placeId = tostring(game.PlaceId or "")
        local raw = self:Encode(data)
        if not raw then return false end
        local ok = pcall(function()
            writefile(self:Path(name), raw)
        end)
        if ok then self:AddManifest(name) end
        return ok
    end

    function SaveFS:Read(name)
        if not self:Ensure() then return nil end
        local path = self:Path(name)
        if not isfile(path) then return nil end
        local ok, raw = pcall(readfile, path)
        if not ok or type(raw) ~= "string" then return nil end
        return self:Decode(raw)
    end

    function SaveFS:Delete(name)
        if not self:Ensure() then return false end
        self:RemoveManifest(name)
        local path = self:Path(name)
        if type(delfile) == "function" and isfile(path) then return pcall(delfile, path) end
        return false
    end

    function SaveFS:LoadAll()
        if not self:Ensure() then return end
        for _, saveName in ipairs(self:ReadManifest()) do
            local data = self:Read(saveName)
            if type(data) == "table" then
                Saves[tostring(data.name or saveName)] = data
            end
        end
        if type(listfiles) ~= "function" then return end
        local ok, files = pcall(listfiles, self.Folder)
        if not ok or type(files) ~= "table" then return end
        for _, path in ipairs(files) do
            local fileNameOnly = type(path) == "string" and (path:match("([^/\\]+)$") or path) or ""
            if type(path) == "string" and path:sub(-4):lower() == ".txt" and fileNameOnly ~= "__manifest.txt" then
                local okRead, raw = pcall(readfile, path)
                if okRead and type(raw) == "string" then
                    local data = self:Decode(raw)
                    if type(data) == "table" then
                        local fileName = path:match("([^/\\]+)%.txt$") or "Config"
                        Saves[tostring(data.name or fileName)] = data
                    end
                end
            end
        end
    end


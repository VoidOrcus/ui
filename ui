    local KeyTimerLabelRef = nil

    local function ResolveKeyCode(value, fallback)
        fallback = fallback or Enum.KeyCode.J
        if typeof(value) == "EnumItem" then
            return value
        elseif type(value) == "string" and Enum.KeyCode[value] then
            return Enum.KeyCode[value]
        end
        return fallback
    end

    local HideGuiKey = ResolveKeyCode(options.HideKey or options.HideGuiKey or options.DefaultHideKey or "J", Enum.KeyCode.J)

    local function SetHideGuiKey(value)
        HideGuiKey = ResolveKeyCode(value, HideGuiKey)
        if HideKeyButtonRef then
            HideKeyButtonRef.Text = "[" .. HideGuiKey.Name .. "]"
        end
    end

    local function FormatSeconds(total)
        total = math.max(0, math.floor(tonumber(total) or 0))
        local d = math.floor(total / 86400)
        local h = math.floor((total % 86400) / 3600)
        local m = math.floor((total % 3600) / 60)
        local sec = total % 60
        if d > 0 then
            return string.format("%dd %02d:%02d:%02d", d, h, m, sec)
        end
        return string.format("%02d:%02d:%02d", h, m, sec)
    end

    local function TrimString(s)
        return tostring(s or ""):gsub("^%s*(.-)%s*$", "%1")
    end

    local function ParseJunkieDateForUI(val)
        if type(val) == "number" then
            return val
        end

        if type(val) == "string" then
            val = TrimString(val)
            if val == "" then
                return 0
            end

            -- ISO: 2026-05-13T15:30:00 / 2026-05-13 15:30:00 / com .000Z
            local y, mo, d, h, mi, sec = val:match("(%d+)%-(%d+)%-(%d+)[T%s](%d+):(%d+):(%d+)")
            if y and mo and d and h and mi and sec then
                local targetTime = os.time({
                    year = tonumber(y),
                    month = tonumber(mo),
                    day = tonumber(d),
                    hour = tonumber(h),
                    min = tonumber(mi),
                    sec = tonumber(sec),
                })

                -- Converte data UTC/Z para horário local quando vier do Junkie/API.
                if val:find("Z") or val:find("%+00:?00") then
                    local now = os.time()
                    local utcNow = os.time(os.date("!*t", now))
                    local offset = os.difftime(now, utcNow)
                    targetTime = targetTime + offset
                end

                return targetTime
            end

            -- Date only: 2026-05-13
            local yy, mm, dd = val:match("^(%d+)%-(%d+)%-(%d+)$")
            if yy and mm and dd then
                return os.time({
                    year = tonumber(yy),
                    month = tonumber(mm),
                    day = tonumber(dd),
                    hour = 23,
                    min = 59,
                    sec = 59,
                })
            end

            return tonumber(val) or 0
        end

        return 0
    end

    local function NormalizeKeyInfoForUI(info)
        if type(info) ~= "table" then return nil end

        local keyType = info.Type or info.type or info.Plan or info.plan or info.tier or info.Tier
        local expireRaw =
            info.ExpireTime or info.expireTime or
            info.ExpiresAt or info.expiresAt or
            info.expires_at or info.expires or
            info.Expiry or info.expiry or
            info.expiration or info.expiration_date or
            info.valid_until or info.validUntil or
            info.endDate or info.end_date

        local expireTime = ParseJunkieDateForUI(expireRaw)

        local timeLeftRaw = info.TimeLeft or info.timeLeft or info.Time or info.time or info.remaining or info.Remaining
        local timeLeftSeconds = tonumber(info.TimeLeftSeconds or info.timeLeftSeconds or info.secondsLeft or info.remainingSeconds)

        local premium =
            info.IsPremium == true or info.isPremium == true or info.is_premium == true or
            info.premium == true or info.Premium == true or
            tostring(keyType or ""):lower():find("premium") ~= nil or
            tostring(info.license_type or ""):lower():find("premium") ~= nil or
            tostring(info.plan or info.Plan or info.tier or info.Tier or ""):lower():find("premium") ~= nil

        -- Alguns retornos da API vêm com lifetime/permanent em texto.
        local expireText = tostring(expireRaw or ""):lower()
        if expireText:find("life") or expireText:find("perm") or expireText:find("infinite") then
            premium = true
            expireTime = 0
        end

        if not keyType then
            keyType = premium and "Premium" or "Free"
        end

        return {
            Type = keyType,
            ExpireTime = expireTime,
            TimeLeft = timeLeftRaw,
            TimeLeftSeconds = timeLeftSeconds,
            IsPremium = premium,
            Raw = info,
        }
    end

    local function ReadJsonFileForKeyInfo(path)
        if type(readfile) ~= "function" or type(isfile) ~= "function" then return nil end
        if not isfile(path) then return nil end

        local ok, raw = pcall(readfile, path)
        if not ok or type(raw) ~= "string" or raw == "" then return nil end

        local okDecode, decoded = pcall(function()
            return HttpService:JSONDecode(raw)
        end)

        if okDecode and type(decoded) == "table" then
            return decoded
        end

        return nil
    end

    local function ReadKeyInfo()
        local g = getgenv and getgenv() or _G

        -- Prioridade: dados passados pelo script que validou a key.
        local explicit = options.KeyInfo or g.zZzKeyInfo or g.JunkieKeyInfo or g.KeyInfo
        local explicitInfo = NormalizeKeyInfoForUI(explicit)

        -- Lê arquivos gerados pelo key system.
        local expireTime = 0
        local isPremium = false
        local fileType = nil
        local savedKey = nil

        if type(readfile) == "function" and type(isfile) == "function" then
            -- Se existir um JSON com dados completos, ele vence.
            local jsonInfo =
                ReadJsonFileForKeyInfo("SentinelLibrary/Bin/ApexKeyInfo.json") or
                ReadJsonFileForKeyInfo("SentinelLibrary/Bin/KeyInfo.json") or
                ReadJsonFileForKeyInfo("zZzHub/KeyInfo.json") or
                ReadJsonFileForKeyInfo("KeyInfo.json")

            local normalizedJson = NormalizeKeyInfoForUI(jsonInfo)
            if normalizedJson and ((tonumber(normalizedJson.ExpireTime) or 0) > 0 or normalizedJson.IsPremium == true or normalizedJson.TimeLeft) then
                return normalizedJson
            end

            pcall(function()
                if isfile("Junkie_SavedKey.txt") then
                    savedKey = TrimString(readfile("Junkie_SavedKey.txt"))
                end
            end)

            pcall(function()
                if isfile("SentinelLibrary/Bin/ApexTime.cfg") then
                    local rawTime = TrimString(readfile("SentinelLibrary/Bin/ApexTime.cfg"))
                    expireTime = ParseJunkieDateForUI(rawTime)
                end
            end)

            pcall(function()
                if isfile("SentinelLibrary/Bin/ApexPremium.cfg") then
                    local rawPremium = string.lower(TrimString(readfile("SentinelLibrary/Bin/ApexPremium.cfg")))
                    isPremium = rawPremium:find("true") ~= nil or rawPremium:find("premium") ~= nil or rawPremium:find("life") ~= nil
                end
            end)

            pcall(function()
                if isfile("SentinelLibrary/Bin/ApexType.cfg") then
                    fileType = TrimString(readfile("SentinelLibrary/Bin/ApexType.cfg"))
                end
            end)
        end

        -- Se o script passou KeyInfo explicitamente, ele tem prioridade sobre arquivos locais antigos.
        -- IMPORTANTE:
        -- Usuários que antes usaram uma key Free podem ter ApexPremium.cfg antigo = false.
        -- Esse arquivo NÃO pode rebaixar uma key premium nova para Free.
        if explicitInfo then
            local explicitPremium = explicitInfo.IsPremium == true
                or (explicitInfo.Raw and (explicitInfo.Raw.IsPremium == true or explicitInfo.Raw.isPremium == true or explicitInfo.Raw.is_premium == true or explicitInfo.Raw.premium == true or explicitInfo.Raw.Premium == true))
                or tostring(explicitInfo.Type or ""):lower():find("premium") ~= nil
                or tostring(explicitInfo.Raw and (explicitInfo.Raw.license_type or explicitInfo.Raw.plan or explicitInfo.Raw.tier) or ""):lower():find("premium") ~= nil

            if (tonumber(expireTime) or 0) > 0 then
                -- Usa o tempo do arquivo somente se o KeyInfo não trouxe tempo melhor.
                if (tonumber(explicitInfo.ExpireTime) or 0) <= 0 then
                    explicitInfo.ExpireTime = expireTime
                end

                -- Nunca sobrescreve Premium=true por arquivo antigo false.
                explicitInfo.IsPremium = explicitPremium or isPremium
                explicitInfo.Type = explicitInfo.IsPremium and "Premium" or (fileType or explicitInfo.Type or "Free")
            else
                explicitInfo.IsPremium = explicitPremium or explicitInfo.IsPremium == true
                explicitInfo.Type = explicitInfo.IsPremium and "Premium" or (explicitInfo.Type or "Free")
            end

            explicitInfo.SavedKey = explicitInfo.SavedKey or savedKey

            return explicitInfo
        end

        -- FREE ACCESS FIX:
        -- expireTime == 0 means "unknown/no expiration file", NOT premium.
        -- Only mark Premium when the key info/file explicitly says premium/lifetime.
        if expireTime > (os.time() + 315360000) then
            isPremium = true
        end

        return {
            Type = fileType or (isPremium and "Premium" or "Free"),
            ExpireTime = expireTime,
            IsPremium = isPremium,
            SavedKey = savedKey,
        }
    end

    local LastKeyInfo = nil
    local RefreshPremiumLocks = function() end

    local function ApplyKeyInfo(info)
        info = NormalizeKeyInfoForUI(info) or ReadKeyInfo()
        if not info then return end

        LastKeyInfo = info

        local keyType = info.Type or "Unknown"
        local premium = info.IsPremium == true
        local expire = tonumber(info.ExpireTime) or 0
        local timeText = info.TimeLeft
        local timeLeftSeconds = tonumber(info.TimeLeftSeconds)

        if not timeText then
            if timeLeftSeconds then
                timeText = FormatSeconds(timeLeftSeconds)
            elseif premium and (expire == 0 or expire > os.time() + 315360000) then
                timeText = "Infinity"
            elseif expire > 0 then
                local left = expire - os.time()
                timeText = FormatSeconds(left)
            else
                -- Não mostra 00:00:00 quando a UI ainda não conseguiu ler a data.
                timeText = "Unknown"
            end
        end

        if KeyTypeLabelRef then
            KeyTypeLabelRef.Text = tostring(keyType or "Unknown")
        end

        if KeyTimerLabelRef then
            KeyTimerLabelRef.Text = tostring(timeText)
            local s = tostring(timeText)
            KeyTimerLabelRef.TextColor3 =
                (s == "00:00:00" or s == "Expired") and Color3.fromRGB(255, 80, 80)
                or (s == "Unknown" and C.TextSub)
                or C.Primary
        end
        pcall(RefreshPremiumLocks)
    end

    task.spawn(function()
        while ScreenGui and ScreenGui.Parent do
            task.wait(1)
            if KeyTimerLabelRef then
                -- Releitura contínua: corrige o caso em que a janela abriu antes
                -- do key system gravar ApexTime.cfg/ApexPremium.cfg.
                ApplyKeyInfo(ReadKeyInfo())
            end
        end
    end)


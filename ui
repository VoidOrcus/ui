                end)
                HueStrip.InputBegan:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                        hDrag2=true
                        currentH=math.clamp((i.Position.Y-HueStrip.AbsolutePosition.Y)/HueStrip.AbsoluteSize.Y,0,1)
                        UpdatePopupColor()
                    end
                end)
                UIS.InputEnded:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                        svDrag2=false; hDrag2=false
                    end
                end)
                UIS.InputChanged:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
                        if svDrag2 then
                            currentS=math.clamp((i.Position.X-SVBox.AbsolutePosition.X)/SVBox.AbsoluteSize.X,0,1)
                            currentV=1-math.clamp((i.Position.Y-SVBox.AbsolutePosition.Y)/SVBox.AbsoluteSize.Y,0,1)
                            UpdatePopupColor()
                        elseif hDrag2 then
                            currentH=math.clamp((i.Position.Y-HueStrip.AbsolutePosition.Y)/HueStrip.AbsoluteSize.Y,0,1)
                            UpdatePopupColor()
                        end
                    end
                end)
            end

            -- Apenas 4 cores nas linhas compactas (removidos Card, Dark, Header)
            -- Interface fixa: linhas de cor da UI removidas/desativadas.
            -- MakeCompactColorRow(SubCfgColors.Right, "Subtitle Text",  "TextSub")
            -- MakeCompactColorRow(SubCfgColors.Right, "Border / Lines", "Border")
            -- MakeCompactColorRow(SubCfgColors.Right, "Main BG",        "BgMain")
            -- MakeCompactColorRow(SubCfgColors.Right, "Header BG",      "Header")
        end
        return TabConfig
    end

    task.spawn(function()
        while ScreenGui and ScreenGui.Parent do
            ApplyKeyInfo()
            task.wait(1)
        end
    end)

    -- Global keybind listener da janela
    UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if KillSwitch.Active then return end
        if HideGuiKey and input.KeyCode == HideGuiKey then
            ToggleWindowByKey()
            return
        end
        for _, reg in ipairs(Registry.toggles) do
            if reg.keybind and input.KeyCode == reg.keybind then
                reg.toggle()
            end
        end
    end)

    -- Auto kill-check opcional.
    -- Padrão: ligado. Para desligar: CreateWindow({KillSwitch = false})
    if options.KillSwitch ~= false then
        task.spawn(function()
            local interval = tonumber(options.KillCheckInterval) or 15
            local lastValidator = 0

            while ScreenGui and ScreenGui.Parent and not KillSwitch.Active do
                task.wait(math.max(1, interval))

                local g = getgenv and getgenv() or _G
                if g.zZz_ForceKill == true or g.zZz_KillSwitch == true then
                    RunKillSwitch("Forced kill switch")
                    break
                end

                local info = ReadKeyInfo()
                if IsKeyExpiredForKill(info) then
                    RunKillSwitch("Key expired or invalid")
                    break
                end

                local validator = options.KeyValidator or options.ValidateKey or g.zZzKeyValidator
                if type(validator) == "function" and os.clock() - lastValidator >= interval then
                    lastValidator = os.clock()
                    local ok, result, validatorReason = pcall(validator, info)
                    if (not ok) or result == false then
                        RunKillSwitch(validatorReason or "Key validator rejected the session")
                        break
                    end
                end
            end
        end)
    end

    if options.DefaultConfigTab == true then
        Window:CreateCategory(options.ConfigCategory or "SETTINGS")
        Window:CreateDefaultConfigTab(options.ConfigTabOptions or {})
    end

    return Window
end

return zZzUILibrary

function zZzUILibrary:CreateWindow(options)
    options = options or {}
    -- ==============================================================================
    -- 🌟 zZz HUB - PREMIUM UI LIBRARY (V18)
    -- ==============================================================================
    local CoreGui    = game:GetService("CoreGui")
    local TweenServ  = game:GetService("TweenService")
    local UIS        = game:GetService("UserInputService")
    local HttpService = game:GetService("HttpService")

    local GUI_NAME = options.GuiName or "zZz_PremiumUI"
    if CoreGui:FindFirstChild(GUI_NAME) then
        CoreGui[GUI_NAME]:Destroy()
    end

    local Icons = nil -- predeclared for premium lock overlay

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name   = GUI_NAME
    ScreenGui.ResetOnSpawn = false
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = gethui and gethui() or CoreGui

    -- ═══════════════════════════════════════════════════════
    -- 🖥️ LARGE MONITOR / HIGH DPI FIX
    -- Em monitores 2K/4K/50", a janela antiga ficava larga demais e
    -- o texto continuava 8-12px, dando aparência borrada/ilegível.
    -- Aqui limitamos a janela e aplicamos boost leve de texto sem UIScale.
    -- ═══════════════════════════════════════════════════════
    local InitialViewport = (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize) or Vector2.new(1920, 1080)
    local IsLargeMonitor = InitialViewport.X >= 2560 or InitialViewport.Y >= 1440

    local TEXT_BOOST = tonumber(options.TextBoost)
    if TEXT_BOOST == nil then
        TEXT_BOOST = IsLargeMonitor and 3 or 0
    end

    local TITLE_TEXT_BOOST = tonumber(options.TitleTextBoost)
    if TITLE_TEXT_BOOST == nil then
        TITLE_TEXT_BOOST = IsLargeMonitor and 4 or TEXT_BOOST
    end

    local CRISP_STROKE = options.CrispTextStroke
    if CRISP_STROKE == nil then
        CRISP_STROKE = IsLargeMonitor
    end

    local function RoundPixel(n)
        return math.floor((tonumber(n) or 0) + 0.5)
    end

    -- Bubble/layout compacto apenas para CELULAR/TABLET real.
    -- IMPORTANTE:
    -- BlueStacks/emulador pode aparecer como TouchEnabled e até sem MouseEnabled,
    -- então NÃO basta verificar touch. Para ser considerado mobile real, exigimos
    -- também sensor de dispositivo físico: Gyroscope ou Accelerometer.
    local function GetViewportSize()
        return (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize) or InitialViewport or Vector2.new(1920, 1080)
    end

    local function DetectRealMobile()
        local lastInput = UIS:GetLastInputType()

        local usingMouseOrKeyboard =
            UIS.MouseEnabled
            or UIS.KeyboardEnabled
            or lastInput == Enum.UserInputType.MouseMovement
            or lastInput == Enum.UserInputType.MouseButton1
            or lastInput == Enum.UserInputType.MouseButton2
            or lastInput == Enum.UserInputType.Keyboard

        local hasPhysicalMobileSensor =
            UIS.AccelerometerEnabled == true
            or UIS.GyroscopeEnabled == true

        -- ForceMobile só para teste manual em celular.
        if options.ForceMobile == true then
            return true
        end

        -- Emulador/PC intocados por padrão.
        if options.ForceDesktop == true or options.EmulatorAsPC == true then
            return false
        end

        -- Regra principal:
        -- Touch + sensor físico + sem mouse/teclado = mobile real.
        -- BlueStacks normalmente falha no sensor físico e vira layout PC.
        return UIS.TouchEnabled and hasPhysicalMobileSensor and not usingMouseOrKeyboard
    end

    local IS_REAL_MOBILE = DetectRealMobile()
    local IS_EMULATOR_OR_PC = not IS_REAL_MOBILE

    local SHOW_MOBILE_BUBBLE = options.MobileBubble
    if SHOW_MOBILE_BUBBLE == nil then
        SHOW_MOBILE_BUBBLE = IS_REAL_MOBILE
    end

    -- ═══════════════════════════════════════════════════════
    -- 🎨 PALETA + SISTEMA DE ATUALIZAÇÃO AO VIVO
    -- ═══════════════════════════════════════════════════════
    local C = {
        Primary = Color3.fromRGB(162,  89, 255),
        Accent  = Color3.fromRGB(207, 115, 255),
        Header  = Color3.fromRGB( 10,   6,  15),
        BgMain  = Color3.fromRGB( 15,  10,  25),
        Card    = Color3.fromRGB( 25,  20,  35),
        Dark    = Color3.fromRGB( 20,  15,  30),
        Border  = Color3.fromRGB( 60,  35,  90),
        Text    = Color3.fromRGB(255, 255, 255),
        TextSub = Color3.fromRGB(160, 150, 190),
    }
    -- Cores fixas da interface: options.Colors é ignorado de propósito.
    local PaletteRefs = {}
    for k in pairs(C) do PaletteRefs[k] = {} end

    local function RefColor(key, obj, prop)
        if PaletteRefs[key] then
            table.insert(PaletteRefs[key], {obj, prop})
        end
    end

    local function SetPaletteColor(key, newColor)
        C[key] = newColor
        for _, r in ipairs(PaletteRefs[key] or {}) do
            pcall(function() r[1][r[2]] = newColor end)
        end
    end

    local function ColorToHex(c)
        return string.format("%02X%02X%02X",
            math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
    end
    local function HexToColor(hex)
        hex = hex:gsub("#","")
        local r = tonumber(hex:sub(1,2),16) or 0
        local g = tonumber(hex:sub(3,4),16) or 0
        local b = tonumber(hex:sub(5,6),16) or 0
        return Color3.fromRGB(r,g,b)
    end

    -- ═══════════════════════════════════════════════════════
    -- 🔤 FONTS: troca ao vivo em Config > Colors > Fonts
    -- ═══════════════════════════════════════════════════════
    local function SafeFont(enumName, fallback)
        local ok, font = pcall(function()
            return Enum.Font[enumName]
        end)
        return (ok and font) or fallback or Enum.Font.Gotham
    end

    local FontOptions = {
        {Name = "Gotham",      Font = SafeFont("Gotham")},
        {Name = "GothamBold",  Font = SafeFont("GothamBold")},
        {Name = "Montserrat",  Font = SafeFont("Montserrat", Enum.Font.Gotham)},
        {Name = "Ubuntu",      Font = SafeFont("Ubuntu", Enum.Font.Gotham)},
        {Name = "Roboto",      Font = SafeFont("Roboto", Enum.Font.Gotham)},
        {Name = "SourceSans",  Font = SafeFont("SourceSans", Enum.Font.Gotham)},
        {Name = "Arcade",      Font = SafeFont("Arcade", Enum.Font.Gotham)},
        {Name = "SciFi",       Font = SafeFont("SciFi", Enum.Font.Gotham)},
    }

    local FontMap = {}
    for _, data in ipairs(FontOptions) do
        FontMap[data.Name:lower()] = data.Font
    end

    local SelectedFontName = "Gotham"
    local UI_FONT = Enum.Font.Gotham
    local FontButtonRefs = {}

    local function ResolveFont(font)
        if typeof(font) == "EnumItem" then
            for _, data in ipairs(FontOptions) do
                if data.Font == font then
                    return data.Font, data.Name
                end
            end
            return font, tostring(font):gsub("Enum.Font.", "")
        elseif type(font) == "string" then
            local resolved = FontMap[font:lower()]
            if resolved then
                for _, data in ipairs(FontOptions) do
                    if data.Font == resolved then
                        return resolved, data.Name
                    end
                end
            end
        end
        return Enum.Font.Gotham, "Gotham"
    end

    local function ApplyFontToObject(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            obj.Font = UI_FONT

            -- Não usamos UIScale para aumentar a interface, porque UIScale pode
            -- deixar texto/imagem interpolado e borrado. Aumentamos TextSize real.
            if TEXT_BOOST and TEXT_BOOST > 0 then
                local base = obj:GetAttribute("_zZzBaseTextSize")
                if not base then
                    base = obj.TextSize
                    obj:SetAttribute("_zZzBaseTextSize", base)
                end

                local isBigTitle = base >= 18
                local boost = isBigTitle and TITLE_TEXT_BOOST or TEXT_BOOST
                obj.TextSize = RoundPixel(base + boost)
            end

            if CRISP_STROKE and obj:IsA("TextLabel") then
                -- Stroke quase invisível: melhora leitura em 4K/TV sem parecer contorno.
                if obj.TextStrokeTransparency >= 0.98 then
                    obj.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    obj.TextStrokeTransparency = 0.88
                end
            end
        end
    end

    local IsRefreshingFontButtons = false

    local function RefreshFontButtons()
        if IsRefreshingFontButtons then return end
        IsRefreshingFontButtons = true

        for _, ref in ipairs(FontButtonRefs) do
            local active = ref.Name == SelectedFontName

            if ref.Button then
                pcall(function()
                    ref.Button.BackgroundColor3 = active and C.Primary or C.Card
                    ref.Button.TextColor3 = active and C.Text or C.TextSub
                end)
            end

            if ref.Stroke then
                pcall(function()
                    ref.Stroke.Color = active and C.Primary or C.Border
                    ref.Stroke.Transparency = active and 0.2 or 0.45
                end)
            end

            -- IMPORTANT:
            -- Sync do dropdown de fonte precisa ser SILENCIOSO.
            -- Sem isso: RefreshFontButtons -> Dropdown:SetValue -> callback -> SetUIFont -> RefreshFontButtons...
            -- Resultado: loop infinito, stack trace gigante e crash no load.
            if ref.DropdownSync then
                pcall(function()
                    if ref.DropdownSync.setValue then
                        ref.DropdownSync.setValue(SelectedFontName, true)
                    elseif ref.DropdownSync.SetValue then
                        ref.DropdownSync:SetValue(SelectedFontName, true)
                    end
                end)
            end
        end

        IsRefreshingFontButtons = false
    end

    local function SetUIFont(font)
        local resolved, niceName = ResolveFont(font)
        UI_FONT = resolved
        SelectedFontName = niceName

        for _, obj in ipairs(ScreenGui:GetDescendants()) do
            pcall(function()
                ApplyFontToObject(obj)
            end)
        end

        RefreshFontButtons()
    end

    ScreenGui.DescendantAdded:Connect(function(obj)
        task.defer(function()
            if obj and obj.Parent then
                ApplyFontToObject(obj)
            end
        end)
    end)

    SetUIFont(options.Font or options.DefaultFont or "Gotham")


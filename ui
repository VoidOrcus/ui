    local function SerializeValue(value, depth)
        depth = depth or 0
        local t = typeof(value)
        if value == nil then
            return nil
        elseif t == "boolean" or t == "string" then
            return value
        elseif t == "number" then
            if value == value and value ~= math.huge and value ~= -math.huge then
                return value
            end
            return nil
        elseif t == "Color3" then
            return {__zType = "Color3", hex = ColorToHex(value)}
        elseif t == "Vector2" then
            return {__zType = "Vector2", x = value.X, y = value.Y}
        elseif t == "Vector3" then
            return {__zType = "Vector3", x = value.X, y = value.Y, z = value.Z}
        elseif t == "EnumItem" then
            return {__zType = "EnumItem", enum = tostring(value.EnumType):gsub("Enum.", ""), name = value.Name}
        elseif type(value) == "table" and depth < 3 then
            local out = {}
            local count = 0
            for k, v in pairs(value) do
                local kt = type(k)
                if kt == "string" or kt == "number" then
                    local sv = SerializeValue(v, depth + 1)
                    if sv ~= nil then
                        out[tostring(k)] = sv
                        count = count + 1
                        if count >= 250 then break end
                    end
                end
            end
            return out
        end
        return nil
    end

    local function DeserializeValue(value)
        if type(value) ~= "table" then
            return value
        end
        if value.__zType == "Color3" then
            return HexToColor(value.hex or "FFFFFF")
        elseif value.__zType == "Vector2" then
            return Vector2.new(tonumber(value.x) or 0, tonumber(value.y) or 0)
        elseif value.__zType == "Vector3" then
            return Vector3.new(tonumber(value.x) or 0, tonumber(value.y) or 0, tonumber(value.z) or 0)
        elseif value.__zType == "EnumItem" and value.enum and value.name then
            local ok, enumValue = pcall(function()
                return Enum[value.enum][value.name]
            end)
            if ok then return enumValue end
            return nil
        end
        local out = {}
        for k, v in pairs(value) do
            if k ~= "__zType" then
                out[k] = DeserializeValue(v)
            end
        end
        return out
    end

    local function ControlSaveKey(entry)
        if not entry then return nil end
        local key = entry.SaveKey or entry.saveKey or entry.Flag or entry.flag or entry.Key or entry.key
        key = key or entry.title or entry.Name or entry.id
        return CleanKeyName(key, entry.id)
    end

    local function UpdateBoundFlag(entry, value)
        if type(BoundFlags) ~= "table" then return end
        local key = ControlSaveKey(entry)
        if key then
            BoundFlags[key] = value
        end
    end

    local function FireControlCallbacks(entry, value)
        if IsControlPremiumLocked(entry) then
            if entry.kind == "toggle" or entry.kind == "checkbox" then
                UpdateBoundFlag(entry, false)
            end
            if type(entry._refreshPremiumLock) == "function" then
                pcall(entry._refreshPremiumLock)
            end
            return
        end

        UpdateBoundFlag(entry, value)

        -- Após kill switch, nenhum callback de controle pode religar funções.
        if KillSwitch.Active then
            return
        end

        for _, fn in ipairs(entry.callbacks or {}) do
            if type(fn) == "function" then
                local ok, err = pcall(fn, value, entry)
                if not ok then
                    warn("[zZz UI] Control callback error:", tostring(err):sub(1, 500))
                end
            end
        end
    end

    local function ValuesEqual(a, b)
        local ta, tb = typeof(a), typeof(b)
        if ta ~= tb then
            if (ta == "number" or ta == "string") and (tb == "number" or tb == "string") then
                return tostring(a) == tostring(b)
            end
            return false
        end
        if ta == "Color3" then
            return ColorToHex(a) == ColorToHex(b)
        end
        return a == b
    end

    local function RunControlCallback(entry, rawValue)
        if type(entry) ~= "table" or rawValue == nil then return false end
        if KillSwitch.Active then return false end
        if IsControlPremiumLocked(entry) then return false end
        local value = DeserializeValue(rawValue)

        -- Evita reentrância se o callback do script tentar mexer no próprio controle.
        if entry.__runningLoadCallback then
            return false
        end

        entry.__runningLoadCallback = true
        UpdateBoundFlag(entry, value)

        local ok1, err1 = true, nil
        if type(entry._callback) == "function" then
            ok1, err1 = pcall(entry._callback, value, entry)
            if not ok1 then
                warn("[zZz UI] Load apply callback error:", tostring(entry.SaveKey or entry.title or entry.id), tostring(err1):sub(1, 500))
            end
        end

        -- OnChanged extras registrados pelo script também precisam receber o load.
        for _, fn in ipairs(entry.callbacks or {}) do
            if type(fn) == "function" then
                local ok2, err2 = pcall(fn, value, entry)
                if not ok2 then
                    warn("[zZz UI] Load OnChanged error:", tostring(entry.SaveKey or entry.title or entry.id), tostring(err2):sub(1, 500))
                end
            end
        end

        entry.__runningLoadCallback = false
        return ok1
    end

    local function ApplyValueToControl(entry, rawValue, loadOptions)
        if not entry or rawValue == nil then return false end
        if IsControlPremiumLocked(entry) then
            if entry.kind == "toggle" or entry.kind == "checkbox" then
                pcall(function()
                    if entry.setValue then entry.setValue(false, true)
                    elseif entry.setState then entry.setState(false, true) end
                end)
                UpdateBoundFlag(entry, false)
            end
            if type(entry._refreshPremiumLock) == "function" then
                pcall(entry._refreshPremiumLock)
            end
            return false
        end
        local value = DeserializeValue(rawValue)
        local silent = loadOptions and loadOptions.Silent == true
        local ok, err = pcall(function()
            if entry.setValue then
                entry.setValue(value, silent)
            elseif entry.setState then
                entry.setState(value, silent)
            end
            if silent then
                UpdateBoundFlag(entry, value)
            end
        end)
        if not ok then
            warn("[zZz UI] Load control error:", tostring(entry.SaveKey or entry.title or entry.id), tostring(err):sub(1, 500))
        end
        return ok
    end

    local function ApplySavedConfig(cfg, loadOptions)
        if type(cfg) ~= "table" then return false end
        if KillSwitch.Active then
            return false
        end

        -- IMPORTANTE:
        -- Por padrão o Load é SILENCIOSO. Ele apenas lê o .txt e aplica valores na UI/Flags.
        -- Se disparar callbacks de todos os toggles ao mesmo tempo, scripts pesados podem travar/crashar o jogo.
        loadOptions = loadOptions or {}
        if loadOptions.Silent == nil then
            loadOptions.Silent = true
        end
        -- ApplyCallbacks=true resolve o problema do toggle ficar visualmente ligado,
        -- mas a função do script não ativar. O load primeiro aplica a UI em modo silencioso
        -- e depois roda os callbacks em fila, com yield, apenas para valores que mudaram.
        if loadOptions.ApplyCallbacks == nil then
            loadOptions.ApplyCallbacks = true
        end
        if loadOptions.CallbackBatch == nil then
            loadOptions.CallbackBatch = 4
        end

        PendingLoadConfig = cfg
        IsApplyingConfig = true

        local applied = {}
        local callbackQueue = {}
        local applyCount = 0
        local function applyOnce(entry, saved)
            if type(entry) ~= "table" or not entry.id or saved == nil or applied[entry.id] then return end
            applied[entry.id] = true

            local beforeValue = nil
            pcall(function()
                local getter = entry.getValue or entry.getState
                if getter then beforeValue = getter() end
            end)

            -- Durante a leitura do .txt sempre atualiza visual/Flags silenciosamente.
            ApplyValueToControl(entry, saved, {Silent = true})

            local afterValue = DeserializeValue(saved)
            if loadOptions.ApplyCallbacks ~= false and not ValuesEqual(beforeValue, afterValue) then
                table.insert(callbackQueue, {entry = entry, value = saved})
            end

            applyCount = applyCount + 1
            -- Evita congelar quando uma config tem muitos controles.
            if applyCount % 20 == 0 then task.wait() end
        end

        -- Novo formato estável por Flag/Title.
        -- Registry.controls guarda o mesmo controle por id, Flag e título; por isso precisa applied[entry.id].
        if type(cfg.controls) == "table" then
            for _, entry in pairs(Registry.controls or {}) do
                if type(entry) == "table" and entry.id then
                    local key = ControlSaveKey(entry)
                    local saved = cfg.controls[key]
                    if saved == nil then saved = cfg.controls[entry.id] end
                    if saved == nil and entry.paletteKey then saved = cfg.controls[entry.paletteKey] end
                    applyOnce(entry, saved)
                end
            end

            -- Aplica colorpickers que não estejam em Registry.controls.
            for _, cp in ipairs(Registry.colorpickers or {}) do
                if type(cp) == "table" and cp.id and not applied[cp.id] then
                    local key = ControlSaveKey(cp) or cp.paletteKey or cp.id
                    local saved = cfg.controls[key]
                    if saved == nil and cp.paletteKey then saved = cfg.controls[cp.paletteKey] end
                    if saved == nil then saved = cfg.controls[cp.id] end
                    applyOnce(cp, saved)
                end
            end
        else
            -- Formato legado por tipo/id. Só roda quando não existe cfg.controls,
            -- senão o mesmo controle pode ser carregado 2-4 vezes.
            for _, t in ipairs(Registry.toggles or {}) do
                if cfg.toggles and cfg.toggles[t.id] ~= nil then applyOnce(t, cfg.toggles[t.id]) end
                if cfg.keybinds and cfg.keybinds[t.id] ~= nil and t.setKeybind then pcall(t.setKeybind, cfg.keybinds[t.id]) end
            end
            for _, s in ipairs(Registry.sliders or {}) do
                if cfg.sliders and cfg.sliders[s.id] ~= nil then applyOnce(s, cfg.sliders[s.id]) end
            end
            for _, d in ipairs(Registry.dropdowns or {}) do
                if cfg.dropdowns and cfg.dropdowns[d.id] ~= nil then applyOnce(d, cfg.dropdowns[d.id]) end
            end
        end

        -- Flags extras: só aplica valores simples/salvos. Não executa funções.
        if type(BoundFlags) == "table" and type(cfg.flags) == "table" then
            local n = 0
            for k, v in pairs(cfg.flags) do
                BoundFlags[k] = DeserializeValue(v)
                n = n + 1
                if n % 50 == 0 then task.wait() end
            end
        end

        if cfg.palette and loadOptions.ApplyPalette ~= false then
            for key, hexStr in pairs(cfg.palette) do
                local ok, col = pcall(HexToColor, tostring(hexStr))
                if ok and col then
                    SetPaletteColor(key, col)
                    for _, cp in ipairs(Registry.colorpickers or {}) do
                        if cp.paletteKey == key and cp.setColor then pcall(cp.setColor, col, true) end
                    end
                end
            end
        end
        if cfg.font and loadOptions.ApplyFont ~= false then SetUIFont(cfg.font) end
        if cfg.hideKey then SetHideGuiKey(cfg.hideKey) end

        -- Keybinds precisam carregar independente do formato controls.
        -- Antes eles só eram aplicados no formato legado, então configs novas
        -- não restauravam as teclas dos toggles.
        if type(cfg.keybinds) == "table" then
            local keybindSeen = {}
            for _, t in ipairs(Registry.toggles or {}) do
                if type(t) == "table" and t.id and not keybindSeen[t.id] and t.setKeybind then
                    keybindSeen[t.id] = true
                    local stableKey = ControlSaveKey(t)
                    local kb = cfg.keybinds[stableKey]
                    if kb == nil then kb = cfg.keybinds[t.id] end
                    if kb ~= nil then
                        pcall(t.setKeybind, kb)
                    end
                end
            end
        end

        -- Agora ativa/desativa as funções reais do script de forma segura.
        -- Exemplo: Fly Hack salvo true -> callback do toggle roda -> botões de fly aparecem.
        if loadOptions.ApplyCallbacks ~= false and #callbackQueue > 0 then
            local batch = tonumber(loadOptions.CallbackBatch) or 4
            for i, item in ipairs(callbackQueue) do
                RunControlCallback(item.entry, item.value)
                if i % batch == 0 then task.wait() end
            end
        end

        IsApplyingConfig = false
        return true
    end

    local function ApplyPendingToControl(entry)
        if not PendingLoadConfig or not entry then return end
        local cfg = PendingLoadConfig
        local key = ControlSaveKey(entry)
        local saved = nil
        if cfg.controls then saved = cfg.controls[key] or cfg.controls[entry.id] end
        if saved == nil and (entry.kind == "toggle" or entry.kind == "checkbox") then
            saved = cfg.toggles and cfg.toggles[entry.id]
        elseif saved == nil and entry.kind == "slider" then
            saved = cfg.sliders and cfg.sliders[entry.id]
        elseif saved == nil and entry.kind == "dropdown" then
            saved = cfg.dropdowns and cfg.dropdowns[entry.id]
        end
        if saved ~= nil then
            ApplyValueToControl(entry, saved, {Silent = true})
        elseif type(BoundFlags) == "table" and BoundFlags[key] ~= nil then
            ApplyValueToControl(entry, BoundFlags[key], {Silent = true})
        end

        if entry.setKeybind and cfg.keybinds then
            local kb = cfg.keybinds[key]
            if kb == nil then kb = cfg.keybinds[entry.id] end
            if kb ~= nil then
                pcall(entry.setKeybind, kb)
            end
        end
    end

    local function RegisterControl(kind, entry)
        entry.kind = kind
        entry.Type = kind
        entry.Name = entry.title
        entry.Id = entry.id
        entry.SaveKey = ControlSaveKey(entry)
        Registry.controls[entry.id] = entry
        Registry.controls[entry.SaveKey] = entry
        if entry.title then
            Registry.controls[tostring(entry.title)] = entry
        end

        if entry.Frame then
            AttachPremiumLock(entry, entry.Frame)
        end

        entry.SetPremiumOnly = function(selfOrValue, maybeValue)
            local v = (selfOrValue == entry) and maybeValue or selfOrValue
            entry.PremiumOnly = v == true
            entry.RequiresPremium = entry.PremiumOnly
            if entry.Frame then
                AttachPremiumLock(entry, entry.Frame)
            end
            RefreshPremiumLocks()
            return entry
        end
        entry.setPremiumOnly = entry.SetPremiumOnly

        entry.IsLocked = function()
            return IsControlPremiumLocked(entry)
        end
        entry.isLocked = entry.IsLocked

        entry.OnChanged = function(selfOrFn, maybeFn)
            local fn = selfOrFn == entry and maybeFn or selfOrFn
            if type(fn) ~= "function" then return nil end
            entry.callbacks = entry.callbacks or {}
            table.insert(entry.callbacks, fn)
            local connected = true
            return {
                Disconnect = function()
                    if not connected then return end
                    connected = false
                    for i = #entry.callbacks, 1, -1 do
                        if entry.callbacks[i] == fn then
                            table.remove(entry.callbacks, i)
                            break
                        end
                    end
                end
            }
        end
        entry.onChanged = entry.OnChanged

        local key = ControlSaveKey(entry)
        if type(BoundFlags) == "table" and BoundFlags[key] ~= nil then
            ApplyValueToControl(entry, BoundFlags[key], {Silent = true})
        end
        ApplyPendingToControl(entry)
        return entry
    end

    local function BindBooleanAPI(entry, getFn, setFn, toggleFn)
        entry.getState = getFn
        entry.GetState = getFn
        entry.getValue = getFn
        entry.GetValue = getFn
        entry.Get = getFn

        entry.setState = function(a, b, c)
            local value, silent = UnwrapControlCall(entry, a, b, c)
            setFn(value, silent)
            return entry
        end
        entry.SetState = entry.setState
        entry.setValue = entry.setState
        entry.SetValue = entry.setState
        entry.Set = entry.setState

        entry.toggle = function()
            toggleFn()
            return entry
        end
        entry.Toggle = entry.toggle
        return entry
    end

    local function BindValueAPI(entry, getFn, setFn)
        entry.getValue = getFn
        entry.GetValue = getFn
        entry.Get = getFn

        entry.setValue = function(a, b, c)
            local value, silent = UnwrapControlCall(entry, a, b, c)
            setFn(value, silent)
            return entry
        end
        entry.SetValue = entry.setValue
        entry.Set = entry.setValue
        return entry
    end

    local function BuildConfigSnapshot(name)
        local cfg = {
            version = zZzUILibrary.Version,
            name = name,
            controls = {},
            toggles = {},
            sliders = {},
            dropdowns = {},
            keybinds = {},
            flags = {},
            palette = {},
            font = SelectedFontName,
            hideKey = HideGuiKey.Name,
        }

        local seen = {}
        for _, entry in pairs(Registry.controls or {}) do
            if type(entry) == "table" and entry.id and not seen[entry.id] then
                seen[entry.id] = true
                local key = ControlSaveKey(entry)
                local getter = entry.getValue or entry.getState
                if key and getter then
                    local ok, value = pcall(getter)
                    if ok then
                        cfg.controls[key] = SerializeValue(value)
                    end
                end
            end
        end

        for _, t in ipairs(Registry.toggles or {}) do
            cfg.toggles[t.id] = SerializeValue(t.getState and t.getState() or nil)

            local kb = t.getKeybind and t.getKeybind() or nil
            cfg.keybinds[t.id] = kb

            -- Salva keybind também por chave estável/Flag/Título.
            -- Assim config continua funcionando mesmo se a ordem dos toggles mudar.
            local stableKey = ControlSaveKey(t)
            if stableKey then
                cfg.keybinds[stableKey] = kb
            end
        end
        for _, s in ipairs(Registry.sliders or {}) do
            cfg.sliders[s.id] = SerializeValue(s.getValue and s.getValue() or nil)
        end
        for _, d in ipairs(Registry.dropdowns or {}) do
            cfg.dropdowns[d.id] = SerializeValue(d.getValue and d.getValue() or nil)
        end


        -- Salva ColorPickers também em controls, por Flag/SaveKey/paletteKey.
        -- Assim cores customizadas do script aparecem no .txt e voltam no LoadConfig.
        for _, cp in ipairs(Registry.colorpickers or {}) do
            if type(cp) == "table" then
                local key = ControlSaveKey(cp) or cp.paletteKey or cp.id
                local getter = cp.getValue or cp.getColor
                local value = nil

                if getter then
                    local ok, got = pcall(getter)
                    if ok then value = got end
                elseif cp.paletteKey and C[cp.paletteKey] then
                    value = C[cp.paletteKey]
                end

                if key and value ~= nil then
                    cfg.controls[key] = SerializeValue(value)
                end
            end
        end
        -- Não salva a tabela Flags inteira por padrão.
        -- Scripts grandes podem colocar cache, objetos e tabelas enormes em Flags; isso gera JSON gigante e lag.
        -- Salvamos somente as flags ligadas aos controles registrados.
        if type(BoundFlags) == "table" then
            for key, value in pairs(cfg.controls) do
                cfg.flags[key] = value
            end

            -- Opcional: se quiser salvar outras flags simples manualmente:
            -- CreateWindow({Flags = Flags, SaveAllFlags = true})
            if options.SaveAllFlags == true then
                local extraCount = 0
                for k, v in pairs(BoundFlags) do
                    if type(k) == "string" or type(k) == "number" then
                        local tv = typeof(v)
                        if tv == "boolean" or tv == "number" or tv == "string" or tv == "Color3" then
                            local sv = SerializeValue(v)
                            if sv ~= nil then
                                cfg.flags[tostring(k)] = sv
                                extraCount = extraCount + 1
                                if extraCount >= 300 then break end
                            end
                        end
                    end
                end
            end
        end

        for key, col in pairs(C) do
            cfg.palette[key] = ColorToHex(col)
        end
        return cfg
    end

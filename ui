    local function SetDescendantsLockStyle(frame, locked)
        if not frame then return end
        for _, obj in ipairs(frame:GetDescendants()) do
            if obj.Name ~= "__zPremiumLockOverlay" and not obj:IsDescendantOf(frame:FindFirstChild("__zPremiumLockOverlay") or Instance.new("Folder")) then
                pcall(function()
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        if not obj:GetAttribute("_zOrigTextTrans") then
                            obj:SetAttribute("_zOrigTextTrans", obj.TextTransparency)
                        end
                        obj.TextTransparency = locked and math.max(obj:GetAttribute("_zOrigTextTrans") or 0, 0.28) or (obj:GetAttribute("_zOrigTextTrans") or 0)
                    elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                        if not obj:GetAttribute("_zOrigImageTrans") then
                            obj:SetAttribute("_zOrigImageTrans", obj.ImageTransparency)
                        end
                        obj.ImageTransparency = locked and math.max(obj:GetAttribute("_zOrigImageTrans") or 0, 0.35) or (obj:GetAttribute("_zOrigImageTrans") or 0)
                    end
                end)
            end
        end
    end


    local function ShouldRequirePremiumWindow()
        -- FREE ACCESS FIX:
        -- A normal/free key MUST be able to open the UI.
        -- PremiumOnly/RequiresPremium should lock individual controls only.
        -- Legacy flags like RequirePremiumKey=true are intentionally ignored here
        -- because they block the whole window before the locks can appear.
        return options.StrictPremiumWindow == true
            or options.StrictPremiumOnlyScript == true
            or options.ForcePremiumWindowGate == true
    end

    local function ReturnPremiumBlockedWindow()
        pcall(function()
            if ScreenGui then
                ScreenGui:Destroy()
            end
        end)

        pcall(function()
            local g = getgenv and getgenv() or _G
            g.zZz_PremiumRequiredBlocked = true
            g.zZz_PremiumRequiredReason = "Premium key required"
            g._zZz_PriorExt_Running = false
            g.zZz_UI_Window = nil
        end)

        if type(options.OnPremiumRequired) == "function" then
            pcall(options.OnPremiumRequired, LastKeyInfo or ReadKeyInfo())
        end

        return nil
    end

    if ShouldRequirePremiumWindow() and not IsPremiumKeyActive() then
        return ReturnPremiumBlockedWindow()
    end

    local function IsControlPremiumLocked(entry)
        return type(entry) == "table" and entry.PremiumOnly == true and not IsPremiumKeyActive()
    end


            stBtn.TextColor3 = C.TextSub
            stBtn.Font = Enum.Font.GothamSemibold
            stBtn.TextSize = 13
            stBtn.ZIndex = 5
            RefColor("TextSub", stBtn, "TextColor3")

            local stPad = Instance.new("UIPadding", stBtn)
            stPad.PaddingLeft = UDim.new(0, 12); stPad.PaddingRight = UDim.new(0, 12)

            local stLine = Instance.new("Frame", stBtn)
            stLine.Size = UDim2.new(1, 0, 0, 2)
            stLine.Position = UDim2.new(0, 0, 1, -2)
            stLine.BackgroundColor3 = C.Primary
            stLine.BorderSizePixel = 0
            stLine.BackgroundTransparency = 1
            stLine.ZIndex = 6
            Instance.new("UICorner", stLine).CornerRadius = UDim.new(0, 1)
            RefColor("Primary", stLine, "BackgroundColor3")

            local ContentArea = Instance.new("CanvasGroup", self.SubContainer)
            ContentArea.Size = UDim2.new(1, 0, 1, 0)
            ContentArea.Position = UDim2.new(0, 0, 0, 0)
            ContentArea.BackgroundTransparency = 1
            ContentArea.GroupTransparency = 0
            ContentArea.Visible = false

            -- Mobile fix:
            -- Antes o Contents usava altura fixa de 120px. Em celulares em landscape,
            -- o SubTabContainer fica baixo e o Contents roubava quase todo o espaço,
            -- deixando o conteúdo principal com 20-40px e parecendo vazio.
            local IS_COMPACT_PAGE = IS_REAL_MOBILE and (Viewport.Y <= 760)
            local CONTENT_GAP = IS_COMPACT_PAGE and 8 or 16
            local INFO_H = IS_COMPACT_PAGE and 82 or 120
            local MIN_MAIN_H = IS_COMPACT_PAGE and 118 or 60
            local MIN_INFO_H = IS_COMPACT_PAGE and 58 or 72
            local TOP_PAD = IS_COMPACT_PAGE and 3 or 5
            local BOTTOM_PAD = IS_COMPACT_PAGE and 5 or 8
            local InfoBox = nil

            local MainBox = Instance.new("Frame", ContentArea)
            MainBox.Size = UDim2.new(1, -40, 0, 60)
            MainBox.Position = UDim2.new(0, 20, 0, TOP_PAD)
            MainBox.BackgroundColor3 = C.Dark
            MainBox.BorderSizePixel = 0
            MainBox.ClipsDescendants = false
            Instance.new("UICorner", MainBox).CornerRadius = UDim.new(0, 10)
            RefColor("Dark", MainBox, "BackgroundColor3")
        
            local mbStroke = Instance.new("UIStroke", MainBox)
            mbStroke.Color = C.Border; mbStroke.Thickness = 1; mbStroke.Transparency = 0.4
            RefColor("Border", mbStroke, "Color")

            -- SCROLLING FRAME AQUI: O conteúdo rola por dentro da caixa escura
            local InnerClip = Instance.new("ScrollingFrame", MainBox)
            InnerClip.Size = UDim2.new(1, 0, 1, 0)
            InnerClip.BackgroundTransparency = 1
            InnerClip.BorderSizePixel = 0
            InnerClip.ScrollBarThickness = 2
            InnerClip.ScrollBarImageColor3 = C.Primary
            InnerClip.CanvasSize = UDim2.new(0, 0, 0, 0)
            RefColor("Primary", InnerClip, "ScrollBarImageColor3")

            local subObj = {
                Btn = stBtn,
                Line = stLine,
                Content = ContentArea,
                MainBox = MainBox,

                Left = nil,
                Right = nil,
                Center = nil,

                _leftItems = 0,
                _rightItems = 0,
                _centerItems = 0,

                _leftWeight = 0,
                _rightWeight = 0,

                _smartItems = {},
                InfoLayout = nil
            }
            table.insert(self.SubTabs, subObj)

            -- Coluna esquerda
            local LeftCol = Instance.new("Frame", InnerClip)
            LeftCol.Size = UDim2.new(0.5, -5, 0, 0)
            LeftCol.AutomaticSize = Enum.AutomaticSize.Y
            LeftCol.BackgroundTransparency = 1
        
            local L_Lay = Instance.new("UIListLayout", LeftCol)
            L_Lay.Padding = UDim.new(0, 8); L_Lay.SortOrder = Enum.SortOrder.LayoutOrder
            local L_Pad = Instance.new("UIPadding", LeftCol)
            L_Pad.PaddingTop=UDim.new(0,12); L_Pad.PaddingBottom=UDim.new(0,12)
            L_Pad.PaddingLeft=UDim.new(0,12); L_Pad.PaddingRight=UDim.new(0,5)

            -- Coluna direita
            local RightCol = Instance.new("Frame", InnerClip)
            RightCol.Size = UDim2.new(0.5, -5, 0, 0)
            RightCol.AutomaticSize = Enum.AutomaticSize.Y
            RightCol.Position = UDim2.new(0.5, 5, 0, 0)
            RightCol.BackgroundTransparency = 1
        
            local R_Lay = Instance.new("UIListLayout", RightCol)
            R_Lay.Padding = UDim.new(0, 8); R_Lay.SortOrder = Enum.SortOrder.LayoutOrder
            R_Lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
            local R_Pad = Instance.new("UIPadding", RightCol)
            R_Pad.PaddingTop=UDim.new(0,12); R_Pad.PaddingBottom=UDim.new(0,12)
            R_Pad.PaddingLeft=UDim.new(0,5); R_Pad.PaddingRight=UDim.new(0,12)

            -- Coluna central: usada quando sobra 1 elemento após duas colunas equilibradas
            local CenterCol = Instance.new("Frame", InnerClip)
            CenterCol.Size = UDim2.new(0.5, -5, 0, 0)
            CenterCol.Position = UDim2.new(0.25, 0, 0, 0)
            CenterCol.AutomaticSize = Enum.AutomaticSize.Y
            CenterCol.BackgroundTransparency = 1
            CenterCol.Visible = false

            local C_Lay = Instance.new("UIListLayout", CenterCol)
            C_Lay.Padding = UDim.new(0, 8)
            C_Lay.SortOrder = Enum.SortOrder.LayoutOrder
            C_Lay.HorizontalAlignment = Enum.HorizontalAlignment.Center

            local C_Pad = Instance.new("UIPadding", CenterCol)
            C_Pad.PaddingTop = UDim.new(0, 0)
            C_Pad.PaddingBottom = UDim.new(0, 12)
            C_Pad.PaddingLeft = UDim.new(0, 12)
            C_Pad.PaddingRight = UDim.new(0, 12)

            -- MÁGICA DO SCROLL: Mede qual coluna está maior e expande o Canvas!
            local function UpdateCanvas()
                local MIN_H = MIN_MAIN_H

                local lh = L_Lay.AbsoluteContentSize.Y + 24
                local rh = R_Lay.AbsoluteContentSize.Y + 24
                local columnsH = math.max(lh, rh)

                local centerH = 0
                if CenterCol.Visible then
                    CenterCol.Position = UDim2.new(0.25, 0, 0, columnsH + 8)
                    centerH = C_Lay.AbsoluteContentSize.Y + 12
                end

                local contentH = columnsH + centerH
                if CenterCol.Visible then
                    contentH = contentH + 8
                end

                local totalH = ContentArea.AbsoluteSize.Y
                if not totalH or totalH <= 0 then
                    totalH = MIN_H + INFO_H + CONTENT_GAP + TOP_PAD + BOTTOM_PAD
                end

                local currentInfoH = (showContents and InfoBox and InfoBox.Visible) and INFO_H or 0
                local currentGap = currentInfoH > 0 and CONTENT_GAP or 0

                -- Se a tela for baixa, reduz o Contents para preservar uma área principal utilizável.
                -- Isso corrige o bug do mobile onde só aparecia Contents e a caixa principal ficava vazia/espremida.
                if currentInfoH > 0 then
                    local availableWithFullInfo = totalH - currentInfoH - currentGap - TOP_PAD - BOTTOM_PAD
                    if availableWithFullInfo < MIN_MAIN_H then
                        local maxInfoThatFits = totalH - MIN_MAIN_H - currentGap - TOP_PAD - BOTTOM_PAD
                        currentInfoH = math.clamp(maxInfoThatFits, MIN_INFO_H, INFO_H)
                    end

                    if InfoBox then
                        InfoBox.Size = UDim2.new(1, -40, 0, currentInfoH)
                        InfoBox.Position = UDim2.new(0, 20, 1, -(currentInfoH + BOTTOM_PAD))
                    end
                end

                local availableH = totalH - currentInfoH - currentGap - TOP_PAD - BOTTOM_PAD

                -- Proteção para quando AbsoluteSize ainda está 0 durante carregamento/animação
                if not availableH or availableH <= 0 then
                    availableH = MIN_H
                end

                -- Em mobile, nunca deixa a área principal virar uma linha fina.
                if IS_COMPACT_PAGE and showContents then
                    availableH = math.max(availableH, math.min(MIN_MAIN_H, totalH - TOP_PAD - BOTTOM_PAD))
                end

                local minH = math.min(MIN_H, availableH)
                local finalH = math.clamp(math.max(contentH, minH), minH, availableH)

                MainBox.Size = UDim2.new(1, -40, 0, finalH)
                InnerClip.CanvasSize = UDim2.new(0, 0, 0, math.max(contentH, finalH))

                if contentH > finalH then
                    InnerClip.ScrollBarThickness = 2
                    InnerClip.ScrollingEnabled = true
                else
                    InnerClip.ScrollBarThickness = 0
                    InnerClip.ScrollingEnabled = false
                end
            end

            subObj._updateCanvas = UpdateCanvas

            L_Lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateCanvas)
            R_Lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateCanvas)
            C_Lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateCanvas)
            ContentArea:GetPropertyChangedSignal("AbsoluteSize"):Connect(UpdateCanvas)

            task.defer(function()
                task.wait()
                UpdateCanvas()
            end)

            subObj.Left  = LeftCol
            subObj.Right = RightCol
            subObj.Center = CenterCol

            local function RebalanceCols()
                local hasLeft  = subObj._leftItems  > 0
                local hasRight = subObj._rightItems > 0

                if hasLeft and hasRight then
                    LeftCol.Size      = UDim2.new(0.5, -5, 0, 0)
                    LeftCol.Position  = UDim2.new(0, 0, 0, 0)
                    RightCol.Size     = UDim2.new(0.5, -5, 0, 0)
                    RightCol.Position = UDim2.new(0.5, 5, 0, 0)
                    L_Lay.HorizontalAlignment = Enum.HorizontalAlignment.Left
                    R_Lay.HorizontalAlignment = Enum.HorizontalAlignment.Left
                elseif hasLeft then
                    -- ColorPicker sozinho não deve esticar até o conteúdo inteiro.
                    if subObj._onlyFixedHalfLeft then
                        -- ColorPicker/Color Fill sozinho fica com meia largura e centralizado.
                        LeftCol.Size      = UDim2.new(0.5, -5, 0, 0)
                        LeftCol.Position  = UDim2.new(0.25, 0, 0, 0)
                        L_Lay.HorizontalAlignment = Enum.HorizontalAlignment.Left
                    else
                        LeftCol.Size      = UDim2.new(1, 0, 0, 0)
                        LeftCol.Position  = UDim2.new(0, 0, 0, 0)
                        L_Lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
                    end
                    RightCol.Size     = UDim2.new(0, 0, 0, 0)
                elseif hasRight then
                    -- ColorPicker sozinho não deve esticar até o conteúdo inteiro.
                    if subObj._onlyFixedHalfRight then
                        -- ColorPicker/Color Fill sozinho fica com meia largura e centralizado.
                        RightCol.Size     = UDim2.new(0.5, -5, 0, 0)
                        RightCol.Position = UDim2.new(0.25, 0, 0, 0)
                        R_Lay.HorizontalAlignment = Enum.HorizontalAlignment.Left
                    else
                        RightCol.Size     = UDim2.new(1, 0, 0, 0)
                        RightCol.Position = UDim2.new(0, 0, 0, 0)
                        R_Lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
                    end
                    LeftCol.Size      = UDim2.new(0, 0, 0, 0)
                else
                    LeftCol.Size      = UDim2.new(0.5, -5, 0, 0)
                    LeftCol.Position  = UDim2.new(0, 0, 0, 0)
                    RightCol.Size     = UDim2.new(0.5, -5, 0, 0)
                    RightCol.Position = UDim2.new(0.5, 5, 0, 0)
                end
            end
            subObj._rebalance = RebalanceCols

            local function ResetSmartLayout()
                subObj._leftItems = 0
                subObj._rightItems = 0
                subObj._centerItems = 0
                subObj._leftWeight = 0
                subObj._rightWeight = 0
                subObj._onlyFixedHalfLeft = false
                subObj._onlyFixedHalfRight = false
                CenterCol.Visible = false
            end

            local function PutSmartItem(item, parent, layoutOrder)
                item.Frame.Parent = parent
                item.Frame.LayoutOrder = layoutOrder

                if parent == LeftCol then
                    subObj._leftItems = subObj._leftItems + 1
                    subObj._leftWeight = subObj._leftWeight + item.Weight
                    subObj._onlyFixedHalfLeft = (subObj._leftItems == 1 and item.FixedHalf == true)
                elseif parent == RightCol then
                    subObj._rightItems = subObj._rightItems + 1
                    subObj._rightWeight = subObj._rightWeight + item.Weight
                    subObj._onlyFixedHalfRight = (subObj._rightItems == 1 and item.FixedHalf == true)
                elseif parent == CenterCol then
                    subObj._centerItems = subObj._centerItems + 1
                    CenterCol.Visible = true
                end
            end

            function subObj:_applySmartLayout()
                ResetSmartLayout()

                local total = #self._smartItems
                if total <= 0 then
                    RebalanceCols()
                    UpdateCanvas()
                    return
                end

                local centerIndex = nil
                local lastItem = self._smartItems[total]

                -- Conta primeiro os itens fixos/preferidos.
                -- Isso deixa blocos grandes, como Statistics/Player Info, reservarem espaço antes
                -- dos toggles automáticos serem distribuídos. Exemplo:
                -- Player Info fixo na esquerda com peso 3 => até 3 toggles vão para a direita.
                local forcedLeftWeight = 0
                local forcedRightWeight = 0

                for _, item in ipairs(self._smartItems) do
                    if item.PreferredSide == "left" then
                        forcedLeftWeight = forcedLeftWeight + item.Weight
                    elseif item.PreferredSide == "right" then
                        forcedRightWeight = forcedRightWeight + item.Weight
                    end
                end

                -- Se o último item for normal e as colunas anteriores formarem um grid equilibrado,
                -- ele fica centralizado embaixo. Isso evita o visual de um item sobrando em uma coluna.
                if total >= 3 and lastItem and lastItem.PreferredSide ~= "left" and lastItem.PreferredSide ~= "right" and lastItem.Kind ~= "statistics" then
                    local testLeft = 0
                    local testRight = 0

                    -- Primeiro simula os itens fixos anteriores.
                    for i = 1, total - 1 do
                        local it = self._smartItems[i]
                        if it.PreferredSide == "left" then
                            testLeft = testLeft + it.Weight
                        elseif it.PreferredSide == "right" then
                            testRight = testRight + it.Weight
                        end
                    end

                    -- Depois distribui os automáticos usando os pesos fixos como base.
                    for i = 1, total - 1 do
                        local it = self._smartItems[i]
                        if it.PreferredSide ~= "left" and it.PreferredSide ~= "right" then
                            if testLeft <= testRight then
                                testLeft = testLeft + it.Weight
                            else
                                testRight = testRight + it.Weight
                            end
                        end
                    end

                    if math.abs(testLeft - testRight) <= 0.15 then
                        centerIndex = total
                    end
                end

                local virtualLeftWeight = forcedLeftWeight
                local virtualRightWeight = forcedRightWeight

                for i, item in ipairs(self._smartItems) do
                    if i == centerIndex then
                        PutSmartItem(item, CenterCol, i)
                    else
                        if item.PreferredSide == "left" then
                            PutSmartItem(item, LeftCol, i)
                        elseif item.PreferredSide == "right" then
                            PutSmartItem(item, RightCol, i)
                        else
                            if virtualLeftWeight <= virtualRightWeight then
                                PutSmartItem(item, LeftCol, i)
                                virtualLeftWeight = virtualLeftWeight + item.Weight
                            else
                                PutSmartItem(item, RightCol, i)
                                virtualRightWeight = virtualRightWeight + item.Weight
                            end
                        end
                    end
                end

                RebalanceCols()
                task.defer(UpdateCanvas)
            end

            function subObj:_registerSmartItem(frame, kind, weight, preferredSide)
                table.insert(self._smartItems, {
                    Frame = frame,
                    Kind = kind or "normal",
                    Weight = weight or 1,
                    PreferredSide = preferredSide,
                    FixedHalf = (kind == "colorpicker"),
                })

                self:_applySmartLayout()
            end

            -- Compatibilidade com códigos antigos: ainda permite pedir uma coluna diretamente,
            -- mas os componentes novos abaixo usam _registerSmartItem para reordenar tudo.
            function subObj:_useColumn(preferredSide, estimatedHeight)
                preferredSide = preferredSide or "auto"
                if preferredSide == "left" then
                    return self.Left, "left"
                elseif preferredSide == "right" then
                    return self.Right, "right"
                end
                return (self._leftWeight <= self._rightWeight) and self.Left or self.Right, "auto"
            end

            if showContents then
                -- Contents agora fica oculto até existir CreateInfoCard().
                 InfoBox = Instance.new("Frame", ContentArea)
                 InfoBox.Visible = false
                 InfoBox.Size = UDim2.new(1, -40, 0, INFO_H)
                 InfoBox.Position = UDim2.new(0, 20, 1, -(INFO_H + BOTTOM_PAD))
                 InfoBox.BackgroundColor3 = C.Dark
                 InfoBox.ClipsDescendants = true
                 InfoBox.BorderSizePixel = 0
                 Instance.new("UICorner", InfoBox).CornerRadius = UDim.new(0, 10)
                 RefColor("Dark", InfoBox, "BackgroundColor3")
            
                local ibS = Instance.new("UIStroke", InfoBox)
                ibS.Color = C.Border; ibS.Thickness = 1; ibS.Transparency = 0.4
                RefColor("Border", ibS, "Color")

                local InfoTitle = Instance.new("TextLabel", InfoBox)
                InfoTitle.Size = UDim2.new(1, -20, 0, 14)
                InfoTitle.Position = UDim2.new(0, 10, 0, 8)
                InfoTitle.BackgroundTransparency = 1
                InfoTitle.Text = "CONTENTS"
                InfoTitle.TextColor3 = C.Primary
                InfoTitle.Font = Enum.Font.GothamBlack
                InfoTitle.TextSize = 10
                InfoTitle.TextXAlignment = Enum.TextXAlignment.Left
                RefColor("Primary", InfoTitle, "TextColor3")

                local InfoCardsLayout = Instance.new("ScrollingFrame", InfoBox)
                InfoCardsLayout.Size = UDim2.new(1, -16, 1, IS_COMPACT_PAGE and -24 or -34)
                InfoCardsLayout.Position = UDim2.new(0, 8, 0, IS_COMPACT_PAGE and 22 or 30)
                InfoCardsLayout.BackgroundTransparency = 1
                InfoCardsLayout.BorderSizePixel = 0
                InfoCardsLayout.ScrollBarThickness = 0
                InfoCardsLayout.ScrollingDirection = Enum.ScrollingDirection.X
                InfoCardsLayout.AutomaticCanvasSize = Enum.AutomaticSize.X
                InfoCardsLayout.CanvasSize = UDim2.new(0, 0, 0, 0)
                local I_Lay = Instance.new("UIListLayout", InfoCardsLayout)
                I_Lay.FillDirection = Enum.FillDirection.Horizontal
                I_Lay.Padding = UDim.new(0, 8)
                I_Lay.HorizontalAlignment = Enum.HorizontalAlignment.Left
                I_Lay.VerticalAlignment = Enum.VerticalAlignment.Center
                local I_Pad = Instance.new("UIPadding", InfoCardsLayout)
                I_Pad.PaddingLeft = UDim.new(0, 2)
                I_Pad.PaddingRight = UDim.new(0, 2)

                -- Centraliza os CONTENTS quando tiver poucos cards.
                -- Ex.: 1 card fica no meio; 2 cards ficam divididos no centro;
                -- se passar da largura visível, volta para a esquerda e permite scroll horizontal normal.
                local function UpdateInfoCardsCentering()
                    local contentW = I_Lay.AbsoluteContentSize.X
                    local visibleW = InfoCardsLayout.AbsoluteSize.X
                    if visibleW <= 0 then return end

                    if contentW > 0 and contentW < visibleW then
                        local pad = math.floor((visibleW - contentW) / 2)
                        I_Lay.HorizontalAlignment = Enum.HorizontalAlignment.Left
                        I_Pad.PaddingLeft = UDim.new(0, math.max(2, pad))
                        I_Pad.PaddingRight = UDim.new(0, math.max(2, pad))
                        InfoCardsLayout.CanvasPosition = Vector2.new(0, 0)
                    else
                        I_Lay.HorizontalAlignment = Enum.HorizontalAlignment.Left
                        I_Pad.PaddingLeft = UDim.new(0, 2)
                        I_Pad.PaddingRight = UDim.new(0, 2)
                    end
                end

                I_Lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateInfoCardsCentering)
                InfoCardsLayout:GetPropertyChangedSignal("AbsoluteSize"):Connect(UpdateInfoCardsCentering)

                subObj.InfoLayout = InfoCardsLayout
                subObj._infoBox = InfoBox
                subObj._updateInfoCardsCentering = UpdateInfoCardsCentering
            end


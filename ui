    -- ═══════════════════════════════════════════════════════
    -- 🔑 CLEAR SAVED KEY FILES
    -- Quando a key expira/invalida, limpar os .txt/.cfg evita que o
    -- Re-execute leia a key antiga e seja kickado de novo pela Junkie.
    -- ═══════════════════════════════════════════════════════
    local function ClearSavedKeyFiles(reason)
        if options.ClearSavedKeyOnKill == false then
            return false
        end

        local clearedAny = false

        pcall(function()
            local g = getgenv and getgenv() or _G
            g.SCRIPT_KEY = nil
            g.zZzKeyInfo = nil
            g.JunkieKeyInfo = nil
            g.KeyInfo = nil
            g.CurrentKeyInfo = nil
            g.SCRIPT_KEY_INFO = nil
            g.zZz_LastInvalidKeyReason = tostring(reason or "")
        end)

        if type(isfile) ~= "function" then
            return clearedAny
        end

        local paths = {
            "Junkie_SavedKey.txt",
            "SentinelLibrary/Bin/ApexKey.txt",
            "SentinelLibrary/Bin/ApexKey.cfg",
            "SentinelLibrary/Bin/ApexSavedKey.txt",
            "SentinelLibrary/Bin/SavedKey.txt",
            "SentinelLibrary/Bin/Key.txt",
            "SentinelLibrary/Bin/Key.cfg",
            "SentinelLibrary/Bin/ApexTime.cfg",
            "SentinelLibrary/Bin/ApexPremium.cfg",
            "SentinelLibrary/Bin/ApexType.cfg",
            "SentinelLibrary/Bin/ApexKeyInfo.json",
            "SentinelLibrary/Bin/KeyInfo.json",
            "zZzHub/KeyInfo.json",
            "KeyInfo.json",
            "JunkieKeyInfo.json",
        }

        if type(options.KeyFiles) == "table" then
            for _, p in ipairs(options.KeyFiles) do
                table.insert(paths, tostring(p))
            end
        elseif type(options.KeyFile) == "string" then
            table.insert(paths, options.KeyFile)
        end

        local function wipe(path)
            local okExists, exists = pcall(isfile, path)
            if not okExists or not exists then
                return
            end

            local deleted = false
            if type(delfile) == "function" then
                local okDel = pcall(delfile, path)
                deleted = okDel == true
            end

            if not deleted and type(writefile) == "function" then
                pcall(writefile, path, "")
                deleted = true
            end

            if deleted then
                clearedAny = true
            end
        end

        for _, path in ipairs(paths) do
            wipe(path)
        end

        return clearedAny
    end

    local function UnwrapControlCall(entry, a, b, c)
        if a == entry then
            return b, c
        end
        return a, b
    end

    local function CleanKeyName(value, fallback)
        value = tostring(value or fallback or "")
        value = value:gsub("^%s+", ""):gsub("%s+$", "")
        if value == "" then
            value = tostring(fallback or "Control")
        end
        return value
    end

    local function GetOptionValue(opts, ...)
        if type(opts) ~= "table" then return nil end
        local keys = {...}
        for _, key in ipairs(keys) do
            if opts[key] ~= nil then
                return opts[key]
            end
        end
        return nil
    end

    local function NormalizeBooleanArgs(title, desc, default, cb)
        local opts = type(title) == "table" and title or nil
        if opts then
            local flag = GetOptionValue(opts, "Flag", "flag", "Key", "key", "Id", "id", "SaveKey", "saveKey")
            title = GetOptionValue(opts, "Title", "title", "Name", "name", "Text", "text", "Label", "label") or flag or "Toggle"
            desc = GetOptionValue(opts, "Description", "description", "Desc", "desc") or ""
            local def = GetOptionValue(opts, "Default", "default", "Value", "value", "State", "state", "Enabled", "enabled")
            if def ~= nil then default = def end
            cb = GetOptionValue(opts, "Callback", "callback", "OnChanged", "onChanged") or cb
            return title, desc, default, cb, opts, flag
        end
        return title, desc, default, cb, nil, nil
    end

    local function NormalizeSliderArgs(title, desc, minV, maxV, default, cb)
        local opts = type(title) == "table" and title or nil
        if opts then
            local flag = GetOptionValue(opts, "Flag", "flag", "Key", "key", "Id", "id", "SaveKey", "saveKey")
            title = GetOptionValue(opts, "Title", "title", "Name", "name", "Text", "text", "Label", "label") or flag or "Slider"
            desc = GetOptionValue(opts, "Description", "description", "Desc", "desc") or ""
            minV = GetOptionValue(opts, "Min", "min", "Minimum", "minimum") or minV or 0
            maxV = GetOptionValue(opts, "Max", "max", "Maximum", "maximum") or maxV or 100
            local def = GetOptionValue(opts, "Default", "default", "Value", "value")
            if def ~= nil then default = def end
            cb = GetOptionValue(opts, "Callback", "callback", "OnChanged", "onChanged") or cb
            return title, desc, minV, maxV, default, cb, opts, flag
        end
        return title, desc, minV, maxV, default, cb, nil, nil
    end

    local function NormalizeDropdownArgs(title, desc, list, default, cb)
        local opts = type(title) == "table" and title or nil
        if opts then
            local flag = GetOptionValue(opts, "Flag", "flag", "Key", "key", "Id", "id", "SaveKey", "saveKey")
            title = GetOptionValue(opts, "Title", "title", "Name", "name", "Text", "text", "Label", "label") or flag or "Dropdown"
            desc = GetOptionValue(opts, "Description", "description", "Desc", "desc") or ""
            list = GetOptionValue(opts, "Options", "options", "List", "list", "Values", "values", "Items", "items") or list or {}
            local def = GetOptionValue(opts, "Default", "default", "Value", "value", "Selected", "selected")
            if def ~= nil then default = def end
            cb = GetOptionValue(opts, "Callback", "callback", "OnChanged", "onChanged") or cb
            return title, desc, list, default, cb, opts, flag
        end
        return title, desc, list, default, cb, nil, nil
    end

    local function BoolOption(value)
        if value == true then return true end
        if type(value) == "string" then
            local s = value:lower()
            return s == "true" or s == "yes" or s == "premium" or s == "locked"
        end
        return false
    end

    local function ApplyPremiumOptions(entry, opts)
        opts = type(opts) == "table" and opts or {}

        local premiumOnly =
            GetOptionValue(opts,
                "PremiumOnly", "premiumOnly",
                "RequiresPremium", "requiresPremium",
                "Premium", "premium",
                "Locked", "locked",
                "Lock", "lock"
            )

        entry.PremiumOnly = BoolOption(premiumOnly)
        entry.RequiresPremium = entry.PremiumOnly

        entry.LockMessage = GetOptionValue(opts,
            "LockMessage", "lockMessage",
            "PremiumMessage", "premiumMessage",
            "LockedMessage", "lockedMessage"
        ) or "Premium Only"

        entry.LockIcon = GetOptionValue(opts, "LockIcon", "lockIcon") or (Icons and (Icons.Lock or Icons.lock))
        entry.LockDimTransparency = tonumber(GetOptionValue(opts, "LockDimTransparency", "lockDimTransparency")) or 0.18
        return entry
    end

    local function IsPremiumKeyActive()
        local info = LastKeyInfo or ReadKeyInfo()
        info = NormalizeKeyInfoForUI(info) or info

        if type(info) ~= "table" then
            return false
        end

        local raw = info.Raw or info
        local keyType = tostring(info.Type or raw.Type or raw.type or raw.plan or raw.Plan or raw.tier or raw.Tier or ""):lower()

        return info.IsPremium == true
            or info.isPremium == true
            or info.is_premium == true
            or info.Premium == true
            or info.premium == true
            or raw.IsPremium == true
            or raw.isPremium == true
            or raw.is_premium == true
            or raw.premium == true
            or raw.Premium == true
            or tostring(raw.license_type or ""):lower():find("premium") ~= nil
            or tostring(raw.plan or raw.Plan or raw.tier or raw.Tier or ""):lower():find("premium") ~= nil
            or keyType:find("premium") ~= nil
            or keyType:find("life") ~= nil
            or keyType:find("perm") ~= nil
    end


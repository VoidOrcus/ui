    ClearCommonRunLocks = function()
        pcall(function()
            local g = getgenv and getgenv() or _G

            -- Locks comuns usados pelo script principal/anti-duplicação.
            -- O usuário também pode passar options.RunLocks = {"MeuLock"}.
            local names = {
                "_zZz_PriorExt_Running",
                "_zZz_Running",
                "zZz_Running",
                "zZzHubRunning",
                "zZz_Hub_Running",
                "PE_Running",
            }

            if type(options.RunLocks) == "table" then
                for _, name in ipairs(options.RunLocks) do
                    table.insert(names, tostring(name))
                end
            elseif type(options.RunLock) == "string" then
                table.insert(names, options.RunLock)
            end

            for _, name in ipairs(names) do
                g[name] = nil
            end

            -- Libera nova execução após fechar/reexecutar.
            g.zZz_KillSwitchActive = nil
            g.zZz_KillSwitchReason = nil
            g.zZz_ForceKill = nil
            g.zZz_KillSwitch = nil

            -- Não deixe o loader reutilizar key vencida via getgenv().
            g.SCRIPT_KEY = nil
            g.zZzKeyInfo = nil
            g.JunkieKeyInfo = nil
            g.KeyInfo = nil
            g.CurrentKeyInfo = nil
            g.SCRIPT_KEY_INFO = nil
        end)
    end

    TryReExecute = function()
        if type(ClearCommonRunLocks) == "function" then
            ClearCommonRunLocks()
        end
        if type(ClearSavedKeyFiles) == "function" then
            ClearSavedKeyFiles("Re-execute after key ended")
        end

        local cb = options.OnReExecute or options.ReExecuteCallback
        if type(cb) == "function" then
            local ok, err = pcall(function()
                if ScreenGui and ScreenGui.Parent then
                    ScreenGui:Destroy()
                end
                cb()
            end)
            if not ok then warn("[zZz UI] ReExecute callback error:", tostring(err):sub(1, 500)) end
            return ok
        end

        local source = options.ReExecuteSource or options.LoaderSource or options.ScriptSource
        if type(source) == "string" and source ~= "" then
            local ok, err = pcall(function()
                if ScreenGui and ScreenGui.Parent then
                    ScreenGui:Destroy()
                end
                loadstring(source)()
            end)
            if not ok then warn("[zZz UI] ReExecute source error:", tostring(err):sub(1, 500)) end
            return ok
        end

        local url = options.ReExecuteUrl or options.ScriptUrl or options.LoaderUrl
        if type(url) == "string" and url:find("http") then
            local ok, err = pcall(function()
                if ScreenGui and ScreenGui.Parent then
                    ScreenGui:Destroy()
                end
                loadstring(game:HttpGet(url))()
            end)
            if not ok then warn("[zZz UI] ReExecute URL error:", tostring(err):sub(1, 500)) end
            return ok
        end

        return false
    end

    RunKillSwitch = function(reason, killOptions)
        if KillSwitch.Active then return false end
        killOptions = killOptions or {}

        KillSwitch.Active = true
        KillSwitch.Reason = tostring(reason or "Kill switch activated")
        KillSwitch.Time = os.time()

        pcall(function()
            local g = getgenv and getgenv() or _G
            g.zZz_KillSwitchActive = true
            g.zZz_KillSwitchReason = KillSwitch.Reason

            -- Permite reexecutar o loader/script sem precisar reentrar no jogo.
            ClearCommonRunLocks()
        end)

        -- Remove a key expirada/inválida salva antes de reexecutar.
        ClearSavedKeyFiles(KillSwitch.Reason)

        -- Desliga visualmente e chama callbacks de OFF para todos os toggles/checkboxes.
        -- Isso resolve funções normais. Para hooks/metamethods, o script deve registrar cleanup.
        local seen = {}
        local function offControl(entry)
            if type(entry) ~= "table" or not entry.id or seen[entry.id] then return end
            seen[entry.id] = true

            if entry.kind == "toggle" or entry.kind == "checkbox" or tostring(entry.Type or "") == "toggle" or tostring(entry.Type or "") == "checkbox" then
                pcall(function()
                    if entry.setValue then
                        entry.setValue(false, true)
                    elseif entry.setState then
                        entry.setState(false, true)
                    end
                end)

                -- Roda callback real com false uma única vez para desligar a feature.
                KillSwitch.Active = false
                pcall(function()
                    RunControlCallback(entry, false)
                end)
                KillSwitch.Active = true
            end
        end

        for _, entry in ipairs(Registry.toggles or {}) do offControl(entry) end
        for _, entry in pairs(Registry.controls or {}) do offControl(entry) end

        -- Cleanups específicos registrados pelo script: conexões, troves, restore de hook, etc.
        for i = #KillSwitch.Cleanups, 1, -1 do
            SafeCleanupObject(KillSwitch.Cleanups[i])
            KillSwitch.Cleanups[i] = nil
        end

        -- Bloqueia UI.
        Bubble.Visible = false
        if killOptions.DestroyUI == true or options.KillDestroyUI == true then
            if ScreenGui then
                ScreenGui:Destroy()
            end
        else
            CreateKillOverlay(KillSwitch.Reason)
            Main.Visible = true
            Glow.Visible = true
        end

        if options.KickOnKill == true then
            pcall(function()
                local plr = game:GetService("Players").LocalPlayer
                if plr then
                    plr:Kick(KillSwitch.Reason)
                end
            end)
        end

        return true
    end


    -- Por padrão usa quase a tela toda no mobile e uma área grande no PC.
    -- Você ainda pode sobrescrever com options.Scale / WidthScale / HeightScale.
    local function IsSmallViewport(vp)
        -- Apenas usado para margens/limites; o tamanho padrão fica em cerca de 60% da tela.
        return IS_REAL_MOBILE or vp.X <= 900 or vp.Y <= 540
    end

    -- Tamanho padrão corrigido: ~60% da largura e ~68% da altura.
    -- Pode sobrescrever no CreateWindow com Scale / WidthScale / HeightScale.
    local DEFAULT_SCALE_X = options.WidthScale or options.Scale or (IS_REAL_MOBILE and 0.96 or (IsLargeMonitor and 0.46 or 0.60))
    local DEFAULT_SCALE_Y = options.HeightScale or options.Scale or (IS_REAL_MOBILE and 0.94 or (IsLargeMonitor and 0.62 or 0.68))

    local MIN_CONTENT_W = options.MinContentWidth or (IS_REAL_MOBILE and 360 or 330)
    local MIN_CONTENT_H = options.MinContentHeight or (IS_REAL_MOBILE and 270 or 230)

    local MIN_WIN_W = options.MinWidth or (IS_REAL_MOBILE and 360 or 300)
    local MIN_WIN_H = options.MinHeight or (IS_REAL_MOBILE and 380 or 320)
    -- Em monitor muito grande, não deixe a janela virar uma faixa gigante.
    -- Isso mantém os cards compactos e o texto nítido/legível.
    local DEFAULT_MAX_W = IsLargeMonitor and 1280 or math.huge
    local DEFAULT_MAX_H = IsLargeMonitor and 780  or math.huge
    local MAX_WIN_W = options.MaxWidth or DEFAULT_MAX_W
    local MAX_WIN_H = options.MaxHeight or DEFAULT_MAX_H

    local WIN_W, WIN_H, SIDE_W
    local function CalculateResponsive(vp)
        local small = IsSmallViewport(vp)
        local safeW = math.max(280, vp.X - (small and 8 or 24))
        local safeH = math.max(240, vp.Y - (small and 8 or 24))

        local maxW = math.min(MAX_WIN_W, safeW)
        local maxH = math.min(MAX_WIN_H, safeH)
        local minW = math.min(MIN_WIN_W, maxW)
        local minH = math.min(MIN_WIN_H, maxH)

        local w = math.clamp(math.floor(vp.X * DEFAULT_SCALE_X), minW, maxW)
        local h = math.clamp(math.floor(vp.Y * DEFAULT_SCALE_Y), minH, maxH)

        -- Sidebar menor para não virar um bloco/separador grosso e não roubar conteúdo.
        local sideMin = small and 92 or 118
        local sideMax = small and 145 or 170
        local side = math.clamp(math.floor(w * (small and 0.24 or 0.20)), sideMin, sideMax)

        local desiredContentW = math.min(MIN_CONTENT_W, math.max(260, w - sideMin - 15))
        if (w - side - 15) < desiredContentW then
            side = math.max(sideMin, w - 15 - desiredContentW)
        end

        return math.floor(w), math.floor(h), math.floor(side)
    end


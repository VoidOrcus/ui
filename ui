                dLbl.BackgroundTransparency = 1; dLbl.Text = desc or ""
                dLbl.TextColor3 = C.TextSub; dLbl.Font = Enum.Font.Gotham
                dLbl.TextSize = 10
                dLbl.TextXAlignment = Enum.TextXAlignment.Left
                dLbl.TextYAlignment = Enum.TextYAlignment.Top
                dLbl.TextWrapped = true
                dLbl.TextTruncate = Enum.TextTruncate.None
                dLbl.ClipsDescendants = true
                RefColor("TextSub", dLbl, "TextColor3")

                local track = Instance.new("Frame", f)
                track.Size = UDim2.new(0, 36, 0, 18)
                track.Position = UDim2.new(1, -46, 0.5, -9)
                track.BackgroundColor3 = state and Color3.fromRGB(162, 89, 255) or Color3.fromRGB(50,40,60)
                track.BorderSizePixel = 0
                Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

                local knob = Instance.new("Frame", track)
                knob.Size = UDim2.new(0, 14, 0, 14)
                knob.Position = state and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)
                knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
                knob.BorderSizePixel = 0
                Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

                local kbBtn = Instance.new("TextButton", f)
                kbBtn.Size = UDim2.new(0, 50, 0, 18)
                kbBtn.Position = UDim2.new(1, -100, 0.5, -9)
                kbBtn.BackgroundColor3 = C.Dark
                kbBtn.Text = "[KEY]"
                kbBtn.TextColor3 = C.TextSub
                kbBtn.Font = Enum.Font.GothamMedium
                kbBtn.TextSize = 8
                kbBtn.BorderSizePixel = 0
                Instance.new("UICorner", kbBtn).CornerRadius = UDim.new(0, 4)
                local kbStroke = Instance.new("UIStroke", kbBtn)
                kbStroke.Color = C.Border; kbStroke.Transparency = 0.4
                RefColor("Dark", kbBtn, "BackgroundColor3")
                RefColor("TextSub", kbBtn, "TextColor3")
                RefColor("Border", kbStroke, "Color")

                local TOGGLE_ON_COLOR = Color3.fromRGB(162, 89, 255)

                local function ApplyState(v, animated, silent)
                    if IsControlPremiumLocked(regEntry) and v == true then
                        v = false
                        silent = true
                    end
                    state = v == true
                    if animated then
                        Tween(track, {BackgroundColor3 = state and TOGGLE_ON_COLOR or Color3.fromRGB(50,40,60)}, 0.2)
                        Tween(knob,  {Position = state and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)}, 0.2)
                        Tween(stroke,{Transparency = state and 0.3 or 0.7}, 0.2)
                    else
                        track.BackgroundColor3 = state and TOGGLE_ON_COLOR or Color3.fromRGB(50,40,60)
                        knob.Position = state and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)
                        stroke.Transparency = state and 0.3 or 0.7
                    end
                    if not silent and cb then cb(state) end
                    if not silent then FireControlCallbacks(regEntry, state) end
                end

                f.MouseButton1Click:Connect(function() ApplyState(not state, true) end)

                kbBtn.MouseButton1Click:Connect(function()
                    if regEntry.keybind then
                        regEntry.keybind = nil
                        kbBtn.Text = "[KEY]"
                        kbBtn.TextColor3 = C.TextSub
                    else
                        kbBtn.Text = "..."
                        kbBtn.TextColor3 = C.Primary
                        local conn; conn = UIS.InputBegan:Connect(function(input, gpe)
                            if gpe then return end
                            if input.UserInputType == Enum.UserInputType.Keyboard then
                                conn:Disconnect()
                                regEntry.keybind = input.KeyCode
                                local kName = tostring(input.KeyCode):gsub("Enum.KeyCode.", "")
                                kbBtn.Text = kName
                                kbBtn.TextColor3 = C.Accent
                            end
                        end)
                    end
                end)

                BindBooleanAPI(regEntry,
                    function() return state end,
                    function(v, silent) ApplyState(v, false, silent) end,
                    function() ApplyState(not state, true) end
                )
                regEntry.getKeybind = function()
                    if regEntry.keybind then
                        return tostring(regEntry.keybind):gsub("Enum.KeyCode.", "")
                    end
                    return nil
                end
                regEntry.setKeybind = function(kName)
                    if kName then
                        local ok, kc = pcall(function() return Enum.KeyCode[kName] end)
                        if ok and kc then
                            regEntry.keybind = kc
                            kbBtn.Text = kName
                            kbBtn.TextColor3 = C.Accent
                        end
                    else
                        regEntry.keybind = nil
                        kbBtn.Text = "[KEY]"
                        kbBtn.TextColor3 = C.TextSub
                    end
                end
                regEntry.Frame = f
                table.insert(Registry.toggles, RegisterControl("toggle", regEntry))
                return regEntry
            end


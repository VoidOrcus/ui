                    function(v, silent) ApplyState(v, false, silent) end,
                    function() ApplyState(not state, true) end
                )
                regEntry.getKeybind = function() return nil end
                regEntry.setKeybind = function() end
                regEntry.Frame = f

                table.insert(Registry.toggles, RegisterControl("checkbox", regEntry))
                return regEntry
            end


    local function SafeCleanupObject(obj)
        if obj == nil then return end

        local ok, err = pcall(function()
            local t = typeof(obj)

            if t == "RBXScriptConnection" then
                if obj.Connected then obj:Disconnect() end
                return
            end

            if type(obj) == "function" then
                obj()
                return
            end

            if type(obj) == "table" then
                if type(obj.Destroy) == "function" then obj:Destroy(); return end
                if type(obj.Clean) == "function" then obj:Clean(); return end
                if type(obj.Disconnect) == "function" then obj:Disconnect(); return end
                if type(obj.destroy) == "function" then obj:destroy(); return end
                if type(obj.clean) == "function" then obj:clean(); return end
                if type(obj.disconnect) == "function" then obj:disconnect(); return end
                return
            end

            if t == "Instance" then
                obj:Destroy()
            end
        end)

        if not ok then
            warn("[zZz UI] Kill cleanup error:", tostring(err):sub(1, 500))
        end
    end


    -- 👁️ VISIBILITY CONTROLLER FIX
    -- Evita o bug da janela ficar só como uma linha roxa/header.
    -- Causa: clicar no HideKey durante a animação de minimizar deixava Main.Size em Y=0.
    -- Agora toda abertura normaliza Size/Position/Visible e cancela tweens pendentes.
    -- ═══════════════════════════════════════════════════════
    local WindowHidden = false
    local WindowBusy = false
    local MainTween = nil
    local GlowTween = nil
    local BubbleTween = nil

    local function CancelWindowTweens()
        pcall(function() if MainTween then MainTween:Cancel(); MainTween = nil end end)
        pcall(function() if GlowTween then GlowTween:Cancel(); GlowTween = nil end end)
        pcall(function() if BubbleTween then BubbleTween:Cancel(); BubbleTween = nil end end)
    end

    local function NormalizeMainFrame()
        Main.Visible = true
        Glow.Visible = true
        Main.Size = UDim2.new(0, WIN_W, 0, WIN_H)
        Main.Position = UDim2.new(0.5, -WIN_W/2, 0.5, -WIN_H/2)
        Glow.Size = UDim2.new(0, WIN_W + 100, 0, WIN_H + 100)
        Glow.Position = UDim2.new(0.5, -(WIN_W + 100)/2, 0.5, -(WIN_H + 100)/2)
        Glow.ImageTransparency = 0.5
    end

    local function HideWindow(animated)
        if KillSwitch.Active then return end
        CancelWindowTweens()
        WindowHidden = true
        WindowBusy = animated == true

        if animated then
            GlowTween = Tween(Glow, {ImageTransparency = 1}, 0.28)
            MainTween = Tween(Main, {Size = UDim2.new(0, WIN_W, 0, 0)}, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            MainTween.Completed:Once(function()
                if not WindowHidden then return end
                Main.Visible = false
                Main.Size = UDim2.new(0, WIN_W, 0, WIN_H)
                Glow.Visible = false
                WindowBusy = false

                if SHOW_MOBILE_BUBBLE then
                    Bubble.Size = UDim2.new(0, 0, 0, 0)
                    Bubble.Visible = true
                    BubbleTween = Tween(Bubble, {Size = UDim2.new(0, 56, 0, 56)}, 0.35, Enum.EasingStyle.Back)
                else
                    Bubble.Visible = false
                    Bubble.Size = UDim2.new(0, 56, 0, 56)
                end
            end)
        else
            Main.Visible = false
            Main.Size = UDim2.new(0, WIN_W, 0, WIN_H)
            Glow.Visible = false
            Glow.ImageTransparency = 1
            Bubble.Visible = false
            Bubble.Size = UDim2.new(0, 56, 0, 56)
            WindowBusy = false
        end
    end

    local function ShowWindow(animated)
        if KillSwitch.Active then return end
        CancelWindowTweens()
        WindowHidden = false
        WindowBusy = animated == true
        Bubble.Visible = false

        Main.Visible = true
        Glow.Visible = true
        Main.Position = UDim2.new(0.5, -WIN_W/2, 0.5, -WIN_H/2)
        Glow.Position = UDim2.new(0.5, -(WIN_W + 100)/2, 0.5, -(WIN_H + 100)/2)
        Glow.Size = UDim2.new(0, WIN_W + 100, 0, WIN_H + 100)

        if animated then
            Main.Size = UDim2.new(0, WIN_W, 0, 0)
            Glow.ImageTransparency = 1
            MainTween = Tween(Main, {Size = UDim2.new(0, WIN_W, 0, WIN_H)}, 0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            GlowTween = Tween(Glow, {ImageTransparency = 0.5}, 0.35)
            MainTween.Completed:Once(function()
                if WindowHidden then return end
                NormalizeMainFrame()
                WindowBusy = false
            end)
        else
            NormalizeMainFrame()
            WindowBusy = false
        end
    end

    local function ToggleWindowByKey()
        if WindowBusy then
            -- Evita spam durante tween. Também corrige estado parcial se algo ficou em Y=0.
            if Main.Visible and Main.AbsoluteSize.Y <= 8 then
                ShowWindow(false)
            end
            return
        end

        if WindowHidden or not Main.Visible or Main.AbsoluteSize.Y <= 8 then
            ShowWindow(false)
        else
            HideWindow(false)
        end
    end

    -- Drag Main
    local dragging, dragStart, startPos
    Header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = i.Position; startPos = Main.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            local newX = startPos.X.Offset + d.X
            local newY = startPos.Y.Offset + d.Y
            Main.Position = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
            Glow.Position = UDim2.new(startPos.X.Scale, newX - 50, startPos.Y.Scale, newY - 50)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)

    -- Drag Bubble
    local bDragging, bDragStart, bStartPos, bMoved
    Bubble.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            bDragging=true; bDragStart=i.Position; bStartPos=Bubble.Position; bMoved=false
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if bDragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - bDragStart
            if (d.X^2+d.Y^2) > 25 then bMoved = true end
            Bubble.Position = UDim2.new(bStartPos.X.Scale, bStartPos.X.Offset+d.X, bStartPos.Y.Scale, bStartPos.Y.Offset+d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then bDragging=false end
    end)

